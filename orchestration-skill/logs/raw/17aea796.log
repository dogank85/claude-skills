EDULED       @map(\"scheduled\")\n  DELETED         @map(\"deleted\")\n  OVERDUE         @map(\"overdue\")\n  FAILED          @map(\"failed\")\n  MANUAL_OVERRIDE @map(\"manual_override\")\n  EXPIRED         @map(\"expired\")\n\n  @@map(\"photo_deletion_status\")\n}\n\nenum HealthStatus {\n  HEALTHY @map(\"healthy\")\n  WARNING @map(\"warning\")\n  OUTAGE  @map(\"outage\")\n\n  @@map(\"health_status\")\n}\n\nenum StoryStatus {\n  DRAFT     @map(\"draft\")\n  READY     @map(\"ready\")\n  PUBLISHED @map(\"published\")\n  ARCHIVED  @map(\"archived\")\n\n  @@map(\"story_status\")\n}\n\nenum DataExportStatus {\n  PENDING    @map(\"pending\")\n  PROCESSING @map(\"processing\")\n  COMPLETED  @map(\"completed\")\n  FAILED     @map(\"failed\")\n  EXPIRED    @map(\"expired\")\n\n  @@map(\"data_export_status\")\n}\n\nenum AccountDeletionStatus {\n  PENDING       @map(\"pending\")\n  CONFIRMED     @map(\"confirmed\")\n  PROCESSING    @map(\"processing\")\n  COMPLETED     @map(\"completed\")\n  CANCELLED     @map(\"cancelled\")\n\n  @@map(\"account_deletion_status\")\n}\n\nenum UploadStatus {\n  PENDING    @map(\"pending\")\n  UPLOADED   @map(\"uploaded\")\n  PROCESSING @map(\"processing\")\n  DELETED    @map(\"deleted\")\n\n  @@map(\"upload_status\")\n}\n\nenum ArtStyle {\n  PIXAR      @map(\"pixar\")\n  TWO_D      @map(\"2d\")\n  ANIME      @map(\"anime\")\n  WATERCOLOR @map(\"watercolor\")\n\n  @@map(\"art_style\")\n}\n\nenum PoseType {\n  PORTRAIT  @map(\"portrait\")\n  FULL_BODY @map(\"full_body\")\n\n  @@map(\"pose_type\")\n}\n\nenum PhotoDeletionJobStatus {\n  PENDING    @map(\"pending\")\n  PROCESSING @map(\"processing\")\n  COMPLETED  @map(\"completed\")\n  FAILED     @map(\"failed\")\n\n  @@map(\"photo_deletion_job_status\")\n}\n\nenum StoryGenerationJobStatus {\n  PENDING           @map(\"pending\")\n  GENERATING_TEXT   @map(\"generating_text\")\n  GENERATING_IMAGES @map(\"generating_images\")\n  COMPLETE          @map(\"complete\")\n  FAILED            @map(\"failed\")\n\n  @@map(\"story_generation_job_status\")\n}\n\nenum SafetyIncidentType {\n  TEXT_UNSAFE          @map(\"text_unsafe\")\n  IMAGE_UNSAFE         @map(\"image_unsafe\")\n  AGE_INAPPROPRIATE    @map(\"age_inappropriate\")\n  PARENT_REPORTED      @map(\"parent_reported\")\n\n  @@map(\"safety_incident_type\")\n}\n\nenum SafetyIncidentStatus {\n  PENDING   @map(\"pending\")\n  REVIEWED  @map(\"reviewed\")\n  APPROVED  @map(\"approved\")\n  REJECTED  @map(\"rejected\")\n\n  @@map(\"safety_incident_status\")\n}\n\nenum SafetyIncidentResolution {\n  AUTO_BLOCKED    @map(\"auto_blocked\")\n  REGENERATED     @map(\"regenerated\")\n  MANUAL_REVIEW   @map(\"manual_review\")\n  CLEARED         @map(\"cleared\")\n\n  @@map(\"safety_incident_resolution\")\n}\n","exit_code":0,"status":"completed"}}
