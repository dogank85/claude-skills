/>\n          </View>\n        )}\n\n        {/* Create Button */}\n        <View style={styles.section}>\n          <Pressable\n            onPress={handleCreateStory}\n            disabled={!selectedAdventure || generateStory.isLoading}\n            style={[\n              styles.createButton,\n              (!selectedAdventure || generateStory.isLoading) && styles.createButtonDisabled,\n            ]}\n            testID=\"create-story-button\"\n          >\n            <Text style={styles.createButtonText}>\n              {generateStory.isLoading ? 'Creating...' : 'Create My Story'}\n            </Text>\n          </Pressable>\n        </View>\n      </ScrollView>\n\n      {/* Progress Modal */}\n      <ProgressModal visible={showProgress} status={status} progress={progress} />\n\n      <InsufficientCreditsAlert\n        visible={showInsufficientCredits}\n        onCancel={() => setShowInsufficientCredits(false)}\n        onBuyCredits={() => {\n          setShowInsufficientCredits(false);\n          router.push('/(tabs)/profile');\n        }}\n        neededCredits={STORY_COST}\n        currentBalance={credits || 0}\n      />\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#F9FAFB',\n  },\n  scrollView: {\n    flex: 1,\n  },\n  scrollContent: {\n    padding: 20,\n  },\n  header: {\n    marginBottom: 32,\n  },\n  title: {\n    fontSize: 32,\n    fontWeight: '700',\n    color: '#111827',\n    marginBottom: 8,\n  },\n  subtitle: {\n    fontSize: 16,\n    color: '#6B7280',\n  },\n  section: {\n    marginBottom: 24,\n  },\n  sectionTitle: {\n    fontSize: 18,\n    fontWeight: '600',\n    color: '#111827',\n    marginBottom: 16,\n  },\n  toggleContainer: {\n    backgroundColor: '#FFFFFF',\n    borderRadius: 12,\n    padding: 16,\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    shadowColor: '#000',\n    shadowOffset: { width: 0, height: 1 },\n    sha