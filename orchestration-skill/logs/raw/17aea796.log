{"type":"item.completed","item":{"id":"item_167","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,120p' apps/web/app/api/cron/account-deletion/route.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Vercel Cron Route: Account Deletion Worker\n *\n * This API route processes account deletion requests by:\n * 1. Sending reminder emails 7 days before deletion\n * 2. Permanently deleting accounts after 30-day grace period\n * 3. Cascading delete all related data (children, stories, audit logs)\n * 4. Creating final audit entries before deletion\n *\n * Vercel Cron Configuration (vercel.json):\n * {\n *   \"crons\": [{\n *     \"path\": \"/api/cron/account-deletion\",\n *     \"schedule\": \"0 2 * * *\"  // Daily at 2am\n *   }]\n * }\n *\n * Security:\n * - Requires Authorization header with CRON_SECRET\n * - Only processes CONFIRMED deletion requests\n * - Respects 30-day grace period\n */\n\nimport { NextRequest, NextResponse } from 'next/server';\nimport { PrismaClient } from '@herokid/database';\nimport { createClient } from '@supabase/supabase-js';\nimport * as Sentry from '@sentry/nextjs';\nimport { validateCronRequest } from '../auth';\n\nconst REMINDER_DAYS_BEFORE_DELETION = 7;\nconst EMAIL_MAX_ATTEMPTS = 3;\nconst EMAIL_RETRY_DELAY_MS = 400;\n\ntype EmailPayload = {\n  to: string;\n  subject: string;\n  text: string;\n  html?: string;\n  metadata?: Record<string, unknown>;\n};\n\ntype EmailResult = {\n  success: boolean;\n  error?: string;\n};\n\ntype TransactionalEmailConfig = {\n  apiKey: string;\n  from: string;\n};\n\nconst REDACTED = '[redacted]';\n\nfunction getEmailConfig(): TransactionalEmailConfig {\n  const apiKey = process.env.RESEND_API_KEY;\n  const from = process.env.TRANSACTIONAL_EMAIL_FROM ?? process.env.HEALTH_ALERT_EMAIL_FROM;\n\n  if (!apiKey || !from) {\n    throw new Error('Missing transactional email configuration (RESEND_API_KEY, TRANSACTIONAL_EMAIL_FROM)');\n  }\n\n  return { apiKey, from };\n}\n\nasync function deliverEmail(config: TransactionalEmailConfig, payload: EmailPayload): Promise<void> {\n  const response = await fetch('https://api.resend.com/emails', {\n    method: 'POST',\n    headers: {\n      'Content-Type': 'application/json',\n      Authorization: `Bearer ${config.apiKey}`,\n    },\n    body: JSON.stringify({\n      from: config.from,\n      to: [payload.to],\n      subject: payload.subject,\n      text: payload.text,\n      html: payload.html,\n    }),\n  });\n\n  if (!response.ok) {\n    const errText = await response.text();\n    throw new Error(`Email send failed (${response.status}): ${errText}`);\n  }\n}\n\nasync function sendEmailWithRetry(payload: EmailPayload): Promise<EmailResult> {\n  let lastError: unknown;\n\n  try {\n    const config = getEmailConfig();\n\n    for (let attempt = 1; attempt <= EMAIL_MAX_ATTEMPTS; attempt++) {\n      try {\n        await deliverEmail(config, payload);\n        return { success: true };\n      } catch (error) {\n        lastError = error;\n\n        if (attempt < EMAIL_MAX_ATTEMPTS) {\n          await new Promise((resolve) => setTimeout(resolve, EMAIL_RETRY_DELAY_MS * attempt));\n        }\n      }\n    }\n  } catch (configError) {\n    lastError = configError;\n  }\n\n  Sentry.captureException(lastError ?? new Error('Unknown email failure'), {\n    level: 'error',\n    extra: {\n      to: REDACTED,\n      attempts: EMAIL_MAX_ATTEMPTS,\n      metadata: payload.metadata ?? {},\n    },\n  });\n\n  return {\n    success: false,\n    error: lastError instanceof Error ? lastError.message : 'Unknown email failure',\n","exit_code":0,"status":"completed"}}
