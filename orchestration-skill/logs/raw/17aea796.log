{"type":"item.completed","item":{"id":"item_110","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' \\\"apps/mobile/app/(app)/children.tsx\\\"\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { router } from 'expo-router';\nimport { useEffect, useState, useMemo, useCallback, memo } from 'react';\nimport {\n  ActivityIndicator,\n  Alert,\n  Image,\n  Pressable,\n  RefreshControl,\n  ScrollView,\n  StyleSheet,\n  Text,\n  View,\n} from 'react-native';\nimport { trpcReact } from '@herokid/api/client';\nimport { useAuth } from '../../src/hooks/useAuth';\n\nexport default function ChildrenScreen() {\n  const auth = useAuth();\n  const [selectedChildId, setSelectedChildId] = useState<string | null>(null);\n\n  const childrenQuery = trpcReact.childProfile.list.useQuery(undefined, {\n    enabled: auth.isAuthenticated,\n    staleTime: 1000 * 60 * 2, // 2 minutes - child list doesn't change often\n  });\n\n  const meMutation = trpcReact.auth.me.useQuery(undefined, {\n    enabled: auth.isAuthenticated,\n    staleTime: 1000 * 60 * 5, // 5 minutes - user data doesn't change often\n  });\n\n  // Redirect to login if not authenticated\n  useEffect(() => {\n    if (!auth.isLoading && !auth.isAuthenticated) {\n      router.replace('/(auth)/welcome');\n    }\n  }, [auth.isAuthenticated, auth.isLoading]);\n\n  // Check consent and redirect if needed\n  useEffect(() => {\n    if (meMutation.data && !meMutation.data.hasConsent) {\n      router.replace('/consent');\n    }\n  }, [meMutation.data]);\n\n  // Memoize callbacks to prevent child re-renders\n  const handleSelectChild = useCallback((childId: string) => {\n    setSelectedChildId(childId);\n    // TODO: Navigate to child dashboard\n    // router.push(`/(app)/stories/${childId}`);\n  }, []);\n\n  const handleCreateChild = useCallback(() => {\n    // TODO: Navigate to child profile creation\n    // router.push('/(app)/child/create');\n    Alert.alert('Coming Soon', 'Child profile creation will be available soon!');\n  }, []);\n\n  const handleLogout = useCallback(async () => {\n    Alert.alert('Logout', 'Are you sure you want to log out?', [\n      { text: 'Cancel', style: 'cancel' },\n      {\n        text: 'Logout',\n        style: 'destructive',\n        onPress: async () => {\n          try {\n            await auth.clearTokens();\n            router.replace('/(auth)/welcome');\n          } catch (error) {\n            console.error('Logout error:', error);\n            Alert.alert('Error', 'Failed to logout. Please try again.');\n          }\n        },\n      },\n    ]);\n  }, [auth]);\n\n  if (auth.isLoading || childrenQuery.isLoading) {\n    return (\n      <View style={styles.centerContainer}>\n        <ActivityIndicator size=\"large\" color=\"#38bdf8\" />\n        <Text style={styles.loadingText}>Loading...</Text>\n      </View>\n    );\n  }\n\n  if (childrenQuery.isError) {\n    return (\n      <View style={styles.centerContainer}>\n        <Text style={styles.errorTitle}>Failed to Load Children</Text>\n        <Text style={styles.errorText}>\n          {childrenQuery.error?.message || 'An error occurred while loading your children.'}\n        </Text>\n        <Pressable style={styles.retryButton} onPress={() => childrenQuery.refetch()}>\n          <Text style={styles.retryButtonText}>Try Again</Text>\n        </Pressable>\n      </View>\n    );\n  }\n\n  // Memoize children array to prevent unnecessary re-renders\n  const children = useMemo(\n    () => childrenQuery.data?.childProfiles || [],\n    [childrenQuery.data?.childProfiles]\n  );\n\n  return (\n    <View style={styles.container}>\n      {/* Header */}\n      <View style={styles.header}>\n        <View>\n          <Text style={styles.greeting}>Welcome back!</Text>\n          <Text style={styles.email}>{meMutation.data?.email}</Text>\n        </View>\n        <Pressable style={styles.logoutButton} onPress={handleLogout}>\n          <Text style={styles.logoutButtonText}>Logout</Text>\n        </Pressable>\n      </View>\n\n      <ScrollView\n        contentContainerStyle={styles.scrollContent}\n        refreshControl={\n          <RefreshControl\n            refreshing={childrenQuery.isRefetching}\n            onRefresh={() => childrenQuery.refetch()}\n            tintColor=\"#38bdf8\"\n          />\n        }\n      >\n        <View style={styles.section}>\n          <Text style={styles.sectionTitle}>Select a Child</Text>\n          <Text style={styles.sectionSubtitle}>Choose who you're creating stories for today</Text>\n        </View>\n\n        {/* Empty State */}\n        {children.length === 0 && (\n          <View style={styles.emptyState}>\n            <Text style={styles.emptyIcon}>👶</Text>\n            <Text style={styles.emptyTitle}>No Children Yet</Text>\n            <Text style={styles.emptyDescription}>\n              Create your first child profile to start crafting personalized adventures\n            </Text>\n            <Pressable style={styles.createButton} onPress={handleCreateChild}>\n              <Text style={styles.createButtonText}>+ Create Child Profile</Text>\n            </Pressable>\n          </View>\n        )}\n\n        {/* Children Grid */}\n        {children.length > 0 && (\n          <View style={styles.grid}>\n            {children.map((child) => (\n              <ChildCard\n                key={child.id}\n                id={child.id}\n                name={child.displayName}\n                avatarUrl={child.avatarUrl}\n                isSelected={selectedChildId === child.id}\n                onPress={handleSelectChild}\n              />\n            ))}\n\n            {/* Add Child Card */}\n            <Pressable style={styles.addChildCard} onPress={handleCreateChild}>\n              <View style={styles.addChildIcon}>\n                <Text style={styles.addChildPlus}>+</Text>\n              </View>\n              <Text style={styles.addChildText}>Add Child</Text>\n            </Pressable>\n          </View>\n        )}\n\n        {/* Activity Summary */}\n        {children.length > 0 && (\n          <View style={styles.activity}>\n            <Text style={styles.activityTitle}>Recent Activity</Text>\n            <View style={styles.activityCard}>\n              <Text style={styles.activityText}>No recent stories yet</Text>\n              <Text style={styles.activitySubtext}>Select a child to start creating adventures!</Text>\n            </View>\n          </View>\n        )}\n      </ScrollView>\n    </View>\n  );\n}\n\ninterface ChildCardProps {\n  id: string;\n  name: string;\n  avatarUrl?: string | null;\n  isSelected: boolean;\n  onPress: (id: string) => void;\n}\n\n// Memoize ChildCard to prevent unnecessary re-renders\nconst ChildCard = memo(function ChildCard({ id, name, avatarUrl, isSelected, onPress }: ChildCardProps) {\n  const handlePress = useCallback(() => {\n    onPress(id);\n  }, [id, onPress]);\n\n","exit_code":0,"status":"completed"}}
