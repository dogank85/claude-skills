{"type":"item.completed","item":{"id":"item_135","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' \\\"apps/web/app/(auth)/login/page.tsx\\\"\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n'use client';\n\nimport { useState } from 'react';\nimport { useForm } from 'react-hook-form';\nimport Link from 'next/link';\nimport { useRouter } from 'next/navigation';\nimport { trpcReact as trpc } from '@herokid/api/client';\nimport { supabase } from '@/lib/supabase';\n\ntype FormValues = {\n  email: string;\n  password: string;\n};\n\nexport default function LoginPage() {\n  const router = useRouter();\n  const [status, setStatus] = useState<'idle' | 'loading' | 'error'>('idle');\n  const [errorMessage, setErrorMessage] = useState<string>('');\n\n  const loginMutation = trpc.auth.login.useMutation({\n    onSuccess: async (data) => {\n      // Set session in Supabase client\n      const { error } = await supabase.auth.setSession({\n        access_token: data.session.accessToken,\n        refresh_token: data.session.refreshToken,\n      });\n\n      if (error) {\n        setStatus('error');\n        setErrorMessage('Failed to establish session. Please try again.');\n        return;\n      }\n\n      // Set cookie for middleware\n      document.cookie = `sb-access-token=${data.session.accessToken}; path=/; max-age=${data.session.expiresIn}; SameSite=Lax; Secure`;\n\n      // Redirect to dashboard\n      router.push('/dashboard');\n    },\n    onError: (error) => {\n      setStatus('error');\n      setErrorMessage(error.message);\n    },\n  });\n\n  const {\n    register,\n    handleSubmit,\n    formState: { errors },\n  } = useForm<FormValues>({\n    defaultValues: {\n      email: '',\n      password: '',\n    },\n  });\n\n  const onSubmit = handleSubmit(async (values) => {\n    setStatus('loading');\n    setErrorMessage('');\n\n    loginMutation.mutate({\n      email: values.email,\n      password: values.password,\n    });\n  });\n\n  return (\n    <div className=\"auth-wrapper\">\n      <div className=\"auth-card\">\n        <p className=\"eyebrow\">Welcome back</p>\n        <h1>Sign in to your account</h1>\n        <p className=\"auth-helper\">\n          Enter your email and password to access your dashboard and stories.\n        </p>\n\n        {status === 'error' && errorMessage && (\n          <div className=\"auth-alert\" role=\"alert\">\n            {errorMessage}\n          </div>\n        )}\n\n        <form onSubmit={onSubmit} aria-busy={status === 'loading' || loginMutation.isPending}>\n          <div className=\"auth-field\">\n            <label htmlFor=\"email\">Email address</label>\n            <input\n              id=\"email\"\n              type=\"email\"\n              className=\"auth-input\"\n              placeholder=\"parent@example.com\"\n              {...register('email', { required: 'Email is required' })}\n            />\n            {errors.email && <span className=\"auth-error\">{errors.email.message}</span>}\n          </div>\n\n          <div className=\"auth-field\">\n            <div className=\"flex items-center justify-between\">\n              <label htmlFor=\"password\">Password</label>\n              <Link href=\"/forgot-password\" style={{ fontSize: '0.85rem' }} className=\"link\">\n                Forgot password?\n              </Link>\n            </div>\n            <input\n              id=\"password\"\n              type=\"password\"\n              className=\"auth-input\"\n              placeholder=\"Enter your password\"\n              {...register('password', { required: 'Password is required' })}\n            />\n            {errors.password && <span className=\"auth-error\">{errors.password.message}</span>}\n          </div>\n\n          <div className=\"auth-actions\">\n            <button\n              className=\"auth-button\"\n              type=\"submit\"\n              disabled={status === 'loading' || loginMutation.isPending}\n            >\n              {status === 'loading' || loginMutation.isPending ? 'Signing in…' : 'Sign in'}\n            </button>\n            <Link className=\"link\" href=\"/register\">\n              Don't have an account? Create one →\n            </Link>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n}\n","exit_code":0,"status":"completed"}}
