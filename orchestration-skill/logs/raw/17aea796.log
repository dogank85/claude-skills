{"type":"item.completed","item":{"id":"item_122","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' \\\"apps/mobile/app/(onboarding)/avatar-creation.tsx\\\"\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { router, useLocalSearchParams } from 'expo-router';\nimport { useState } from 'react';\nimport {\n  ActivityIndicator,\n  Alert,\n  ScrollView,\n  StyleSheet,\n  Text,\n  TouchableOpacity,\n  View,\n} from 'react-native';\nimport * as ImagePicker from 'expo-image-picker';\nimport { trpcReact } from '@herokid/api/client';\nimport { useCredits, useCheckBalance } from '../../src/hooks/useCredits';\nimport { InsufficientCreditsAlert } from '../../src/components/InsufficientCreditsAlert';\nimport { Ionicons } from '@expo/vector-icons';\n\nconst AVATAR_COST = 25;\n\nexport default function AvatarCreationScreen() {\n  const params = useLocalSearchParams<{ childProfileId: string }>();\n  const childProfileId = params.childProfileId;\n\n  const [portraitUri, setPortraitUri] = useState<string | null>(null);\n  const [fullBodyUri, setFullBodyUri] = useState<string | null>(null);\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [showInsufficientCredits, setShowInsufficientCredits] = useState(false);\n\n  // Credit hooks\n  const { balance: credits, refetch: refetchCredits } = useCredits();\n  const { checkBalance } = useCheckBalance();\n\n  // Fetch child profile\n  const { data: childProfile, isLoading: profileLoading } = trpcReact.childProfile.get.useQuery(\n    { childProfileId: childProfileId || '' },\n    { enabled: !!childProfileId }\n  );\n\n  // Check avatar status (free vs paid)\n  const { data: avatarStatus, refetch: refetchStatus } = trpcReact.avatar.getAvatarStatus.useQuery(\n    { childProfileId: childProfileId || '' },\n    { enabled: !!childProfileId }\n  );\n\n  const isFree = avatarStatus?.isFree ?? false;\n  const AVATAR_COST = isFree ? 0 : 4;\n\n  // Request upload URL mutation\n  const requestUploadMutation = trpcReact.avatar.requestUpload.useMutation();\n\n  // Deduct credit mutation\n  const deductCreditMutation = trpcReact.credits.deductCredit.useMutation();\n\n  // Generate avatars mutation\n  const generateAvatarsMutation = trpcReact.avatar.generateAvatars.useMutation({\n    onSuccess: async () => {\n      // Deduct credits if not free\n      if (!isFree) {\n        try {\n          await deductCreditMutation.mutateAsync({\n            reason: 'AVATAR',\n            credits: 4, // Fixed cost for non-free\n            childId: childProfileId,\n          });\n          await refetchCredits();\n          await refetchStatus();\n        } catch (error) {\n          console.error('Failed to deduct credits:', error);\n        }\n      }\n\n      Alert.alert('Success!', 'Your avatars have been created!', [\n        {\n          text: 'OK',\n          onPress: () => router.push(`/(onboarding)/avatar-selection?childProfileId=${childProfileId}`),\n        },\n      ]);\n      setIsGenerating(false);\n    },\n    onError: (error: any) => {\n      if (error.message === 'REGENERATION_LIMIT_EXCEEDED') {\n        Alert.alert(\n          'Regeneration Limit Reached',\n          'You can regenerate up to 5 times per day. Try again tomorrow!',\n          [{ text: 'OK' }]\n        );\n      } else {\n        Alert.alert('Error', error.message || 'Failed to generate avatars. Please try again.');\n      }\n      setIsGenerating(false);\n    },\n  });\n\n  const pickImage = async (type: 'portrait' | 'full_body') => {\n    const permissionResult = await ImagePicker.requestMediaLibraryPermissionsAsync();\n\n    if (!permissionResult.granted) {\n      Alert.alert('Permission Required', 'Please grant camera roll permissions to upload photos.');\n      return;\n    }\n\n    const result = await ImagePicker.launchImageLibraryAsync({\n      mediaTypes: ImagePicker.MediaTypeOptions.Images,\n      allowsEditing: true,\n      aspect: type === 'portrait' ? [1, 1] : [3, 4],\n      quality: 0.8,\n    });\n\n    if (!result.canceled && result.assets[0]) {\n      if (type === 'portrait') {\n        setPortraitUri(result.assets[0].uri);\n      } else {\n        setFullBodyUri(result.assets[0].uri);\n      }\n    }\n  };\n\n  const handleGenerate = async () => {\n    if (!childProfileId || !portraitUri || !fullBodyUri) {\n      Alert.alert('Missing Photos', 'Please upload both portrait and full-body photos');\n      return;\n    }\n\n    // Check credits\n    if (!isFree) {\n      const balanceCheck = checkBalance(4);\n      if (!balanceCheck.hasSufficientBalance) {\n        setShowInsufficientCredits(true);\n        return;\n      }\n    }\n\n    setIsGenerating(true);\n\n    try {\n      // 1. Request upload URLs\n      const [portraitUpload, fullBodyUpload] = await Promise.all([\n        requestUploadMutation.mutateAsync({\n          childProfileId,\n          uploadType: 'portrait',\n          fileName: 'portrait.jpg',\n          fileType: 'image/jpeg',\n          fileSize: 5000000, // Estimate\n        }),\n        requestUploadMutation.mutateAsync({\n          childProfileId,\n          uploadType: 'full_body',\n          fileName: 'fullbody.jpg',\n          fileType: 'image/jpeg',\n          fileSize: 5000000, // Estimate\n        }),\n      ]);\n\n      // 2. Upload files to signed URLs\n      const uploadFile = async (uri: string, signedUrl: string) => {\n        const response = await fetch(uri);\n        const blob = await response.blob();\n        await fetch(signedUrl, {\n          method: 'PUT',\n          body: blob,\n          headers: { 'Content-Type': 'image/jpeg' },\n        });\n      };\n\n      await Promise.all([\n        uploadFile(portraitUri, portraitUpload.signedUrl),\n        uploadFile(fullBodyUri, fullBodyUpload.signedUrl),\n      ]);\n\n      // 3. Generate avatars\n      await generateAvatarsMutation.mutateAsync({\n        childProfileId,\n        portraitUploadId: portraitUpload.uploadId,\n        fullBodyUploadId: fullBodyUpload.uploadId,\n      });\n    } catch (error: any) {\n      console.error('Avatar generation failed:', error);\n      Alert.alert('Error', 'Failed to generate avatars. Please try again.');\n      setIsGenerating(false);\n    }\n  };\n\n  if (profileLoading) {\n    return (\n      <View style={styles.loadingContainer}>\n        <ActivityIndicator size=\"large\" color=\"#7C3AED\" />\n        <Text style={styles.loadingText}>Loading...</Text>\n      </View>\n    );\n  }\n\n  if (!childProfileId || !childProfile) {\n    return (\n      <View style={styles.container}>\n        <Text style={styles.errorText}>Error: No child profile selected</Text>\n      </View>\n    );\n  }\n\n  return (\n","exit_code":0,"status":"completed"}}
