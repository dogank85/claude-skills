es REFUNDS if generation fails\n      generateStoryAsync({\n        generationId: reservation.jobId,\n        parentId,\n        childProfile: {\n          id: childProfile.id,\n          name: childProfile.name,\n          birthMonth: childProfile.birthMonth,\n          birthYear: childProfile.birthYear,\n          avatars: childProfile.avatars,\n          petCompanions: childProfile.petCompanions,\n        },\n        adventureTemplate: input.adventureTemplate,\n        includePet: input.includePet,\n        artStyle: input.artStyle,\n        cost: reservation.appliedCost, // Pass applied cost for potential refund\n        creditReservationId: reservation.reservationTransactionId,\n        firstFreeCreditId: reservation.firstFreeCreditId,\n      }).catch((error) => {\n        console.error('Background story generation failed:', error);\n      });\n\n      return {\n        success: true,\n        jobId: reservation.jobId,\n        creditsRemaining: reservation.creditsRemaining,\n        firstFree: reservation.appliedCost === 0 && STORY_COST > 0,\n      };\n    }),\n\n  /**\n   * Get Generation Status - Poll for generation progress\n   */\n  getGenerationStatus: protectedProcedure\n    .input(getGenerationStatusSchema)\n    .query(async ({ input, ctx }) => {\n","exit_code":0,"status":"completed"}}
