{"type":"item.completed","item":{"id":"item_72","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/env.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Environment Variable Validation Framework\n *\n * SECURITY: All environment variables are validated using Zod schemas\n * to ensure type safety and prevent runtime errors from misconfiguration.\n *\n * This module validates required environment variables at startup and\n * fails immediately with clear error messages if configuration is invalid.\n */\n\nimport { z } from 'zod';\n\n/**\n * Environment variable schema with comprehensive validation\n *\n * Required in production:\n * - DATABASE_URL: PostgreSQL connection string\n * - SUPABASE_URL: Supabase project URL\n * - SUPABASE_SERVICE_ROLE_KEY: Supabase service role key (min 32 chars)\n * - STRIPE_SECRET_KEY: Stripe API secret key (must start with sk_)\n * - STRIPE_WEBHOOK_SECRET: Stripe webhook signing secret (must start with whsec_)\n */\nconst envSchema = z.object({\n  // Environment metadata\n  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),\n  VERCEL_ENV: z.enum(['development', 'preview', 'production']).optional(),\n  COMMIT_SHA: z.string().optional(),\n  API_VERSION: z.string().default('dev'),\n\n  // Database\n  DATABASE_URL: z.string().url().startsWith('postgresql://'),\n\n  // Supabase (required in production)\n  SUPABASE_URL: z.string().url().optional(),\n  NEXT_PUBLIC_SUPABASE_URL: z.string().url().optional(),\n  SUPABASE_SERVICE_ROLE_KEY: z.string().min(32).optional(),\n  SUPABASE_WEBHOOK_SECRET: z.string().optional(),\n  SUPABASE_STORAGE_WEBHOOK_SECRET: z.string().optional(),\n\n  // Stripe (required in production)\n  STRIPE_SECRET_KEY: z.string().regex(/^sk_(test|live)_/).optional(),\n  STRIPE_WEBHOOK_SECRET: z.string().startsWith('whsec_').optional(),\n\n  // COPPA Compliance\n  COPPA_CONSENT_WEBHOOK_URL: z.string().url().optional(),\n  CONSENT_EVENTS_WEBHOOK_URL: z.string().url().optional(),\n\n  // Photo deletion settings\n  PHOTO_DELETION_TTL_HOURS: z.coerce.number().int().min(1).max(168).default(36),\n\n  // Admin access control\n  ADMIN_EMAILS: z.string().optional(),\n\n  // Git metadata\n  VERCEL_GIT_COMMIT_SHA: z.string().optional(),\n  GIT_SHA: z.string().optional(),\n})\n  // Refine schema to enforce production requirements\n  .refine(\n    (data) => {\n      const isProduction = data.NODE_ENV === 'production' || data.VERCEL_ENV === 'production';\n      if (!isProduction) return true;\n\n      // In production, require Supabase configuration\n      const hasSupabase = (data.SUPABASE_URL || data.NEXT_PUBLIC_SUPABASE_URL) && data.SUPABASE_SERVICE_ROLE_KEY;\n      if (!hasSupabase) {\n        throw new Error('PRODUCTION: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are required');\n      }\n\n      // In production, require Stripe configuration\n      if (!data.STRIPE_SECRET_KEY) {\n        throw new Error('PRODUCTION: STRIPE_SECRET_KEY is required');\n      }\n      if (!data.STRIPE_WEBHOOK_SECRET) {\n        throw new Error('PRODUCTION: STRIPE_WEBHOOK_SECRET is required');\n      }\n\n      return true;\n    },\n    {\n      message: 'Production environment requires Supabase and Stripe configuration',\n    }\n  );\n\n// Parse and validate environment variables at module load time\n// This will throw immediately if validation fails, preventing the app from starting\nconst rawEnv = envSchema.parse(process.env);\n\n// Export validated environment variables with computed values\nexport type ApiRuntimeEnv = z.infer<typeof envSchema> & {\n  commitSha: string;\n  apiVersion: string;\n  runtimeEnv: string;\n  supabaseUrl: string | undefined;\n  supabaseServiceRoleKey: string | undefined;\n  supabaseWebhookSecret: string | undefined;\n  supabaseConfigured: boolean;\n  photoDeletionTtlHours: number;\n  consentEventsWebhookUrl: string | undefined;\n  stripeWebhookSecret: string | undefined;\n  adminEmails: string[];\n};\n\nexport const apiEnv: ApiRuntimeEnv = {\n  ...rawEnv,\n  commitSha: rawEnv.VERCEL_GIT_COMMIT_SHA || rawEnv.GIT_SHA || rawEnv.COMMIT_SHA || 'local',\n  apiVersion: rawEnv.API_VERSION,\n  runtimeEnv: rawEnv.VERCEL_ENV || rawEnv.NODE_ENV,\n  supabaseUrl: rawEnv.SUPABASE_URL || rawEnv.NEXT_PUBLIC_SUPABASE_URL,\n  supabaseServiceRoleKey: rawEnv.SUPABASE_SERVICE_ROLE_KEY,\n  supabaseWebhookSecret: rawEnv.SUPABASE_WEBHOOK_SECRET || rawEnv.SUPABASE_STORAGE_WEBHOOK_SECRET,\n  supabaseConfigured: Boolean(\n    (rawEnv.SUPABASE_URL || rawEnv.NEXT_PUBLIC_SUPABASE_URL) && rawEnv.SUPABASE_SERVICE_ROLE_KEY\n  ),\n  photoDeletionTtlHours: rawEnv.PHOTO_DELETION_TTL_HOURS,\n  consentEventsWebhookUrl: rawEnv.COPPA_CONSENT_WEBHOOK_URL || rawEnv.CONSENT_EVENTS_WEBHOOK_URL,\n  stripeWebhookSecret: rawEnv.STRIPE_WEBHOOK_SECRET,\n  adminEmails: rawEnv.ADMIN_EMAILS\n    ? rawEnv.ADMIN_EMAILS.split(',')\n      .map((email) => email.trim().toLowerCase())\n      .filter(Boolean)\n    : [],\n};\n","exit_code":0,"status":"completed"}}
