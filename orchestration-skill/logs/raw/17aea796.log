{"type":"item.completed","item":{"id":"item_158","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/ai/src/storage/sceneImageStorage.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Supabase Storage Integration for Story Scene Images\n * Epic 4 Story 4.4: Story Scene Image Generation\n *\n * Handles uploading scene images to Supabase Storage and generating public URLs.\n * Images are stored permanently in the 'story-images' bucket.\n */\n\nimport { createClient, SupabaseClient } from '@supabase/supabase-js';\nimport type { SceneImageResponse } from '../imagen/storyScenes';\n\n/**\n * Configuration for Supabase Storage\n */\nexport interface StorageConfig {\n  supabaseUrl: string;\n  supabaseServiceKey: string; // Service key for server-side operations\n}\n\n/**\n * Result of uploading a scene image to storage\n */\nexport interface UploadSceneImageResult {\n  sceneNumber: number;\n  storagePath: string;\n  publicUrl: string;\n  generationCost: number;\n  safetyScore: number;\n}\n\n/**\n * Scene Image Storage Client\n *\n * Handles uploading generated scene images to Supabase Storage\n * and creating database records.\n */\nexport class SceneImageStorageClient {\n  private supabase: SupabaseClient;\n  private bucketName = 'story-images';\n\n  constructor(config: StorageConfig) {\n    this.supabase = createClient(config.supabaseUrl, config.supabaseServiceKey, {\n      auth: {\n        persistSession: false, // Server-side client doesn't need sessions\n      },\n    });\n  }\n\n  /**\n   * Upload a single scene image to Supabase Storage\n   *\n   * @param storyId - ID of the parent story\n   * @param sceneImage - Generated scene image data\n   * @returns Upload result with storage path and public URL\n   *\n   * @example\n   * ```typescript\n   * const result = await client.uploadSceneImage('story-123', sceneImage);\n   * console.log(`Image uploaded to: ${result.publicUrl}`);\n   * ```\n   */\n  async uploadSceneImage(\n    storyId: string,\n    sceneImage: SceneImageResponse\n  ): Promise<UploadSceneImageResult> {\n    // Build storage path: story-images/{storyId}/scene_{sceneNumber}.png\n    const fileName = `scene_${sceneImage.sceneNumber}.png`;\n    const storagePath = `${storyId}/${fileName}`;\n\n    try {\n      // Upload image buffer to Supabase Storage\n      const { error: uploadError } = await this.supabase.storage\n        .from(this.bucketName)\n        .upload(storagePath, sceneImage.imageBuffer, {\n          contentType: 'image/png',\n          cacheControl: '31536000', // Cache for 1 year (images are immutable)\n          upsert: false, // Don't overwrite existing images\n        });\n\n      if (uploadError) {\n        throw new Error(`Failed to upload scene ${sceneImage.sceneNumber}: ${uploadError.message}`);\n      }\n\n      // Generate public URL\n      const { data: urlData } = this.supabase.storage\n        .from(this.bucketName)\n        .getPublicUrl(storagePath);\n\n      if (!urlData.publicUrl) {\n        throw new Error(`Failed to generate public URL for scene ${sceneImage.sceneNumber}`);\n      }\n\n      return {\n        sceneNumber: sceneImage.sceneNumber,\n        storagePath,\n        publicUrl: urlData.publicUrl,\n        generationCost: sceneImage.cost,\n        safetyScore: sceneImage.safetyScore,\n      };\n    } catch (error) {\n      const errorMessage = error instanceof Error ? error.message : String(error);\n      throw new Error(`Storage upload failed for scene ${sceneImage.sceneNumber}: ${errorMessage}`);\n    }\n  }\n\n  /**\n   * Upload multiple scene images in parallel\n   *\n   * @param storyId - ID of the parent story\n   * @param sceneImages - Array of generated scene images (typically 6)\n   * @returns Array of upload results\n   *\n   * @example\n   * ```typescript\n   * const results = await client.batchUploadSceneImages('story-123', sceneImages);\n   * console.log(`Uploaded ${results.length} scene images`);\n   * ```\n   */\n  async batchUploadSceneImages(\n    storyId: string,\n    sceneImages: SceneImageResponse[]\n  ): Promise<UploadSceneImageResult[]> {\n    // Upload all images in parallel for speed\n    return Promise.all(\n      sceneImages.map(sceneImage => this.uploadSceneImage(storyId, sceneImage))\n    );\n  }\n\n  /**\n   * Delete scene images for a story\n   *\n   * Used when a story is deleted or regenerated.\n   *\n   * @param storyId - ID of the story\n   * @param sceneNumbers - Optional specific scenes to delete (defaults to all)\n   */\n  async deleteSceneImages(storyId: string, sceneNumbers?: number[]): Promise<void> {\n    try {\n      // If specific scenes provided, delete only those\n      if (sceneNumbers && sceneNumbers.length > 0) {\n        const paths = sceneNumbers.map(num => `${storyId}/scene_${num}.png`);\n        const { error } = await this.supabase.storage\n          .from(this.bucketName)\n          .remove(paths);\n\n        if (error) {\n          throw new Error(`Failed to delete specific scenes: ${error.message}`);\n        }\n      } else {\n        // Delete entire story folder\n        const { data: files, error: listError } = await this.supabase.storage\n          .from(this.bucketName)\n          .list(storyId);\n\n        if (listError) {\n          throw new Error(`Failed to list story images: ${listError.message}`);\n        }\n\n        if (files && files.length > 0) {\n          const paths = files.map(file => `${storyId}/${file.name}`);\n          const { error: deleteError } = await this.supabase.storage\n            .from(this.bucketName)\n            .remove(paths);\n\n          if (deleteError) {\n            throw new Error(`Failed to delete story images: ${deleteError.message}`);\n          }\n        }\n      }\n    } catch (error) {\n      const errorMessage = error instanceof Error ? error.message : String(error);\n      throw new Error(`Failed to delete scene images: ${errorMessage}`);\n    }\n  }\n}\n\n/**\n * Create a singleton instance of SceneImageStorageClient\n *\n * Uses environment variables for configuration.\n */\nexport function createSceneImageStorageClient(): SceneImageStorageClient {\n  const supabaseUrl = process.env.SUPABASE_URL;\n  const supabaseServiceKey = process.env.SUPABASE_SERVICE_KEY;\n\n  if (!supabaseUrl || !supabaseServiceKey) {\n    throw new Error(\n      'Missing required environment variables: SUPABASE_URL and SUPABASE_SERVICE_KEY'\n    );\n  }\n\n  return new SceneImageStorageClient({\n    supabaseUrl,\n    supabaseServiceKey,\n  });\n}\n\n/**\n * Singleton instance for convenience\n */\n","exit_code":0,"status":"completed"}}
