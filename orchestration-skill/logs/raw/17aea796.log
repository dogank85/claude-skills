{"type":"item.completed","item":{"id":"item_124","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' apps/web/app/api/cron/photo-deletion/route.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Vercel Cron Route: Photo Deletion Worker\n *\n * This API route is invoked hourly by Vercel Cron to delete expired photos\n * from Supabase Storage and update the audit trail.\n *\n * Vercel Cron Configuration (vercel.json):\n * {\n *   \"crons\": [{\n *     \"path\": \"/api/cron/photo-deletion\",\n *     \"schedule\": \"0 * * * *\"\n *   }]\n * }\n *\n * Security:\n * - Requires Authorization header with CRON_SECRET\n * - CRON_SECRET is auto-injected by Vercel for cron requests\n * - Manual invocations must provide the secret\n */\n\nimport { NextRequest, NextResponse } from 'next/server';\nimport { PrismaClient } from '@herokid/database';\nimport { createClient } from '@supabase/supabase-js';\nimport * as Sentry from '@sentry/nextjs';\nimport { validateCronRequest } from '../auth';\n\nconst BATCH_SIZE = 100;\nconst RETRY_ATTEMPTS = 3;\nconst RETRY_DELAY_MS = 1000;\n\ninterface DeletionResult {\n  success: boolean;\n  alreadyDeleted?: boolean;\n  error?: string;\n}\n\nasync function sleep(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nasync function deleteFromStorage(\n  supabase: any,\n  bucket: string,\n  objectPath: string,\n  retries = RETRY_ATTEMPTS\n): Promise<DeletionResult> {\n  for (let attempt = 1; attempt <= retries; attempt++) {\n    try {\n      const { error } = await supabase.storage.from(bucket).remove([objectPath]);\n\n      if (error) {\n        if (\n          error.message.includes('not found') ||\n          error.message.includes('does not exist')\n        ) {\n          return { success: true, alreadyDeleted: true };\n        }\n        throw new Error(`Storage deletion failed: ${error.message}`);\n      }\n\n      return { success: true, alreadyDeleted: false };\n    } catch (error) {\n      if (attempt < retries) {\n        await sleep(RETRY_DELAY_MS * attempt);\n      } else {\n        return {\n          success: false,\n          error: error instanceof Error ? error.message : 'Unknown error',\n        };\n      }\n    }\n  }\n\n  return { success: false, error: 'Max retries exceeded' };\n}\n\nexport async function GET(request: NextRequest) {\n  const startTime = Date.now();\n\n  const authError = validateCronRequest(request);\n  if (authError) {\n    return authError;\n  }\n\n  // Verify required environment variables\n  const dbUrl = process.env.DATABASE_URL;\n  const supabaseUrl = process.env.SUPABASE_URL;\n  const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY;\n\n  if (!dbUrl || !supabaseUrl || !serviceRoleKey) {\n    const error = new Error(\n      'Missing required environment variables: DATABASE_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY'\n    );\n    Sentry.captureException(error);\n    return NextResponse.json(\n      { error: 'Server configuration error' },\n      { status: 500 }\n    );\n  }\n\n  const prisma = new PrismaClient();\n  const supabase = createClient(supabaseUrl, serviceRoleKey);\n\n  let processed = 0;\n  let deleted = 0;\n  let failed = 0;\n  let alreadyDeleted = 0;\n\n  try {\n    // Find photos due for deletion\n    const overduePhotos = await prisma.photoDeletionAudit.findMany({\n      where: {\n        status: {\n          in: ['SCHEDULED', 'OVERDUE', 'FAILED'],\n        },\n        deletionDueAt: {\n          lte: new Date(),\n        },\n      },\n      orderBy: {\n        deletionDueAt: 'asc',\n      },\n      take: BATCH_SIZE,\n    });\n\n    console.log(`Found ${overduePhotos.length} photo(s) due for deletion`);\n\n    // Process each photo\n    for (const photo of overduePhotos) {\n      processed++;\n\n      const result = await deleteFromStorage(\n        supabase,\n        photo.bucket,\n        photo.objectPath\n      );\n\n      if (result.success) {\n        await prisma.photoDeletionAudit.update({\n          where: { id: photo.id },\n          data: {\n            status: 'DELETED',\n            deletedAt: new Date(),\n            executor: 'vercel-cron',\n            notes: result.alreadyDeleted\n              ? 'Object not found in storage (may have been deleted by lifecycle policy)'\n              : 'Deleted successfully by Vercel Cron',\n          },\n        });\n\n        if (result.alreadyDeleted) {\n          alreadyDeleted++;\n        } else {\n          deleted++;\n        }\n      } else {\n        failed++;\n        const errorMsg = `Failed to delete from storage: ${result.error}`;\n\n        await prisma.photoDeletionAudit.update({\n          where: { id: photo.id },\n          data: {\n            status: 'FAILED',\n            notes: errorMsg,\n          },\n        });\n\n        // Send alert to Sentry\n        Sentry.captureException(new Error(errorMsg), {\n          extra: {\n            photoId: photo.id,\n            bucket: photo.bucket,\n            objectPath: photo.objectPath,\n            uploadedAt: photo.uploadedAt,\n            deletionDueAt: photo.deletionDueAt,\n          },\n        });\n      }\n    }\n\n    // Check for critically overdue photos (>48 hours past deletion due date)\n    const criticallyOverdue = await prisma.photoDeletionAudit.findMany({\n      where: {\n        status: {\n          in: ['SCHEDULED', 'OVERDUE', 'FAILED'],\n        },\n        deletionDueAt: {\n          lte: new Date(Date.now() - 48 * 60 * 60 * 1000),\n        },\n      },\n    });\n\n    if (criticallyOverdue.length > 0) {\n      // Update status to OVERDUE\n      await prisma.photoDeletionAudit.updateMany({\n        where: {\n          id: {\n            in: criticallyOverdue.map((p) => p.id),\n          },\n        },\n","exit_code":0,"status":"completed"}}
