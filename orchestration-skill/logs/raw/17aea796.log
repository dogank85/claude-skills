{"type":"item.completed","item":{"id":"item_120","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' apps/mobile/src/hooks/useAuth.tsx\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { create } from 'zustand';\nimport * as Keychain from 'react-native-keychain';\nimport * as LocalAuthentication from 'expo-local-authentication';\n\nconst KEYCHAIN_SERVICE = 'com.herokid.auth';\nconst ACCESS_TOKEN_KEY = 'herokid_access_token';\nconst REFRESH_TOKEN_KEY = 'herokid_refresh_token';\nconst EXPIRES_AT_KEY = 'herokid_expires_at';\n\nexport interface AuthState {\n  accessToken: string | null;\n  refreshToken: string | null;\n  expiresAt: number | null;\n  isAuthenticated: boolean;\n  isLoading: boolean;\n  biometricsEnabled: boolean;\n}\n\ninterface AuthStore extends AuthState {\n  setTokens: (session: { accessToken: string; refreshToken: string; expiresAt?: number | null }) => Promise<void>;\n  clearTokens: () => Promise<void>;\n  loadTokens: () => Promise<void>;\n  checkBiometricsAvailable: () => Promise<boolean>;\n  authenticateWithBiometrics: () => Promise<boolean>;\n}\n\n/**\n * Zustand store for authentication state\n */\nexport const useAuthStore = create<AuthStore>((set, get) => ({\n  accessToken: null,\n  refreshToken: null,\n  expiresAt: null,\n  isAuthenticated: false,\n  isLoading: true,\n  biometricsEnabled: false,\n\n  setTokens: async (session) => {\n    const { accessToken, refreshToken, expiresAt } = session;\n\n    // Store tokens in secure keychain\n    await Keychain.setGenericPassword(\n      ACCESS_TOKEN_KEY,\n      JSON.stringify({\n        accessToken,\n        refreshToken,\n        expiresAt: expiresAt || null,\n      }),\n      {\n        service: KEYCHAIN_SERVICE,\n        accessible: Keychain.ACCESSIBLE.WHEN_UNLOCKED_THIS_DEVICE_ONLY,\n      }\n    );\n\n    set({\n      accessToken,\n      refreshToken,\n      expiresAt: expiresAt || null,\n      isAuthenticated: true,\n      isLoading: false,\n    });\n  },\n\n  clearTokens: async () => {\n    await Keychain.resetGenericPassword({ service: KEYCHAIN_SERVICE });\n    set({\n      accessToken: null,\n      refreshToken: null,\n      expiresAt: null,\n      isAuthenticated: false,\n      isLoading: false,\n    });\n  },\n\n  loadTokens: async () => {\n    try {\n      const credentials = await Keychain.getGenericPassword({ service: KEYCHAIN_SERVICE });\n\n      if (credentials) {\n        try {\n          const parsed = JSON.parse(credentials.password);\n\n          // Validate the structure\n          if (\n            typeof parsed === 'object' &&\n            parsed !== null &&\n            typeof parsed.accessToken === 'string' &&\n            typeof parsed.refreshToken === 'string' &&\n            (parsed.expiresAt === null || typeof parsed.expiresAt === 'number')\n          ) {\n            set({\n              accessToken: parsed.accessToken,\n              refreshToken: parsed.refreshToken,\n              expiresAt: parsed.expiresAt,\n              isAuthenticated: true,\n              isLoading: false,\n            });\n          } else {\n            console.error('[Auth] Invalid token structure in keychain');\n            // Clear corrupted credentials\n            await Keychain.resetGenericPassword({ service: KEYCHAIN_SERVICE });\n            set({\n              accessToken: null,\n              refreshToken: null,\n              expiresAt: null,\n              isAuthenticated: false,\n              isLoading: false,\n            });\n          }\n        } catch (parseError) {\n          console.error('[Auth] Failed to parse credentials JSON:', parseError);\n          // Clear corrupted credentials\n          await Keychain.resetGenericPassword({ service: KEYCHAIN_SERVICE });\n          set({\n            accessToken: null,\n            refreshToken: null,\n            expiresAt: null,\n            isAuthenticated: false,\n            isLoading: false,\n          });\n        }\n      } else {\n        set({\n          accessToken: null,\n          refreshToken: null,\n          expiresAt: null,\n          isAuthenticated: false,\n          isLoading: false,\n        });\n      }\n    } catch (error) {\n      console.error('[Auth] Failed to load tokens from keychain:', error);\n      set({\n        accessToken: null,\n        refreshToken: null,\n        expiresAt: null,\n        isAuthenticated: false,\n        isLoading: false,\n      });\n    }\n  },\n\n  checkBiometricsAvailable: async () => {\n    const compatible = await LocalAuthentication.hasHardwareAsync();\n    const enrolled = await LocalAuthentication.isEnrolledAsync();\n    const available = compatible && enrolled;\n\n    set({ biometricsEnabled: available });\n    return available;\n  },\n\n  authenticateWithBiometrics: async () => {\n    try {\n      const result = await LocalAuthentication.authenticateAsync({\n        promptMessage: 'Authenticate to access HeroKid',\n        fallbackLabel: 'Use password',\n        disableDeviceFallback: false,\n      });\n\n      return result.success;\n    } catch (error) {\n      console.error('Biometric authentication error:', error);\n      return false;\n    }\n  },\n}));\n\n/**\n * Hook to access auth state and functions\n */\nexport function useAuth() {\n  const store = useAuthStore();\n\n  return {\n    accessToken: store.accessToken,\n    refreshToken: store.refreshToken,\n    expiresAt: store.expiresAt,\n    isAuthenticated: store.isAuthenticated,\n    isLoading: store.isLoading,\n    biometricsEnabled: store.biometricsEnabled,\n    setTokens: store.setTokens,\n    clearTokens: store.clearTokens,\n    loadTokens: store.loadTokens,\n    checkBiometricsAvailable: store.checkBiometricsAvailable,\n    authenticateWithBiometrics: store.authenticateWithBiometrics,\n  };\n}\n\n/**\n * Check if access token is expired or about to expire (within 5 minutes)\n */\nexport function isTokenExpired(expiresAt: number | null): boolean {\n  if (!expiresAt) return true;\n\n  const now = Date.now() / 1000; // Convert to seconds\n  const buffer = 5 * 60; // 5 minutes buffer\n\n  return now >= (expiresAt - buffer);\n}\n","exit_code":0,"status":"completed"}}
