{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' apps/mobile/src/providers/trpc.tsx\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { ReactNode, useEffect, useMemo, useRef } from 'react';\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query';\nimport { createApiClient, resolveBaseUrl, trpcReact } from '@herokid/api/client';\nimport { useAuth, useAuthStore, isTokenExpired } from '../hooks/useAuth';\n\n// Export trpc as an alias for trpcReact for backward compatibility\nexport const trpc = trpcReact;\n\ntype Props = {\n  children: ReactNode;\n};\n\n// Create QueryClient singleton outside component to prevent re-creation\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: {\n      refetchOnReconnect: true,\n      staleTime: 1000 * 60 * 5, // 5 minutes - reduce unnecessary refetches\n      gcTime: 1000 * 60 * 30, // 30 minutes (formerly cacheTime)\n      retry: (failureCount, error: any) => {\n        // Don't retry on auth errors\n        if (error?.data?.code === 'UNAUTHORIZED') {\n          return false;\n        }\n        return failureCount < 3;\n      },\n    },\n  },\n});\n\nexport function MobileApiProviders({ children }: Props) {\n  const auth = useAuth();\n\n  const apiBase =\n    typeof process !== 'undefined' ? process.env.EXPO_PUBLIC_API_URL : undefined;\n\n  // Use ref to store current token to avoid recreating client on every token change\n  const tokenRef = useRef(auth.accessToken);\n  tokenRef.current = auth.accessToken;\n\n  const trpcClient = useMemo(\n    () =>\n      createApiClient({\n        baseUrl: resolveBaseUrl(apiBase),\n        headers: () => {\n          // Get latest token from ref instead of closure\n          if (tokenRef.current) {\n            return {\n              Authorization: `Bearer ${tokenRef.current}`,\n            };\n          }\n          return {};\n        },\n      }),\n    [apiBase], // Only recreate if API base changes, not on every token change\n  );\n\n  // Load tokens from keychain on mount\n  useEffect(() => {\n    auth.loadTokens();\n  }, []);\n\n  // Check for biometrics availability on mount\n  useEffect(() => {\n    auth.checkBiometricsAvailable();\n  }, []);\n\n  return (\n    <QueryClientProvider client={queryClient}>\n      <trpcReact.Provider client={trpcClient} queryClient={queryClient}>\n        <SessionManager>{children}</SessionManager>\n      </trpcReact.Provider>\n    </QueryClientProvider>\n  );\n}\n\n/**\n * SessionManager handles automatic token refresh\n */\nfunction SessionManager({ children }: { children: ReactNode }) {\n  const auth = useAuth();\n  const refreshMutation = trpcReact.auth.refreshSession.useMutation({\n    onSuccess: (data) => {\n      // Update tokens in state and keychain\n      auth.setTokens({\n        accessToken: data.session.accessToken,\n        refreshToken: data.session.refreshToken,\n        expiresAt: data.session.expiresAt,\n      });\n    },\n    onError: (error) => {\n      console.error('Token refresh failed:', error);\n      // Clear tokens if refresh fails\n      auth.clearTokens();\n    },\n  });\n\n  // Periodically check if token needs refresh\n  useEffect(() => {\n    if (!auth.isAuthenticated || !auth.refreshToken) {\n      return;\n    }\n\n    const checkAndRefresh = () => {\n      if (isTokenExpired(auth.expiresAt)) {\n        refreshMutation.mutate({ refreshToken: auth.refreshToken! });\n      }\n    };\n\n    // Check immediately\n    checkAndRefresh();\n\n    // Check every 5 minutes instead of every minute (reduces battery usage)\n    const interval = setInterval(checkAndRefresh, 5 * 60 * 1000);\n\n    return () => clearInterval(interval);\n  }, [auth.isAuthenticated, auth.refreshToken, auth.expiresAt]);\n\n  return <>{children}</>;\n}\n\n/**\n * Hook to get Supabase session\n */\nexport function useSupabaseSession() {\n  const auth = useAuth();\n\n  return {\n    session: auth.isAuthenticated\n      ? {\n          accessToken: auth.accessToken,\n          refreshToken: auth.refreshToken,\n          expiresAt: auth.expiresAt,\n        }\n      : null,\n    isAuthenticated: auth.isAuthenticated,\n    isLoading: auth.isLoading,\n  };\n}\n","exit_code":0,"status":"completed"}}
