{"type":"item.completed","item":{"id":"item_150","type":"command_execution","command":"/bin/zsh -lc \"sed -n '660,760p' packages/api/src/routers/credits.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n          },\n        });\n\n        await tx.creditTransaction.create({\n          data: {\n            parentId: parent.id,\n            credits,\n            type: 'PURCHASE',\n            description: `Google Play: ${credits} credits`,\n          },\n        });\n\n        // Update parent's credit balance atomically\n        const updatedParent = await tx.parent.update({\n          where: { id: parent.id },\n          data: {\n            creditBalance: {\n              increment: credits,\n            },\n          },\n          select: { creditBalance: true },\n        });\n\n        return { creditPack, newBalance: updatedParent.creditBalance };\n      });\n\n      return {\n        success: true,\n        credits,\n        balance: result.newBalance,\n        creditPackId: result.creditPack.id,\n      };\n    }),\n\n  /**\n   * Create Stripe checkout session for credit purchase\n   */\n  createStripeCheckout: protectedProcedure\n    .input(\n      z.object({\n        credits: z.number().int().refine(val => [1, 5, 10].includes(val)),\n        successUrl: z.string().url().optional(),\n        cancelUrl: z.string().url().optional(),\n      })\n    )\n    .mutation(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true, email: true },\n      });\n\n      if (!parent || !parent.email) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      // Import Stripe client\n      const { stripe } = await import('../lib/stripe');\n\n      // Credit pack pricing with bundle discounts\n      // IMPORTANT: These prices MUST match the UI in apps/web/app/(dashboard)/dashboard/credits/buy/page.tsx\n      const CREDIT_PACK_PRICES: Record<1 | 5 | 10, number> = {\n        1: 0.99,   // $0.99 - no discount\n        5: 4.49,   // $4.49 - 10% discount (was $4.95)\n        10: 7.99,  // $7.99 - 20% discount (was $9.90)\n      };\n\n      const price = CREDIT_PACK_PRICES[input.credits as 1 | 5 | 10];\n      const baseUrl = process.env.NEXT_PUBLIC_APP_URL || 'http://localhost:3000';\n\n      const successUrl = input.successUrl || `${baseUrl}/purchase/success?session_id={CHECKOUT_SESSION_ID}`;\n      const cancelUrl = input.cancelUrl || `${baseUrl}/purchase?cancelled=true`;\n\n      try {\n        // Create Stripe checkout session\n        const session = await stripe.checkout.sessions.create({\n          payment_method_types: ['card'],\n          line_items: [\n            {\n              price_data: {\n                currency: 'usd',\n                product_data: {\n                  name: `${input.credits} Story ${input.credits === 1 ? 'Credit' : 'Credits'}`,\n                  description: `Generate ${input.credits} personalized ${input.credits === 1 ? 'story' : 'stories'} with PDF downloads`,\n                  images: ['https://herokid.app/images/credit-pack.png'], // Optional: Add product image\n                },\n                unit_amount: Math.round(price * 100), // Convert to cents\n              },\n              quantity: 1,\n            },\n          ],\n          mode: 'payment',\n          success_url: successUrl,\n          cancel_url: cancelUrl,\n          customer_email: parent.email,\n          client_reference_id: parent.id,\n          metadata: {\n            parentId: parent.id,\n            credits: input.credits.toString(),\n","exit_code":0,"status":"completed"}}
