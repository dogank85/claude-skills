ny).gtag('event', 'purchase_initiated', {\n          value: CREDIT_PACKS.find(p => p.credits === purchasingPack)?.price,\n          currency: 'USD',\n          pack_size: purchasingPack,\n        });\n      }\n\n      // Redirect to Stripe checkout\n      if (data.checkoutUrl) {\n        window.location.href = data.checkoutUrl;\n      }\n    },\n    onError: (error) => {\n      console.error('Checkout error:', error);\n      alert('Failed to create checkout session. Please try again.');\n      setPurchasingPack(null);\n    },\n  });\n\n  const handlePurchase = async (pack: CreditPack) => {\n    setPurchasingPack(pack.credits);\n\n    // Track analytics\n    if (typeof window !== 'undefined' && (window as any).gtag) {\n      (window as any).gtag('event', 'pack_selected', {\n        pack_size: pack.credits,\n        price: pack.price,\n      });\n    }\n\n    const baseUrl = process.env.NEXT_PUBLIC_APP_URL || window.location.origin;\n\n    createCheckout.mutate({\n      credits: pack.credits,\n      successUrl: `${baseUrl}/purchase/success?session_id={CHECKOUT_SESSION_ID}`,\n      cancelUrl: `${baseUrl}/purchase?cancelled=true`,\n    });\n  };\n\n  // Track page view\n  if (typeof window !== 'undefined' && (window as any).gtag) {\n    (window as any).gtag('event', 'purchase_page_viewed');\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gray-50 py-12\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Header */}\n        <div className=\"text-center mb-12\">\n          <Link\n            href=\"/dashboard/billing\"\n            className=\"inline-flex items-center text-sm text-gray-600 hover:text-gray-900 mb-4\"\n          >\n            <svg className=\"w-4 h-4 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M10 19l-7-7m0 0l7-7m-7 7h18\" />\n            </svg>\n            Back to Billing\n          </Link>\n          <h1 className=\"text-4xl font-bold text-gray-900 mb-4\">\n            Purchase Story Credits\n          </h1>\n          <p className=\"text-lg text-gray-600 max-w-2xl mx-auto\">\n            Choose the perfect pack for your family's storytelling adventures\n          </p>\n        </div>\n\n        {/* Current Balance */}\n        {!balanceLoading && balance && (\n          <div className=\"max-w-md mx-auto mb-8\">\n            <div className=\"bg-white rounded-lg shadow-md p-6 border border-gray-200\">\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <p className=\"text-sm text-gray-600 mb-1\">Current Balance</p>\n                  <div className=\"flex items-baseline gap-2\">\n                    <span className=\"text-3xl font-bold text-gray-900\">{balance.credits}</span>\n                    <span className=\"text-lg text-gray-600\">\n                      {balance.credits === 1 ? 'credit' : 'credits'}\n                    </span>\n                  </div>\n                </div>\n                <svg\n                  className=\"w-12 h-12 text-indigo-500\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  viewBox=\"0 0 24 24\"\n                >\n                  <path\n                    strokeLinecap=\"round\"\n                    strokeLinejoin=\"round\"\n                    strokeWidth={2}\n                    d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"\n                  />\n                </svg>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Credit Packs */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto\">\n          {CREDIT_PACKS.map((pack) => {\n            const isPurchasing = purchasingPack === pack.credits;\n            const isMostPopular = pack.badge === 'Most Popular';\n\n            return (\n              <div\n                key={pack.credits}\n                className={`relative bg-white rounded-lg shadow-lg overflow-hidden transition-transform hover:scale-105 ${\n                  isMostPopular ? 'ring-2 ring-indigo-500' : ''\n                }`}\n              >\n                {/* Badge */}\n                {pack.badge && (\n                  <div className=\"absolute top-0 right-0 bg-indigo-500 text-white px-3 py-1 text-xs font-semibold rounded-bl-lg\">\n                    {pack.badge}\n                  </div>\n                )}\n\n                <div className=\"p-6\">\n                  {/* Pack Title */}\n                  <div className=\"text-center mb-6\">\n                    <h3 className=\"text-2xl font-bold text-gray-900 mb-2\">\n                      {pack.label}\n                    </h3>\n                    <div className=\"flex items-baseline justify-center gap-1\">\n                      <span className=\"text-4xl font-bold text-gray-900\">\n                        ${pack.price.toFixed(2)}\n                      </span>\n                    </div>\n                    <p className=\"text-sm text-gray-600 mt-2\">\n                      ${pack.perStoryPrice.toFixed(2)} per story\n                    </p>\n                    {pack.savings && (\n                      <p className=\"text-sm font-medium text-green-600 mt-1\">\n                        Save {pack.savings}%\n                      </p>\n                    )}\n                  </div>\n\n                  {/* Features */}\n                  <ul className=\"space-y-3 mb-6\">\n                    <li className=\"flex items-start\">\n","exit_code":0,"status":"completed"}}
