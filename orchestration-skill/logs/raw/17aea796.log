{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/routers/story.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Story Router - Epic 4: AI Story Generation Engine + Epic 6: Credit-Based Monetization\n * Story 6.11: Credit-Gated Story Generation\n *\n * Handles story generation using:\n * - Google Gemini 2.5 Flash-Lite for text generation\n * - Google Nano Banana (Imagen) for scene images\n * - Async job processing with polling for status updates\n * - Credit-based monetization (1 credit per story)\n */\n\nimport { TRPCError } from '@trpc/server';\nimport { z } from 'zod';\nimport { createTRPCRouter, protectedProcedure } from '../trpc';\nimport { verifyParentOwnership } from '../utils/verifyParentOwnership'; // Import shared function\nimport { generateStoryAsync } from '../lib/generateStoryAsync'; // Import shared function\nimport {\n  generateStorySchema,\n  getGenerationStatusSchema,\n  getStorySchema,\n  listStoriesSchema,\n  updateProgressSchema,\n} from '@herokid/validators/story';\nimport type { Context } from '../context';\n\n/**\n * Calculate progress percentage based on generation status\n * Maps Prisma enum values (uppercase) to progress percentages\n */\nfunction calculateProgress(status: string): number {\n  const progressMap: Record<string, number> = {\n    PENDING: 0,\n    GENERATING_TEXT: 30,\n    GENERATING_IMAGES: 70,\n    COMPLETE: 100,\n    FAILED: 0,\n    // Legacy lowercase support (for backward compatibility)\n    pending: 0,\n    generating_text: 30,\n    generating_images: 70,\n    complete: 100,\n    failed: 0,\n  };\n  return progressMap[status] || 0;\n}\n\n/**\n * Verify that the parent owns the story (via child profile)\n */\nasync function assertStoryOwnership(\n  ctx: Context,\n  storyId: string,\n  parentId: string\n) {\n  const story = await ctx.prisma.story.findUnique({\n    where: { id: storyId },\n    select: {\n      id: true,\n      parentId: true,\n      childProfileId: true,\n      childProfile: {\n        select: {\n          parentId: true,\n        },\n      },\n    },\n  });\n\n  if (!story) {\n    throw new TRPCError({\n      code: 'NOT_FOUND',\n      message: 'Story not found.',\n    });\n  }\n\n  // Check ownership via direct parent relation or child profile parent\n  const ownsStory =\n    story.parentId === parentId ||\n    story.childProfile?.parentId === parentId;\n\n  if (!ownsStory) {\n    throw new TRPCError({\n      code: 'FORBIDDEN',\n      message: 'You do not have permission to access this story.',\n    });\n  }\n\n  return story;\n}\n\n/**\n * Ensure the authenticated parent exists and is active\n */\nasync function assertAuthenticatedParent(ctx: Context) {\n  if (!ctx.viewer) {\n    throw new TRPCError({\n      code: 'UNAUTHORIZED',\n      message: 'Authentication required.',\n    });\n  }\n\n  const parent = await ctx.prisma.parent.findUnique({\n    where: { supabaseUserId: ctx.viewer.id },\n    select: {\n      id: true,\n      email: true,\n      status: true,\n    },\n  });\n\n  if (!parent) {\n    throw new TRPCError({\n      code: 'NOT_FOUND',\n      message: 'Parent profile not found.',\n    });\n  }\n\n  if (parent.status !== 'ACTIVE') {\n    throw new TRPCError({\n      code: 'FORBIDDEN',\n      message: 'Parent account is not active.',\n    });\n  }\n\n  return parent;\n}\n\ntype StoryReservationResult = {\n  jobId: string;\n  appliedCost: number;\n  reservationTransactionId?: string;\n  firstFreeCreditId?: string;\n  creditsRemaining: number;\n};\n\n/**\n * Reserve credits for story generation and create a job atomically.\n * Includes first-free logic (one free paid story per parent) with a row lock to prevent abuse.\n */\nexport async function reserveCreditsForStory(params: {\n  ctx: Context;\n  parentId: string;\n  childProfileId: string;\n  adventureTemplate: string;\n  artStyle: string;\n  includePet: boolean;\n  cost: number;\n}): Promise<StoryReservationResult> {\n  const { ctx, parentId, childProfileId, adventureTemplate, artStyle, includePet, cost } = params;\n\n  return ctx.prisma.$transaction(async (tx) => {\n    // Lock parent row to serialize free-story claims and concurrent deductions\n    await tx.$executeRaw`SELECT 1 FROM \"parents\" WHERE id = ${parentId} FOR UPDATE`;\n\n    const existingStories = await tx.story.count({\n      where: {\n        parentId,\n        deletedAt: null,\n        isGeneric: false,\n      },\n    });\n\n    const existingFirstFree = await tx.creditTransaction.findFirst({\n      where: {\n        parentId,\n        type: 'BONUS',\n        description: { in: ['FIRST_FREE_STORY_LOCK', 'FIRST_FREE_STORY_GRANTED'] },\n      },\n      select: { id: true },\n    });\n\n    const firstFreeAvailable = cost > 0 && existingStories === 0 && !existingFirstFree;\n\n    let appliedCost = cost;\n    let reservationTransactionId: string | undefined;\n    let firstFreeCreditId: string | undefined;\n\n    if (firstFreeAvailable) {\n      const bonusTx = await tx.creditTransaction.create({\n        data: {\n          parentId,\n          credits: 0,\n          type: 'BONUS',\n          description: 'FIRST_FREE_STORY_LOCK',\n        },\n      });\n\n      firstFreeCreditId = bonusTx.id;\n      appliedCost = 0;\n    }\n\n    if (appliedCost > 0) {\n      const debitResult = await tx.parent.updateMany({\n        where: {\n          id: parentId,\n          creditBalance: { gte: appliedCost },\n        },\n        data: {\n          creditBalance: { decrement: appliedCost },\n        },\n","exit_code":0,"status":"completed"}}
