nd\"\n            strokeLinejoin=\"round\"\n            strokeWidth={2}\n            d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"\n          />\n        </svg>\n        <div className=\"flex flex-col\">\n          <span className=\"text-xs font-medium\">Credits</span>\n          <span className={`text-sm font-bold ${isLowCredit ? 'text-warning-900' : ''}`}>\n            {credits}\n          </span>\n        </div>\n        {isLowCredit && (\n          <Badge variant=\"warning\" className=\"ml-1\">\n            !\n          </Badge>\n        )}\n      </Link>\n    );\n  }\n\n  // Full view for dashboard\n  return (\n    <Card className=\"animate-fade-in\">\n      <CardHeader>\n        <div className=\"flex items-center justify-between\">\n          <CardTitle>Credit Balance</CardTitle>\n          <svg\n            className=\"w-8 h-8 text-accent-600\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            viewBox=\"0 0 24 24\"\n          >\n            <path\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              strokeWidth={2}\n              d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"\n            />\n          </svg>\n        </div>\n      </CardHeader>\n\n      <CardContent>\n        <div className=\"flex items-baseline gap-2 mb-6\">\n          <span className=\"text-5xl font-extrabold text-accent-600\">{credits}</span>\n          <span className=\"text-xl text-neutral-600\">\n            {credits === 1 ? 'credit' : 'credits'}\n          </span>\n        </div>\n\n        {/* Low Credit Warning */}\n        {isLowCredit && (\n          <div\n            className={`p-4 rounded-xl mb-4 border-2 animate-slide-in-up ${isOutOfCredits\n                ? 'bg-error-50 border-error-200'\n                : 'bg-warning-50 border-warning-200'\n              }`}\n          >\n            <div className=\"flex items-start gap-3\">\n              <svg\n                className={`w-6 h-6 mt-0.5 flex-shrink-0 ${isOutOfCredits ? 'text-error-600' : 'text-warning-600'\n                  }`}\n                fill=\"none\"\n                stroke=\"currentColor\"\n                viewBox=\"0 0 24 24\"\n              >\n                <path\n                  strokeLinecap=\"round\"\n                  strokeLinejoin=\"round\"\n                  strokeWidth={2}\n                  d=\"M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z\"\n                />\n              </svg>\n              <div className=\"flex-1\">\n                <p\n                  className={`text-base font-semibold ${isOutOfCredits ? 'text-error-800' : 'text-warning-800'\n                    }`}\n                >\n                  {isOutOfCredits ? 'Out of Credits' : 'Low Credit Balance'}\n                </p>\n                <p\n                  className={`text-sm mt-1 ${isOutOfCredits ? 'text-error-700' : 'text-warning-700'\n                    }`}\n                >\n                  {isOutOfCredits\n                    ? 'You need credits to generate new stories. Purchase more credits to continue.'\n                    : `You have ${credits} ${credits === 1 ? 'credit' : 'credits'\n                    } remaining. Consider purchasing more to avoid interruption.`}\n                </p>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Free Avatar Info */}\n        {balance.hasFreeAvatarGeneration && (\n          <div className=\"p-4 bg-info-50 border-2 border-info-200 rounded-xl mb-4 animate-slide-in-up\">\n            <div className=\"flex items-start gap-3\">\n              <svg\n                className=\"w-6 h-6 mt-0.5 flex-shrink-0 text-info-600\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                viewBox=\"0 0 24 24\"\n              >\n                <path\n                  strokeLinecap=\"round\"\n                  strokeLinejoin=\"round\"\n                  strokeWidth={2}\n                  d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"\n                />\n              </svg>\n              <div className=\"flex-1\">\n                <p className=\"text-base font-semibold text-info-800\">Free Avatar Available</p>\n                <p className=\"text-sm mt-1 text-info-700\">\n                  You can generate one free avatar before needing to purchase credits.\n                </p>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Purchase Button */}\n        <Button\n          variant={isLowCredit ? 'primary' : 'secondary'}\n          size=\"lg\"\n          fullWidth\n          className=\"mb-4\"\n          onClick={() => (window.location.href = '/dashboard/billing?action=purchase')}\n        >\n          {isOutOfCredits ? 'Purchase Credits Now' : 'Purchase More Credits'}\n        </Button>\n\n        {/* Credits Info */}\n        <div className=\"text-center space-y-1\">\n          <p className=\"text-xs text-neutral-500\">\n            <span className=\"font-medium\">Avatar:</span> 4 credits (first free) •{' '}\n            <span className=\"font-medium\">Pet:</span> 4 credits (first free) •{' '}\n            <span className=\"font-medium\">Story:</span> 10 credits\n          </p>\n          <p className=\"text-xs text-neutral-500\">\n            <span className=\"font-medium\">Credit packs:</span> 1 credit ($0.99), 5 credits ($4.49),\n            10 credits ($7.99)\n","exit_code":0,"status":"completed"}}
