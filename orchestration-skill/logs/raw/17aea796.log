{"type":"item.completed","item":{"id":"item_98","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/client.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n'use client';\n\nimport { createTRPCProxyClient, httpBatchLink, loggerLink } from '@trpc/client';\nimport { createTRPCReact } from '@trpc/react-query';\nimport superjson from 'superjson';\nimport type { AppRouter } from './root';\n\nexport const trpcReact = createTRPCReact<AppRouter>();\n\nexport type CreateClientOptions = {\n  baseUrl?: string;\n  headers?: () => Record<string, string>;\n};\n\nexport function createApiClient(options: CreateClientOptions = {}) {\n  const baseUrl = resolveBaseUrl(options.baseUrl);\n  const endpoint = baseUrl ? `${baseUrl}/api/trpc` : '/api/trpc';\n\n  return createTRPCProxyClient<AppRouter>({\n    transformer: superjson as any,\n    links: [\n      loggerLink({\n        enabled: () => process.env.NODE_ENV === 'development',\n      }),\n      httpBatchLink({\n        url: endpoint,\n        headers: options.headers,\n        transformer: superjson as any,\n      }),\n    ],\n  });\n}\n\nexport function resolveBaseUrl(explicit?: string) {\n  if (explicit) {\n    return explicit.replace(/\\/$/, '');\n  }\n\n  if (typeof window !== 'undefined') {\n    return '';\n  }\n\n  if (typeof process !== 'undefined') {\n    return (\n      process.env.NEXT_PUBLIC_API_URL ??\n      process.env.EXPO_PUBLIC_API_URL ??\n      process.env.API_BASE_URL ??\n      'http://localhost:3000'\n    );\n  }\n\n  return 'http://localhost:3000';\n}\n","exit_code":0,"status":"completed"}}
