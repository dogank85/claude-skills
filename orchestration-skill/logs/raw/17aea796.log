{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' \\\"apps/mobile/app/(tabs)/create.tsx\\\"\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Create Story Screen\n * Story 4.8: Mobile API Integration\n *\n * Allows children to create personalized stories by:\n * 1. Selecting an adventure type (Superhero, Treasure Hunt, Magic Training)\n * 2. Toggling pet companion inclusion\n * 3. Initiating story generation with real-time progress updates\n * 4. Auto-navigating to story reader on completion\n */\n\nimport React, { useState, useEffect } from 'react';\nimport {\n  View,\n  Text,\n  ScrollView,\n  Pressable,\n  Switch,\n  StyleSheet,\n  Alert,\n  SafeAreaView,\n} from 'react-native';\nimport { useRouter } from 'expo-router';\nimport { trpc } from '../../src/providers/trpc';\nimport { useChildStore } from '../../src/stores/childStore';\nimport {\n  AdventureCard,\n  ProgressModal,\n  ErrorMessage,\n  type AdventureType,\n  type ErrorType,\n} from '../../src/components/story';\nimport { useStoryGenerationPolling } from '../../src/hooks/useStoryGenerationPolling';\nimport { useCredits, useCheckBalance } from '../../src/hooks/useCredits';\nimport { InsufficientCreditsAlert } from '../../src/components/InsufficientCreditsAlert';\n\n// ... existing imports\n\n// ... existing code\n\n// ... existing code\n// ... existing imports\n\nexport default function CreateStoryScreen() {\n  const router = useRouter();\n  const { currentChild } = useChildStore();\n\n  // State\n  const [selectedAdventure, setSelectedAdventure] = useState<AdventureType | null>(null);\n  const [includePet, setIncludePet] = useState(false);\n  const [generationId, setGenerationId] = useState<string | null>(null);\n  const [showProgress, setShowProgress] = useState(false);\n  const [error, setError] = useState<{ type: ErrorType; message?: string } | null>(null);\n\n  // Credit hooks\n  const { balance: credits } = useCredits();\n  const { checkBalance } = useCheckBalance();\n  const [showInsufficientCredits, setShowInsufficientCredits] = useState(false);\n  const STORY_COST = 10;\n\n  // tRPC mutation for story generation\n  const generateStory = trpc.story.generateStory.useMutation({\n    onSuccess: (data) => {\n      setGenerationId(data.generationId);\n      setShowProgress(true);\n    },\n    onError: (err) => {\n      console.error('Failed to generate story:', err);\n\n      // Story 6.11: Handle insufficient credits error\n      if (err.message === 'INSUFFICIENT_CREDITS') {\n        Alert.alert(\n          'Story Credits Required',\n          'You need 10 credits to generate this story. Purchase credits to continue creating personalized stories.',\n          [\n            { text: 'Cancel', style: 'cancel' },\n            {\n              text: 'Purchase Credits',\n              onPress: () => router.push('/credits/purchase'),\n            },\n          ]\n        );\n        return;\n      }\n\n      // Determine error type\n      let errorType: ErrorType = 'generic';\n      if (err.message.includes('credit') || err.message.includes('limit')) {\n        errorType = 'insufficient_credits';\n      } else if (err.message.includes('network') || err.message.includes('connection')) {\n        errorType = 'network';\n      } else if (err.message.includes('avatars')) {\n        // Not eligible for story generation yet\n        Alert.alert(\n          'Avatars Required',\n          'Please create your child avatars before generating stories.',\n          [{ text: 'OK' }]\n        );\n        return;\n      }\n\n      setError({ type: errorType, message: err.message });\n    },\n  });\n\n  // Polling hook for generation status\n  const { isPolling, status, progress, storyId } = useStoryGenerationPolling({\n    generationId,\n    onComplete: (completedStoryId) => {\n      setShowProgress(false);\n      // Navigate to story reader\n      router.push(`/story/${completedStoryId}`);\n    },\n    onError: (errorMessage) => {\n      setShowProgress(false);\n      setError({ type: 'generic', message: errorMessage });\n    },\n    enabled: !!generationId && showProgress,\n  });\n\n  // Reset error when user changes selections\n  useEffect(() => {\n    if (error) {\n      setError(null);\n    }\n  }, [selectedAdventure, includePet]);\n\n  // Handle create story button press\n  const handleCreateStory = () => {\n    if (!currentChild) {\n      Alert.alert('No Child Selected', 'Please select a child profile first.', [{ text: 'OK' }]);\n      return;\n    }\n\n    if (!selectedAdventure) {\n      Alert.alert('Select Adventure', 'Please select an adventure type.', [{ text: 'OK' }]);\n      return;\n    }\n\n    // Check credits\n    const balanceCheck = checkBalance(STORY_COST);\n    if (!balanceCheck.hasSufficientBalance) {\n      setShowInsufficientCredits(true);\n      return;\n    }\n\n    // Initiate story generation\n    generateStory.mutate({\n      childProfileId: currentChild.id,\n      adventureTemplate: selectedAdventure,\n      includePet,\n      artStyle: currentChild.preferredArtStyle || undefined,\n    });\n  };\n\n  // Handle error retry\n  const handleRetry = () => {\n    setError(null);\n    if (selectedAdventure && currentChild) {\n      handleCreateStory();\n    }\n  };\n\n  // Handle error dismiss\n  const handleDismiss = () => {\n    setError(null);\n  };\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <ScrollView style={styles.scrollView} contentContainerStyle={styles.scrollContent}>\n        {/* Header */}\n        <View style={styles.header}>\n          <Text style={styles.title}>Create Your Story</Text>\n          {currentChild && (\n            <Text style={styles.subtitle}>\n              {currentChild.name}'s magical adventure awaits!\n            </Text>\n          )}\n        </View>\n\n        {/* Adventure Selection */}\n        <View style={styles.section}>\n          <Text style={styles.sectionTitle}>Choose Your Adventure</Text>\n\n          <AdventureCard\n            type=\"superhero_rescue\"\n            selected={selectedAdventure === 'superhero_rescue'}\n            onPress={() => setSelectedAdventure('superhero_rescue')}\n          />\n\n          <AdventureCard\n            type=\"treasure_hunt\"\n            selected={selectedAdventure === 'treasure_hunt'}\n            onPress={() => setSelectedAdventure('treasure_hunt')}\n          />\n\n          <AdventureCard\n            type=\"magic_training\"\n            selected={selectedAdventure === 'magic_training'}\n","exit_code":0,"status":"completed"}}
