{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/routers/privacy.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { TRPCError } from '@trpc/server';\nimport { z } from 'zod';\nimport { privacySchemas } from '@herokid/validators';\nimport { createTRPCRouter, protectedProcedure } from '../trpc';\nimport { createAuditLog, extractIpAddress } from '../lib/audit';\n\nconst GRACE_PERIOD_DAYS = 30;\nconst EXPORT_RETENTION_DAYS = 7;\nconst REMINDER_DAYS_BEFORE_DELETION = 7;\n\n/**\n * Assert that the parent account is not in DELETION_PENDING status\n */\nasync function assertNotDeletionPending(ctx: any) {\n  if (!ctx.viewer) {\n    throw new TRPCError({ code: 'UNAUTHORIZED', message: 'Authentication required.' });\n  }\n\n  const parent = await ctx.prisma.parent.findUnique({\n    where: { supabaseUserId: ctx.viewer.id },\n    select: {\n      id: true,\n      email: true,\n      status: true,\n    },\n  });\n\n  if (!parent) {\n    throw new TRPCError({\n      code: 'NOT_FOUND',\n      message: 'Parent profile not found.',\n    });\n  }\n\n  if (parent.status === 'DELETION_PENDING') {\n    throw new TRPCError({\n      code: 'FORBIDDEN',\n      message:\n        'Your account is scheduled for deletion. Please cancel the deletion request to continue using the service.',\n      cause: {\n        reason: 'ACCOUNT_DELETION_PENDING',\n        action: 'cancel_deletion',\n      },\n    });\n  }\n\n  return parent;\n}\n\n/**\n * Dashboard data select shape for child profiles\n */\nconst childDashboardSelect = {\n  id: true,\n  displayName: true,\n  avatarUrl: true,\n  birthdate: true,\n  createdAt: true,\n  _count: {\n    select: {\n      stories: true,\n      photoDeleteEvents: true,\n    },\n  },\n} as const;\n\nexport const privacyRouter = createTRPCRouter({\n  /**\n   * Get privacy dashboard data including child profiles, storage usage,\n   * and pending export/deletion requests\n   */\n  dashboard: protectedProcedure.query(async ({ ctx }) => {\n    const parent = await assertNotDeletionPending(ctx);\n\n    // Parallelize all independent queries for better performance\n    const [children, exportRequests, deletionRequest, totalStories, totalPhotoUploads] =\n      await Promise.all([\n        // Fetch child profiles with aggregated data\n        ctx.prisma.childProfile.findMany({\n          where: {\n            parentId: parent.id,\n          },\n          select: childDashboardSelect,\n          orderBy: { createdAt: 'desc' },\n        }),\n\n        // Fetch recent export requests (last 5)\n        ctx.prisma.dataExportRequest.findMany({\n          where: {\n            parentId: parent.id,\n          },\n          select: {\n            id: true,\n            status: true,\n            deliveryEmail: true,\n            downloadUrl: true,\n            expiresAt: true,\n            failureReason: true,\n            createdAt: true,\n            completedAt: true,\n          },\n          orderBy: { createdAt: 'desc' },\n          take: 5,\n        }),\n\n        // Fetch active deletion request if any\n        ctx.prisma.accountDeletionRequest.findFirst({\n          where: {\n            parentId: parent.id,\n            status: {\n              in: ['PENDING', 'CONFIRMED'],\n            },\n          },\n          select: {\n            id: true,\n            status: true,\n            graceEndsAt: true,\n            confirmedAt: true,\n            createdAt: true,\n          },\n          orderBy: { createdAt: 'desc' },\n        }),\n\n        // Calculate total stories count\n        ctx.prisma.story.count({\n          where: { parentId: parent.id },\n        }),\n\n        // Calculate total photo uploads count\n        ctx.prisma.photoDeletionAudit.count({\n          where: { parentId: parent.id },\n        }),\n      ]);\n\n    return {\n      children: children.map((child) => ({\n        id: child.id,\n        displayName: child.displayName,\n        avatarUrl: child.avatarUrl,\n        birthdate: child.birthdate,\n        createdAt: child.createdAt,\n        storyCount: child._count.stories,\n        photoUploadCount: child._count.photoDeleteEvents,\n      })),\n      exportRequests,\n      deletionRequest,\n      summary: {\n        totalChildren: children.length,\n        totalStories,\n        totalPhotoUploads,\n      },\n    };\n  }),\n\n  /**\n   * Request a data export\n   * Creates a DataExportRequest and enqueues a background job to package the data\n   */\n  requestExport: protectedProcedure\n    .input(privacySchemas.requestExportInput)\n    .mutation(async ({ ctx, input }) => {\n      const parent = await assertNotDeletionPending(ctx);\n      const ipAddress = extractIpAddress(ctx.requestHeaders);\n\n      // Check for recent pending exports (rate limiting)\n      const recentPendingExport = await ctx.prisma.dataExportRequest.findFirst({\n        where: {\n          parentId: parent.id,\n          status: {\n            in: ['PENDING', 'PROCESSING'],\n          },\n          createdAt: {\n            gte: new Date(Date.now() - 24 * 60 * 60 * 1000), // Last 24 hours\n          },\n        },\n      });\n\n      if (recentPendingExport) {\n        throw new TRPCError({\n          code: 'TOO_MANY_REQUESTS',\n          message: 'You already have a pending export request. Please wait for it to complete.',\n          cause: {\n            requestId: recentPendingExport.id,\n          },\n        });\n      }\n\n      // Create export request\n      const exportRequest = await ctx.prisma.dataExportRequest.create({\n        data: {\n          parentId: parent.id,\n          status: 'PENDING',\n          deliveryEmail: input.emailOverride ?? parent.email ?? '',\n        },\n      });\n\n      // Create audit log\n      await createAuditLog(ctx.prisma, {\n        action: 'data_export_requested',\n        actorParentId: parent.id,\n","exit_code":0,"status":"completed"}}
