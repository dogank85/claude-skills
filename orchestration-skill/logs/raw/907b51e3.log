         email_hash: emailHash,\n              supabase_message_id: input.supabaseMessageId ?? null,\n              details: input.details ?? {},\n            },\n          },\n        });\n      }\n\n      return {\n        id: event.id,\n        status: event.status,\n        recordedAt: event.createdAt.toISOString(),\n      };\n    }),\n});\n\nfunction assertWebhookAuthorized(headers: Headers | null, secret?: string) {\n  if (!secret) {\n    throw new TRPCError({\n      code: 'INTERNAL_SERVER_ERROR',\n      message: 'Webhook secret missing from environment.',\n    });\n  }\n\n  if (!headers) {\n    throw new TRPCError({\n      code: 'UNAUTHORIZED',\n      message: 'Missing request headers.',\n    });\n  }\n\n  const provided =\n    headers.get('x-herokid-webhook-secret') ??\n    headers.get('x-supabase-signature') ??\n    headers.get('authorization');\n\n  if (!provided) {\n    throw new TRPCError({\n      code: 'UNAUTHORIZED',\n      message: 'Missing webhook authentication header.',\n    });\n  }\n\n  const normalized = provided.split(' ').pop();\n\n  if (!normalized || !safeCompare(normalized, secret)) {\n    throw new TRPCError({ code: 'UNAUTHORIZED', message: 'Invalid webhook signature.' });\n  }\n}\n\nfunction safeCompare(a: string, b: string) {\n  const left = Buffer.from(a);\n  const right = Buffer.from(b);\n\n  if (left.length !== right.length) {\n    return false;\n  }\n\n  return timingSafeEqual(left, right);\n}\n","exit_code":0,"status":"completed"}}
