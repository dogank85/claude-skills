{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/routers/library.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Library Router - Epic 5: Story Library & Reading Experience\n *\n * Handles:\n * - Story 5.1: Personal Story Library API (list/get stories)\n * - Story 5.4: Reading Progress Tracking (updateProgress)\n * - Story 5.6: Story Favoriting (toggleFavorite)\n * - Story 5.8: Re-read Tracking & Engagement Stats (getUsageStats)\n */\n\nimport { TRPCError } from '@trpc/server';\nimport { z } from 'zod';\nimport { createTRPCRouter, protectedProcedure } from '../trpc';\nimport type { Context } from '../context';\nimport type { Prisma } from '@prisma/client';\nimport {\n  listStoriesSchema,\n  getStorySchema,\n  toggleFavoriteSchema,\n  updateProgressSchema,\n} from '@herokid/validators/story';\nimport {\n  getUsageStatsSchema,\n} from '@herokid/validators/library';\n\n// ========================================\n// HELPER FUNCTIONS\n// ========================================\n\n/**\n * Verify that the authenticated parent owns the child profile\n */\nasync function verifyChildOwnership(\n  ctx: Context,\n  childProfileId: string\n): Promise<void> {\n  if (!ctx.viewer) {\n    throw new TRPCError({ code: 'UNAUTHORIZED', message: 'Authentication required.' });\n  }\n\n  const parent = await ctx.prisma.parent.findUnique({\n    where: { supabaseUserId: ctx.viewer.id },\n    include: { children: { select: { id: true } } }\n  });\n\n  if (!parent) {\n    throw new TRPCError({ code: 'NOT_FOUND', message: 'Parent not found.' });\n  }\n\n  const ownsChild = parent.children.some(child => child.id === childProfileId);\n  if (!ownsChild) {\n    throw new TRPCError({ code: 'FORBIDDEN', message: 'Access denied.' });\n  }\n}\n\n/**\n * Verify that the authenticated parent owns the story (via child profile)\n */\nasync function verifyStoryOwnership(\n  ctx: Context,\n  storyId: string\n): Promise<{ childProfileId: string }> {\n  if (!ctx.viewer) {\n    throw new TRPCError({ code: 'UNAUTHORIZED', message: 'Authentication required.' });\n  }\n\n  const parent = await ctx.prisma.parent.findUnique({\n    where: { supabaseUserId: ctx.viewer.id },\n    select: { id: true },\n  });\n\n  if (!parent) {\n    throw new TRPCError({ code: 'NOT_FOUND', message: 'Parent account not found' });\n  }\n\n  const story = await ctx.prisma.story.findUnique({\n    where: { id: storyId },\n    select: {\n      id: true,\n      childProfileId: true,\n      childProfile: {\n        select: {\n          id: true,\n          parentId: true,\n        },\n      },\n    },\n  });\n\n  if (!story) {\n    throw new TRPCError({ code: 'NOT_FOUND', message: 'Story not found.' });\n  }\n\n  if (!story.childProfile || story.childProfile.parentId !== parent.id) {\n    throw new TRPCError({ code: 'FORBIDDEN', message: 'You do not have access to this story.' });\n  }\n\n  return { childProfileId: story.childProfile.id };\n}\n\n/**\n * Get sort order configuration based on sortBy parameter\n */\nfunction getOrderBy(sortBy: string): Prisma.StoryOrderByWithRelationInput {\n  switch (sortBy) {\n    case 'recent':\n      return { createdAt: 'desc' };\n    case 'oldest':\n      return { createdAt: 'asc' };\n    case 'favorites':\n      return { metadata: { favorited: 'desc' } };\n    case 'adventure_type':\n      return { adventureType: 'asc' };\n    default:\n      return { createdAt: 'desc' };\n  }\n}\n\n// ========================================\n// ROUTER\n// ========================================\n\nexport const libraryRouter = createTRPCRouter({\n  /**\n   * List Stories - Get paginated list of stories for a child profile\n   * Epic 5: Story 5.1 - AC2: Paginated story list per child with filters/sorting\n   */\n  listStories: protectedProcedure\n    .input(listStoriesSchema)\n    .query(async ({ input, ctx }) => {\n      // Verify parent owns child profile\n      await verifyChildOwnership(ctx, input.childProfileId);\n\n      // Build where clause with filters\n      const where: Prisma.StoryWhereInput = {\n        childProfileId: input.childProfileId,\n        ...(input.filterBy?.favorited && {\n          metadata: { favorited: true },\n        }),\n        ...(input.filterBy?.completed && {\n          progress: { some: { completed: true } },\n        }),\n        ...(input.filterBy?.adventureType && {\n          adventureType: input.filterBy.adventureType,\n        }),\n      };\n\n      const orderBy = getOrderBy(input.sortBy);\n\n      // Execute parallel queries for stories and total count\n      const [stories, totalCount] = await Promise.all([\n        ctx.prisma.story.findMany({\n          where,\n          include: {\n            images: {\n              where: { sceneNumber: 1 }, // Cover image only\n              select: { publicUrl: true },\n            },\n            metadata: {\n              select: {\n                favorited: true,\n                readCount: true,\n                lastReadAt: true,\n              },\n            },\n            progress: {\n              where: { childProfileId: input.childProfileId },\n              select: { completed: true },\n            },\n          },\n          orderBy,\n          skip: input.offset,\n          take: input.limit,\n        }),\n        ctx.prisma.story.count({ where }),\n      ]);\n\n      // Transform stories to list format\n      const mappedStories = stories.map(story => ({\n        id: story.id,\n        title: story.title,\n        adventureType: story.adventureType as 'superhero_rescue' | 'treasure_hunt' | 'magic_training',\n        artStyle: story.artStyle as 'pixar' | '2d' | 'anime' | 'watercolor',\n        coverImageUrl: story.images[0]?.publicUrl || '',\n        createdAt: story.createdAt,\n        favorited: story.metadata?.favorited || false,\n        completed: story.progress[0]?.completed || false,\n        readCount: story.metadata?.readCount || 0,\n        lastReadAt: story.metadata?.lastReadAt || undefined,\n      }));\n\n      return {\n        stories: mappedStories,\n        totalCount,\n        hasMore: input.offset + input.limit < totalCount,\n      };\n    }),\n\n  /**\n   * Get Story - Retrieve complete story with all scenes and images\n","exit_code":0,"status":"completed"}}
