      });\n      return;\n    }\n\n    if (existing.attempts >= config.limit) {\n      const retryAfterSeconds = Math.max(\n        1,\n        Math.ceil((existing.windowExpiresAt.getTime() - now.getTime()) / 1000)\n      );\n      throw new TRPCError({\n        code: 'TOO_MANY_REQUESTS',\n        message: `Too many attempts. Please try again in ${Math.ceil(retryAfterSeconds / 60)} minutes.`,\n      });\n    }\n\n    await tx.authRateLimit.update({\n      where: { key: config.key },\n      data: {\n        attempts: { increment: 1 },\n        lastAttemptAt: now,\n        metadata: (config.metadata ?? existing.metadata ?? Prisma.JsonNull) as any,\n        category: config.category,\n      },\n    });\n  });\n}\n\nexport async function checkPasswordResetRateLimit(\n  prisma: PrismaClient,\n  email: string,\n  ip?: string\n): Promise<void> {\n  const normalizedEmail = email.toLowerCase();\n\n  await hitRateLimit(prisma, {\n    key: `password_reset:email:${normalizedEmail}`,\n    limit: 3,\n    windowSeconds: 30 * 60,\n    category: 'password_reset_email',\n    metadata: { email },\n  });\n\n  if (ip) {\n    await hitRateLimit(prisma, {\n      key: `password_reset:ip:${ip}`,\n      limit: 10,\n      windowSeconds: 60 * 60,\n      category: 'password_reset_ip',\n      metadata: { ip },\n    });\n  }\n}\n","exit_code":0,"status":"completed"}}
