{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/routers/library.test.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Library Router Tests - Epic 5 Story 5.8: Re-read Tracking & Engagement Usage\n *\n * Tests for:\n * - AC1: Re-read detection logic (first read vs re-read)\n * - AC2: Usage statistics API (legacy subscription fields retained for analytics)\n * - AC3: Re-reads don't consume credits or hit legacy limits\n */\n\nimport { describe, it, expect, beforeEach, vi } from 'vitest';\nimport { TRPCError } from '@trpc/server';\nimport type { PrismaClient } from '@prisma/client';\nimport type { SupabaseClient } from '@supabase/supabase-js';\nimport { libraryRouter } from './library';\nimport type { Context } from '../context';\n\n// Mock Prisma client\nconst createMockPrisma = () => {\n  const mockPrisma = {\n    parent: {\n      findUnique: vi.fn(),\n    },\n    childProfile: {\n      findUnique: vi.fn(),\n    },\n    story: {\n      findUnique: vi.fn(),\n      count: vi.fn(),\n    },\n    storyProgress: {\n      findUnique: vi.fn(),\n      upsert: vi.fn(),\n      count: vi.fn(),\n      aggregate: vi.fn(),\n    },\n    storyMetadata: {\n      upsert: vi.fn(),\n      count: vi.fn(),\n    },\n    $transaction: vi.fn((callback) => callback(mockPrisma)),\n  } as unknown as PrismaClient;\n\n  return mockPrisma;\n};\n\n// Mock Supabase client\nconst createMockSupabase = () => {\n  return {\n    auth: {\n      getUser: vi.fn(),\n    },\n  } as unknown as SupabaseClient;\n};\n\n// Helper to create test context\nconst createTestContext = (overrides?: {\n  prisma?: PrismaClient;\n  supabase?: SupabaseClient | null;\n  viewer?: { id: string; email?: string } | null;\n}) => {\n  const hasSupabaseOverride = overrides && Object.prototype.hasOwnProperty.call(overrides, 'supabase');\n  const hasViewerOverride = overrides && Object.prototype.hasOwnProperty.call(overrides, 'viewer');\n\n  return {\n    prisma: overrides?.prisma ?? createMockPrisma(),\n    supabase: hasSupabaseOverride ? overrides!.supabase ?? null : createMockSupabase(),\n    viewer: hasViewerOverride ? overrides!.viewer ?? null : { id: 'test-viewer-id', email: 'test@example.com' },\n    requestHeaders: new Headers(),\n    env: {\n      commitSha: 'test-sha',\n      apiVersion: 'test',\n      runtimeEnv: 'test',\n      supabaseConfigured: true,\n      supabaseUrl: 'https://test.supabase.co',\n      supabaseServiceRoleKey: 'test-key',\n      adminEmails: [],\n    },\n    admin: null,\n  };\n};\n\ndescribe('libraryRouter.updateProgress', () => {\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it('AC1: should mark story as completed on first completion and set reReadCount to 0', async () => {\n    const mockPrisma = createMockPrisma();\n    const ctx = createTestContext({ prisma: mockPrisma });\n\n    const storyId = 'story-123';\n    const childProfileId = 'child-123';\n    const parentId = 'parent-123';\n\n    // Mock story lookup\n    vi.mocked(mockPrisma.story.findUnique).mockResolvedValue({\n      id: storyId,\n      childProfileId,\n      childProfile: {\n        id: childProfileId,\n        parentId,\n      },\n    } as any);\n\n    // Mock parent lookup\n    vi.mocked(mockPrisma.parent.findUnique).mockResolvedValue({\n      id: parentId,\n      supabaseUserId: 'test-viewer-id',\n    } as any);\n\n    // Mock existing progress (story not yet completed)\n    vi.mocked(mockPrisma.storyProgress.findUnique).mockResolvedValue(null);\n\n    // Mock upsert result\n    vi.mocked(mockPrisma.storyProgress.upsert).mockResolvedValue({\n      id: 'progress-123',\n      storyId,\n      childProfileId,\n      currentScene: 6,\n      farthestScene: 6,\n      completed: true,\n      completedAt: new Date(),\n      readTimeSeconds: 300,\n      reReadCount: 0,\n    } as any);\n\n    vi.mocked(mockPrisma.storyMetadata.upsert).mockResolvedValue({} as any);\n\n    const caller = libraryRouter.createCaller(ctx);\n    const result = await caller.updateProgress({\n      storyId,\n      currentScene: 6,\n      completed: true,\n      readTimeSeconds: 300,\n    });\n\n    expect(result.success).toBe(true);\n    expect(result.completed).toBe(true);\n    expect(result.isReRead).toBe(false); // First completion, not a re-read\n    expect(result.currentScene).toBe(6);\n    expect(result.farthestScene).toBe(6);\n\n    // Verify upsert was called with correct data\n    expect(mockPrisma.storyProgress.upsert).toHaveBeenCalledWith(\n      expect.objectContaining({\n        create: expect.objectContaining({\n          reReadCount: 0,\n          completed: true,\n        }),\n      })\n    );\n  });\n\n  it('AC1: should detect re-read and increment reReadCount when completing already-completed story', async () => {\n    const mockPrisma = createMockPrisma();\n    const ctx = createTestContext({ prisma: mockPrisma });\n\n    const storyId = 'story-123';\n    const childProfileId = 'child-123';\n    const parentId = 'parent-123';\n\n    // Mock story lookup\n    vi.mocked(mockPrisma.story.findUnique).mockResolvedValue({\n      id: storyId,\n      childProfileId,\n      childProfile: {\n        id: childProfileId,\n        parentId,\n      },\n    } as any);\n\n    // Mock parent lookup\n    vi.mocked(mockPrisma.parent.findUnique).mockResolvedValue({\n      id: parentId,\n      supabaseUserId: 'test-viewer-id',\n    } as any);\n\n    // Mock existing progress (story already completed with reReadCount of 2)\n    const existingProgress = {\n      id: 'progress-123',\n      storyId,\n      childProfileId,\n      currentScene: 6,\n      farthestScene: 6,\n      completed: true, // Already completed\n      completedAt: new Date('2024-01-01'),\n      readTimeSeconds: 600,\n      reReadCount: 2, // Already re-read twice\n    };\n\n    vi.mocked(mockPrisma.storyProgress.findUnique).mockResolvedValue(existingProgress as any);\n\n    // Mock upsert result (reReadCount should be incremented)\n    vi.mocked(mockPrisma.storyProgress.upsert).mockResolvedValue({\n      ...existingProgress,\n      reReadCount: 3, // Incremented\n      readTimeSeconds: 900, // Added 300 seconds\n    } as any);\n\n    vi.mocked(mockPrisma.storyMetadata.upsert).mockResolvedValue({} as any);\n","exit_code":0,"status":"completed"}}
