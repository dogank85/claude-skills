{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '380,520p' packages/ai/src/imagen/client.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n\n          return {\n            imageBuffer,\n            cost: this.costPerImage,\n            generationTime,\n            safetyScores: this.extractSafetyScores(candidate),\n          };\n        } catch (error) {\n          const errorMessage = error instanceof Error ? error.message : String(error);\n\n          if (errorMessage.includes('quota') || errorMessage.includes('rate limit')) {\n            throw createRetryableError('API quota exceeded, retrying...', error as Error);\n          }\n\n          if (\n            errorMessage.includes('503') ||\n            errorMessage.includes('unavailable') ||\n            errorMessage.includes('timeout')\n          ) {\n            throw createRetryableError('Service temporarily unavailable', error as Error);\n          }\n\n          if (errorMessage.includes('400') || errorMessage.includes('invalid')) {\n            throw createNonRetryableError('Invalid request parameters', error as Error);\n          }\n\n          throw error;\n        }\n      },\n      {\n        maxRetries: 3,\n        initialDelayMs: 1000,\n      }\n    );\n  }\n\n  /**\n   * Build pet-specific prompt combining pet type and personality\n   *\n   * @param petType - Type of pet (dog, cat, other)\n   * @param personality - Optional personality trait\n   * @returns Prompt string for pet generation\n   */\n  private buildPetPrompt(petType: PetType, personality?: PetPersonality): string {\n    const basePrompts: Record<PetType, string> = {\n      dog: 'Loyal magical dog companion',\n      cat: 'Mystical wise cat companion',\n      other: 'Enchanted animal companion',\n    };\n\n    const personalityPrompts: Record<PetPersonality, string> = {\n      brave: 'courageous and heroic',\n      wise: 'intelligent and knowing',\n      playful: 'energetic and fun-loving',\n      protective: 'guardian and defender',\n    };\n\n    let prompt = basePrompts[petType];\n\n    if (personality) {\n      prompt += `, ${personalityPrompts[personality]}`;\n    }\n\n    return prompt;\n  }\n\n  /**\n   * Extract safety scores from generation response\n   *\n   * @param candidate - Response candidate containing safety ratings\n   * @returns Safety scores object or undefined\n   */\n  private extractSafetyScores(candidate: any): GenerateImageResponse['safetyScores'] {\n    if (!candidate.safetyRatings) {\n      return undefined;\n    }\n\n    const ratings = candidate.safetyRatings;\n    return {\n      adult: this.mapSafetyRating(ratings.find((r: any) => r.category === 'HARM_CATEGORY_SEXUALLY_EXPLICIT')?.probability),\n      violence: this.mapSafetyRating(ratings.find((r: any) => r.category === 'HARM_CATEGORY_DANGEROUS_CONTENT')?.probability),\n      racy: this.mapSafetyRating(ratings.find((r: any) => r.category === 'HARM_CATEGORY_HARASSMENT')?.probability),\n    };\n  }\n\n  /**\n   * Map safety rating probability to numeric score (0-1)\n   *\n   * @param probability - String probability from API\n   * @returns Numeric score between 0 and 1\n   */\n  private mapSafetyRating(probability?: string): number {\n    const mapping: Record<string, number> = {\n      NEGLIGIBLE: 0.1,\n      LOW: 0.3,\n      MEDIUM: 0.6,\n      HIGH: 0.9,\n    };\n\n    return mapping[probability || 'NEGLIGIBLE'] || 0.1;\n  }\n}\n\n/**\n * Singleton instance for convenience\n * Initialize with environment variables\n */\nlet _clientInstance: NanoBananaClient | null = null;\n\nexport function getNanoBananaClient(): NanoBananaClient {\n  if (!_clientInstance) {\n    const projectId = process.env.GOOGLE_CLOUD_PROJECT;\n    if (!projectId) {\n      throw new Error('GOOGLE_CLOUD_PROJECT environment variable is required');\n    }\n\n    _clientInstance = new NanoBananaClient({ projectId });\n  }\n\n  return _clientInstance;\n}\n\n/**\n * Export singleton instance\n */\nexport const nanoBananaClient = getNanoBananaClient();\n","exit_code":0,"status":"completed"}}
