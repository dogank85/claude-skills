didate.content.parts[0];\n          const imageBuffer = Buffer.from(\n            (imagePart as any).inlineData?.data || '',\n            'base64'\n          );\n\n          if (imageBuffer.length === 0) {\n            throw createNonRetryableError('Empty image buffer received');\n          }\n\n","exit_code":0,"status":"completed"}}
