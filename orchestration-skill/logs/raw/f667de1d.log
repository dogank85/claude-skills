tive.' });\n  }\n\n  if (parent.role !== 'ADMIN') {\n    throw new TRPCError({ code: 'FORBIDDEN', message: 'Admin access required.' });\n  }\n\n  return next({\n    ctx: {\n      ...ctx,\n      admin: {\n        parentId: parent.id,\n        email: parent.email,\n        role: parent.role,\n      },\n    },\n  });\n});\n\nexport const adminProcedure = t.procedure.use(enforceAdmin);\n","exit_code":0,"status":"completed"}}
