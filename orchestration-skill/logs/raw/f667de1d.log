{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,520p' packages/api/src/routers/story.integration.test.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n    expect(story.wordCount).toBeGreaterThan(0);\n    expect(story.metadata.generationTimeMs).toBeLessThan(35000);\n\n    // Verify all scenes have images\n    story.scenes.forEach((scene: any) => {\n      expect(scene.sceneNumber).toBeGreaterThan(0);\n      expect(scene.text).toBeDefined();\n      expect(scene.imageUrl).toBeDefined();\n    });\n  });\n\n  it('should enforce credit balance requirements', async () => {\n    // TODO: Implement when credit balance enforcement is added (Story 4.8 credit gating)\n    // This test should verify that generation is blocked when balance is insufficient\n    expect(true).toBe(true);\n  });\n\n  it('should block generation if avatars not created', async () => {\n    // Create a child without avatars\n    const childWithoutAvatars = await prisma.childProfile.create({\n      data: {\n        parentId: testParentId,\n        name: 'Child Without Avatars',\n        birthMonth: 3,\n        birthYear: 2019,\n        ageGroup: 'FIVE_TO_SEVEN',\n        avatarsGenerated: false,\n      },\n    });\n\n    await expect(\n      caller.story.generateStory({\n        childProfileId: childWithoutAvatars.id,\n        adventureTemplate: 'treasure_hunt',\n        includePet: false,\n      })\n    ).rejects.toThrow('Please create avatars first');\n\n    // Cleanup\n    await prisma.childProfile.delete({\n      where: { id: childWithoutAvatars.id },\n    });\n  });\n\n  it('should block generation if pet requested but not created', async () => {\n    // Create a child with avatars but no pet\n    const childWithoutPet = await prisma.childProfile.create({\n      data: {\n        parentId: testParentId,\n        name: 'Child Without Pet',\n        birthMonth: 9,\n        birthYear: 2017,\n        ageGroup: 'EIGHT_TO_TEN',\n        avatarsGenerated: true,\n        avatarsGeneratedAt: new Date(),\n      },\n    });\n\n    // Create avatars\n    await prisma.avatar.create({\n      data: {\n        childProfileId: childWithoutPet.id,\n        artStyle: ArtStyle.PIXAR,\n        poseType: PoseType.FULL_BODY,\n        storagePath: `avatars/${childWithoutPet.id}/pixar_full_body.png`,\n        publicUrl: `https://storage.example.com/avatars/${childWithoutPet.id}/pixar_full_body.png`,\n        generationCost: 0.039,\n      },\n    });\n\n    await expect(\n      caller.story.generateStory({\n        childProfileId: childWithoutPet.id,\n        adventureTemplate: 'magic_training',\n        includePet: true, // Requesting pet but none exists\n      })\n    ).rejects.toThrow('Please create a pet companion first');\n\n    // Cleanup\n    await prisma.avatar.deleteMany({\n      where: { childProfileId: childWithoutPet.id },\n    });\n    await prisma.childProfile.delete({\n      where: { id: childWithoutPet.id },\n    });\n  });\n\n  it('should list stories for a child profile', async () => {\n    // Create a test story directly\n    const story = await prisma.story.create({\n      data: {\n        parentId: testParentId,\n        childProfileId: testChildId,\n        title: 'Test Story for Listing',\n        content: JSON.stringify({ scenes: [] }),\n        adventureType: 'treasure_hunt',\n        artStyle: 'pixar',\n        includedPet: false,\n        ageGroup: '8-10',\n        wordCount: 500,\n        generationCost: 0.235,\n        status: 'READY',\n      },\n    });\n\n    const stories = await caller.story.listStories({\n      childProfileId: testChildId,\n      sortBy: 'recent',\n      limit: 10,\n      offset: 0,\n    });\n\n    expect(stories.stories.length).toBeGreaterThan(0);\n    expect(stories.totalCount).toBeGreaterThan(0);\n\n    const foundStory = stories.stories.find(s => s.id === story.id);\n    expect(foundStory).toBeDefined();\n    expect(foundStory?.title).toBe('Test Story for Listing');\n    expect(foundStory?.adventureType).toBe('treasure_hunt');\n\n    // Cleanup\n    await prisma.story.delete({\n      where: { id: story.id },\n    });\n  });\n\n  it('should track generation cost accurately', async () => {\n    const result = await caller.story.generateStory({\n      childProfileId: testChildId,\n      adventureTemplate: 'treasure_hunt',\n      includePet: false,\n      artStyle: '2d',\n    });\n\n    // Wait for generation to complete\n    let status;\n    do {\n      await new Promise(resolve => setTimeout(resolve, 2000));\n      status = await caller.story.getGenerationStatus({\n        generationId: result.generationId,\n      });\n    } while (status.status !== 'COMPLETE' && status.status !== 'FAILED');\n\n    expect(status.status).toBe('COMPLETE');\n\n    const story = await caller.story.getStory({\n      storyId: status.storyId!,\n    });\n\n    // Verify cost calculation\n    // Text cost (~$0.001) + 6 images ($0.039 each) = ~$0.235\n    expect(story.metadata.generationCost).toBeGreaterThan(0.2);\n    expect(story.metadata.generationCost).toBeLessThan(0.3);\n * Story Router Integration Tests (Story 4.5)\n *\n * End-to-end tests for content safety pipeline and parent reporting workflow\n */\n\nimport { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport { inferProcedureInput } from '@trpc/server';\nimport type { AppRouter } from '../root';\nimport { createInnerTRPCContext } from '../context';\nimport { appRouter } from '../root';\nimport type { PrismaClient } from '@prisma/client';\n\n// Test fixtures\nconst mockParent = {\n  id: '00000000-0000-0000-0000-000000000001',\n  supabaseUserId: '00000000-0000-0000-0000-000000000101',\n  email: 'parent@example.com',\n  status: 'ACTIVE' as const,\n};\n\nconst mockChild = {\n  id: '00000000-0000-0000-0000-000000000002',\n  name: 'Test Child',\n  parentId: mockParent.id,\n  birthYear: 2017,\n  birthMonth: 6,\n  ageGroup: 'FIVE_TO_SEVEN' as const,\n};\n\nconst mockStory = {\n  id: '00000000-0000-0000-0000-000000000003',\n  parentId: mockParent.id,\n  childProfileId: mockChild.id,\n  title: 'Test Story',\n  content: 'This is a test story about a hero saving the day.',\n  status: 'PUBLISHED' as const,\n};\n\ndescribe('Story Router - Content Safety Pipeline', () => {\n  let ctx: ReturnType<typeof createInnerTRPCContext>;\n  let caller: ReturnType<typeof appRouter.createCaller>;\n\n  beforeEach(async () => {\n    // Create test context with authenticated viewer\n    ctx = createInnerTRPCContext({\n      viewer: {\n        id: mockParent.supabaseUserId,\n        role: 'authenticated',\n        aud: 'authenticated',\n      },\n    });\n\n    caller = appRouter.createCaller(ctx);\n\n    // Set up test data\n    await ctx.prisma.parent.create({\n      data: mockParent,\n    });\n\n    await ctx.prisma.childProfile.create({\n      data: mockChild,\n    });\n\n    await ctx.prisma.story.create({\n      data: mockStory,\n    });\n  });\n\n  afterEach(async () => {\n    // Clean up test data\n    await ctx.prisma.storySafetyIncident.deleteMany({});\n    await ctx.prisma.storyMetadata.deleteMany({});\n    await ctx.prisma.auditLog.deleteMany({});\n    await ctx.prisma.story.deleteMany({});\n    await ctx.prisma.childProfile.deleteMany({});\n    await ctx.prisma.parent.deleteMany({});\n  });\n\n  describe('reportInappropriate', () => {\n    it('should successfully report inappropriate content', async () => {\n      const input: inferProcedureInput<AppRouter['story']['reportInappropriate']> = {\n        storyId: mockStory.id,\n        reason: 'Contains inappropriate language',\n        details: 'Found several concerning words in scene 3.',\n      };\n\n      const result = await caller.story.reportInappropriate(input);\n\n      expect(result.success).toBe(true);\n      expect(result.ticketId).toBeDefined();\n      expect(result.message).toContain('24 hours');\n    });\n\n    it('should create safety incident record', async () => {\n      const input: inferProcedureInput<AppRouter['story']['reportInappropriate']> = {\n        storyId: mockStory.id,\n        reason: 'Inappropriate content',\n      };\n\n      await caller.story.reportInappropriate(input);\n\n      const incidents = await ctx.prisma.storySafetyIncident.findMany({\n        where: { storyId: mockStory.id },\n      });\n\n      expect(incidents).toHaveLength(1);\n      expect(incidents[0].issueType).toBe('PARENT_REPORTED');\n      expect(incidents[0].resolution).toBe('MANUAL_REVIEW');\n      expect(incidents[0].reviewedBy).toBe(mockParent.id);\n    });\n\n    it('should flag story in metadata', async () => {\n      const input: inferProcedureInput<AppRouter['story']['reportInappropriate']> = {\n        storyId: mockStory.id,\n        reason: 'Inappropriate theme',\n      };\n\n      await caller.story.reportInappropriate(input);\n\n      const metadata = await ctx.prisma.storyMetadata.findUnique({\n        where: { storyId: mockStory.id },\n      });\n\n      expect(metadata).toBeDefined();\n      expect(metadata?.flagged).toBe(true);\n      expect(metadata?.flagReason).toBe('Inappropriate theme');\n    });\n\n    it('should create audit log entry', async () => {\n      const input: inferProcedureInput<AppRouter['story']['reportInappropriate']> = {\n        storyId: mockStory.id,\n        reason: 'Safety concern',\n        details: 'Detailed explanation here.',\n      };\n\n      await caller.story.reportInappropriate(input);\n\n      const auditLogs = await ctx.prisma.auditLog.findMany({\n        where: {\n          action: 'REPORT_STORY_INAPPROPRIATE',\n          entityId: mockStory.id,\n        },\n      });\n\n      expect(auditLogs).toHaveLength(1);\n      expect(auditLogs[0].actorParentId).toBe(mockParent.id);\n      expect(auditLogs[0].entityType).toBe('Story');\n    });\n\n    it('should store flagged content details in JSONB', async () => {\n      const input: inferProcedureInput<AppRouter['story']['reportInappropriate']> = {\n        storyId: mockStory.id,\n        reason: 'Contains scary imagery',\n        details: 'Scene 2 has frightening monster.',\n      };\n\n      await caller.story.reportInappropriate(input);\n\n      const incident = await ctx.prisma.storySafetyIncident.findFirst({\n        where: { storyId: mockStory.id },\n      });\n\n      expect(incident).toBeDefined();\n      const flaggedContent = incident?.flaggedContent as any;\n      expect(flaggedContent.reason).toBe('Contains scary imagery');\n      expect(flaggedContent.details).toBe('Scene 2 has frightening monster.');\n      expect(flaggedContent.reportedBy).toBe(mockParent.id);\n    });\n","exit_code":0,"status":"completed"}}
