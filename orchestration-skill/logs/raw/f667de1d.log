At: null,\n      readTimeSeconds: 100,\n      reReadCount: 0,\n    };\n\n    vi.mocked(mockPrisma.storyProgress.findUnique).mockResolvedValue(existingProgress as any);\n\n    // Mock upsert result\n    vi.mocked(mockPrisma.storyProgress.upsert).mockResolvedValue({\n      ...existingProgress,\n      currentScene: 4,\n      farthestScene: 4,\n      readTimeSeconds: 200,\n    } as any);\n\n    vi.mocked(mockPrisma.storyMetadata.upsert).mockResolvedValue({} as any);\n\n    const caller = libraryRouter.createCaller(ctx);\n    const result = await caller.updateProgress({\n      storyId,\n      currentScene: 4,\n      readTimeSeconds: 100,\n    });\n\n    expect(result.success).toBe(true);\n    expect(result.completed).toBe(false);\n    expect(result.isReRead).toBe(false);\n    expect(result.currentScene).toBe(4);\n    expect(result.farthestScene).toBe(4);\n  });\n\n  it('should throw error if story not found', async () => {\n    const mockPrisma = createMockPrisma();\n    const ctx = createTestContext({ prisma: mockPrisma });\n\n    // Mock story not found\n    vi.mocked(mockPrisma.story.findUnique).mockResolvedValue(null);\n\n    const caller = libraryRouter.createCaller(ctx);\n\n    await expect(\n      caller.updateProgress({\n        storyId: 'non-existent-story',\n        currentScene: 3,\n      })\n    ).rejects.toThrow(TRPCError);\n  });\n});\n\ndescribe('libraryRouter.getUsageStats', () => {\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it('AC2 & AC3: should return correct usage stats with re-reads not counting against credit balance', async () => {\n    const mockPrisma = createMockPrisma();\n    const ctx = createTestContext({ prisma: mockPrisma });\n\n    const childProfileId = 'child-123';\n    const parentId = 'parent-123';\n\n    // Mock child profile lookup\n    vi.mocked(mockPrisma.childProfile.findUnique).mockResolvedValue({\n      id: childProfileId,\n      parentId,\n    } as any);\n\n    // Mock parent lookup\n    vi.mocked(mockPrisma.parent.findUnique).mockResolvedValue({\n      id: parentId,\n      supabaseUserId: 'test-viewer-id',\n    } as any);\n\n    // Mock current month: 5 stories generated\n    vi.mocked(mockPrisma.story.count)\n      .mockResolvedValueOnce(5) // Stories generated this month\n      .mockResolvedValueOnce(20); // Total stories\n\n    // Mock completed stories: 15 completed\n    vi.mocked(mockPrisma.storyProgress.count).mockResolvedValue(15);\n\n    // Mock re-read aggregation: total 45 re-reads across all stories\n    vi.mocked(mockPrisma.storyProgress.aggregate).mockResolvedValue({\n      _sum: {\n        reReadCount: 45,\n      },\n    } as any);\n\n    // Mock favorited stories: 8 favorited\n    vi.mocked(mockPrisma.storyMetadata.count).mockResolvedValue(8);\n\n    const caller = libraryRouter.createCaller(ctx);\n    const result = await caller.getUsageStats({\n      childProfileId,\n    });\n\n    // Verify current month usage snapshot (legacy limit placeholder)\n    expect(result.currentMonth.storiesGenerated).toBe(5);\n    expect(result.currentMonth.storiesLimit).toBe(Number.MAX_SAFE_INTEGER); // No monthly cap in credit model\n    expect(result.currentMonth.storiesRemaining).toBe(Number.MAX_SAFE_INTEGER);\n    expect(result.currentMonth.resetDate).toBeInstanceOf(Date);\n\n    // Verify engagement metrics\n    expect(result.engagement.totalStories).toBe(20);\n    expect(result.engagement.completedStories).toBe(15);\n    expect(result.engagement.completionRate).toBe(75); // 15/20 = 75%\n    expect(result.engagement.totalReReads).toBe(45);\n    expect(result.engagement.avgReReadsPerStory).toBe(2.25); // 45/20 = 2.25\n    expect(result.engagement.favoritedStories).toBe(8);\n  });\n\n  it('AC5: should calculate correct engagement metrics for parent analytics', async () => {\n    const mockPrisma = createMockPrisma();\n    const ctx = createTestContext({ prisma: mockPrisma });\n\n    const childProfileId = 'child-123';\n    const parentId = 'parent-123';\n\n    // Mock child profile lookup\n    vi.mocked(mockPrisma.childProfile.findUnique).mockResolvedValue({\n      id: childProfileId,\n      parentId,\n    } as any);\n\n    // Mock parent lookup\n    vi.mocked(mockPrisma.parent.findUnique).mockResolvedValue({\n      id: parentId,\n      supabaseUserId: 'test-viewer-id',\n    } as any);\n\n    // Scenario: 10 stories generated this month, 50 total stories\n    vi.mocked(mockPrisma.story.count)\n      .mockResolvedValueOnce(10) // Stories generated this month\n      .mockResolvedValueOnce(50); // Total stories\n\n    // Mock completed stories: 42 completed\n    vi.mocked(mockPrisma.storyProgress.count).mockResolvedValue(42);\n\n    // Mock re-read aggregation: total 150 re-reads across all stories\n    vi.mocked(mockPrisma.storyProgress.aggregate).mockResolvedValue({\n      _sum: {\n        reReadCount: 150,\n      },\n    } as any);\n\n    // Mock favorited stories: 15 favorited\n    vi.mocked(mockPrisma.storyMetadata.count).mockResolvedValue(15);\n\n    const caller = libraryRouter.createCaller(ctx);\n    const result = await caller.getUsageStats({\n      childProfileId,\n    });\n\n    // Verify parent can see that child loves re-reading stories\n    expect(result.engagement.totalReReads).toBe(150);\n    expect(result.engagement.avgReReadsPerStory).toBe(3); // 150/50 = 3 re-reads per story on average\n    expect(result.engagement.completionRate).toBe(84); // 42/50 = 84%\n\n    // This data can be used to show: \"Emma loves re-reading stories 3x on average!\"\n  });\n\n  it('should handle edge case with no stories', async () => {\n    const mockPrisma = createMockPrisma();\n    const ctx = createTestContext({ prisma: mockPrisma });\n\n    const childProfileId = 'child-123';\n    const parentId = 'parent-123';\n\n    // Mock child profile lookup\n    vi.mocked(mockPrisma.childProfile.findUnique).mockResolvedValue({\n      id: childProfileId,\n      parentId,\n    } as any);\n\n    // Mock parent lookup\n    vi.mocked(mockPrisma.parent.findUnique).mockResolvedValue({\n      id: parentId,\n      supabaseUserId: 'test-viewer-id',\n    } as any);\n\n    // Mock no stories\n    vi.mocked(mockPrisma.story.count).mockResolvedValue(0);\n    vi.mocked(mockPrisma.storyProgress.count).mockResolvedValue(0);\n    vi.mocked(mockPrisma.storyProgress.aggregate).mockResolvedValue({\n      _sum: {\n        reReadCount: 0,\n      },\n    } as any);\n    vi.mocked(mockPrisma.storyMetadata.count).mockResolvedValue(0);\n\n    const caller = libraryRouter.createCaller(ctx);\n    const result = await caller.getUsageStats({\n      childProfileId,\n    });\n\n    expect(result.engagement.totalStories).toBe(0);\n    expect(result.engagement.completionRate).toBe(0);\n    expect(result.engagement.avgReReadsPerStory).toBe(0);\n  });\n\n  it('should throw error if user not authorized for child profile', async () => {\n    const mockPrisma = createMockPrisma();\n    const ctx = createTestContext({ prisma: mockPrisma });\n\n    const childProfileId = 'child-123';\n    const parentId = 'parent-123';\n\n    // Mock child profile lookup\n    vi.mocked(mockPrisma.childProfile.findUnique).mockResolvedValue({\n      id: childProfileId,\n      parentId,\n    } as any);\n\n    // Mock parent lookup with DIFFERENT parent ID (unauthorized)\n    vi.mocked(mockPrisma.parent.findUnique).mockResolvedValue({\n      id: 'different-parent-id',\n      supabaseUserId: 'test-viewer-id',\n    } as any);\n\n    const caller = libraryRouter.createCaller(ctx);\n\n    await expect(\n      caller.getUsageStats({\n        childProfileId,\n      })\n    ).rejects.toThrow(TRPCError);\n  });\n});\n\n/**\n * Library Router Tests - Story 5.6: Story Favoriting\n *\n * Tests for the toggleFavorite mutation including:\n * - Successful favorite/unfavorite operations\n * - Parent ownership verification\n * - Story metadata creation and update\n * - Error handling\n */\n\n/**\n * Library Router Unit Tests - Epic 5 Story 5.4\n * Tests for reading progress tracking\n */\n\n/**\n * Library Router Tests\n * Tests for Epic 5: Story Library API procedures\n */\n\n/**\n * Library Router Unit Tests - Epic 5: Story 5.1\n *\n * Tests for story library API procedures including:\n * - Pagination calculations\n * - Filter combinations\n * - Sort order transformations\n * - Authorization checks\n */\n\ndescribe('Library Router - toggleFavorite', () => {\n  let mockContext: Context;\n  let mockPrisma: any;\n\n","exit_code":0,"status":"completed"}}
