{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '240,520p' packages/ai/src/gemini/client.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n{\n  \"title\": \"Exciting story title\",\n  \"scenes\": [\n    {\n      \"sceneNumber\": 1,\n      \"text\": \"Scene narration text (engaging, age-appropriate)\",\n      \"imagePrompt\": \"Detailed visual description for image generation including character appearance, setting, action, ${artStyle} art style\"\n    }\n    // ... 6 scenes total\n  ]\n}\n\nImportant: Return ONLY valid JSON, no additional text before or after.`;\n  }\n\n  /**\n   * Get safety settings for content filtering\n   * AC3: Safety settings configured\n   *\n   * @returns Array of safety settings\n   */\n  private getSafetySettings() {\n    return [\n      {\n        category: HarmCategory.HARM_CATEGORY_HARASSMENT,\n        threshold: HarmBlockThreshold.BLOCK_MEDIUM_AND_ABOVE,\n      },\n      {\n        category: HarmCategory.HARM_CATEGORY_HATE_SPEECH,\n        threshold: HarmBlockThreshold.BLOCK_MEDIUM_AND_ABOVE,\n      },\n      {\n        category: HarmCategory.HARM_CATEGORY_SEXUALLY_EXPLICIT,\n        threshold: HarmBlockThreshold.BLOCK_MEDIUM_AND_ABOVE,\n      },\n      {\n        category: HarmCategory.HARM_CATEGORY_DANGEROUS_CONTENT,\n        threshold: HarmBlockThreshold.BLOCK_MEDIUM_AND_ABOVE,\n      },\n    ];\n  }\n\n  /**\n   * Extract safety ratings from Gemini response\n   * Safety ratings are per-candidate, not on the root response\n   *\n   * @param response - Gemini response object\n   * @returns Array of safety ratings\n   */\n  private extractSafetyRatings(response: any): SafetyRating[] {\n    // Safety ratings are on the candidates array\n    const candidates = response.candidates;\n    if (!candidates || candidates.length === 0) {\n      return [];\n    }\n\n    const safetyRatings = candidates[0].safetyRatings;\n    if (!safetyRatings) {\n      return [];\n    }\n\n    return safetyRatings.map((rating: any) => ({\n      category: rating.category,\n      probability: rating.probability,\n    }));\n  }\n}\n\n/**\n * Cached singleton instance of GeminiClient\n * Lazy-loaded to avoid crashes on import when env vars are missing\n */\nlet _geminiClientInstance: GeminiClient | null = null;\n\n/**\n * Get or create the singleton GeminiClient instance\n * Lazy initialization prevents import-time crashes\n *\n * @param config - Optional configuration for testing (bypasses singleton)\n * @returns Singleton GeminiClient instance, or new instance if config provided\n */\nexport function getGeminiClient(config?: GeminiClientConfig): GeminiClient {\n  // If config provided, return new instance (for testing)\n  if (config) {\n    return new GeminiClient(config);\n  }\n\n  // Otherwise use singleton\n  if (!_geminiClientInstance) {\n    _geminiClientInstance = new GeminiClient();\n  }\n  return _geminiClientInstance;\n}\n\n/**\n * Reset the singleton instance (for testing)\n */\nexport function resetGeminiClient(): void {\n  _geminiClientInstance = null;\n}\n\n/**\n * Legacy export for backward compatibility\n * Use getGeminiClient() instead for better error handling\n * @deprecated Use getGeminiClient() instead\n */\nexport const geminiClient = {\n  get instance(): GeminiClient {\n    return getGeminiClient();\n  },\n  generateStory(params: GenerateStoryRequest): Promise<GenerateStoryResponse> {\n    return getGeminiClient().generateStory(params);\n  },\n};\n\n/**\n * Convenience function for generating stories\n * Wrapper around singleton client\n */\nexport async function generateStory(\n  params: GenerateStoryRequest\n): Promise<GenerateStoryResponse> {\n  return getGeminiClient().generateStory(params);\n}\n","exit_code":0,"status":"completed"}}
