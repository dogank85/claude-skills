{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '450,620p' packages/ai/src/imagen/client.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n   * @returns Safety scores object or undefined\n   */\n  private extractSafetyScores(candidate: any): GenerateImageResponse['safetyScores'] {\n    if (!candidate.safetyRatings) {\n      return undefined;\n    }\n\n    const ratings = candidate.safetyRatings;\n    return {\n      adult: this.mapSafetyRating(ratings.find((r: any) => r.category === 'HARM_CATEGORY_SEXUALLY_EXPLICIT')?.probability),\n      violence: this.mapSafetyRating(ratings.find((r: any) => r.category === 'HARM_CATEGORY_DANGEROUS_CONTENT')?.probability),\n      racy: this.mapSafetyRating(ratings.find((r: any) => r.category === 'HARM_CATEGORY_HARASSMENT')?.probability),\n    };\n  }\n\n  /**\n   * Map safety rating probability to numeric score (0-1)\n   *\n   * @param probability - String probability from API\n   * @returns Numeric score between 0 and 1\n   */\n  private mapSafetyRating(probability?: string): number {\n    const mapping: Record<string, number> = {\n      NEGLIGIBLE: 0.1,\n      LOW: 0.3,\n      MEDIUM: 0.6,\n      HIGH: 0.9,\n    };\n\n    return mapping[probability || 'NEGLIGIBLE'] || 0.1;\n  }\n}\n\n/**\n * Singleton instance for convenience\n * Initialize with environment variables\n */\nlet _clientInstance: NanoBananaClient | null = null;\n\nexport function getNanoBananaClient(): NanoBananaClient {\n  if (!_clientInstance) {\n    const projectId = process.env.GOOGLE_CLOUD_PROJECT;\n    if (!projectId) {\n      throw new Error('GOOGLE_CLOUD_PROJECT environment variable is required');\n    }\n\n    _clientInstance = new NanoBananaClient({ projectId });\n  }\n\n  return _clientInstance;\n}\n\n/**\n * Export singleton instance\n */\nexport const nanoBananaClient = getNanoBananaClient();\n","exit_code":0,"status":"completed"}}
