 publicUrlData.publicUrl,\n          cost: result.cost,\n          safetyScore: 1.0, // TODO: Use actual safety score from result\n        };\n      } catch (error) {\n        console.error(`Failed to generate image for scene ${scene.sceneNumber}:`, error);\n        // Return a placeholder or fail? \n        // For now, let's fail the whole story if a scene fails, or return a placeholder.\n        // Returning placeholder to allow partial success might be better for UX, but for now let's throw to trigger refund logic.\n        throw error;\n      }\n    })\n  );\n\n  return images;\n}\n","exit_code":0,"status":"completed"}}
