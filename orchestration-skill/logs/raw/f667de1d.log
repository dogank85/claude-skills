{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/routers/story.integration.test.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Story Generation Integration Tests\n * Epic 4 Story 4.6: Story Generation Orchestration\n *\n * Full end-to-end integration tests for story generation flow\n */\n\nimport { describe, it, expect, beforeAll, afterAll, vi } from 'vitest';\nimport { PrismaClient, ArtStyle, PoseType } from '@prisma/client';\nimport { appRouter } from '../root';\nimport type { Context } from '../context';\n\n/**\n * Integration test suite for story generation orchestration\n *\n * Prerequisites:\n * - Test database accessible\n * - Child profile with avatars already generated\n *\n * Note: These tests are designed to verify the complete 3-phase orchestration:\n * Phase 1: Text generation (mocked)\n * Phase 2: Image generation (mocked)\n * Phase 3: Storage and completion\n */\ndescribe('Story Generation Flow (Integration)', () => {\n  let prisma: PrismaClient;\n  let testParentId: string;\n  let testChildId: string;\n  let caller: ReturnType<typeof appRouter.createCaller>;\n\n  beforeAll(async () => {\n    // Initialize Prisma\n    prisma = new PrismaClient({\n      datasources: {\n        db: {\n          url: process.env.DATABASE_URL || 'postgresql://localhost:5432/herokid_test',\n        },\n      },\n    });\n\n    // Create test parent\n    const parent = await prisma.parent.create({\n      data: {\n        supabaseUserId: crypto.randomUUID(),\n        email: `test-story-${Date.now()}@example.com`,\n        status: 'ACTIVE',\n        consentAt: new Date(),\n        consentIp: '127.0.0.1',\n        consentMethod: 'web',\n      },\n    });\n    testParentId = parent.id;\n\n    // Create test child profile\n    const child = await prisma.childProfile.create({\n      data: {\n        parentId: testParentId,\n        name: 'Story Test Child',\n        birthMonth: 7,\n        birthYear: 2016,\n        ageGroup: 'EIGHT_TO_TEN',\n        avatarsGenerated: true,\n        avatarsGeneratedAt: new Date(),\n        preferredArtStyle: ArtStyle.PIXAR,\n      },\n    });\n    testChildId = child.id;\n\n    // Create test avatars for all art styles\n    for (const artStyle of [ArtStyle.PIXAR, ArtStyle.TWO_D, ArtStyle.ANIME, ArtStyle.WATERCOLOR]) {\n      for (const poseType of [PoseType.PORTRAIT, PoseType.FULL_BODY]) {\n        await prisma.avatar.create({\n          data: {\n            childProfileId: testChildId,\n            artStyle,\n            poseType,\n            storagePath: `avatars/${testChildId}/${artStyle}_${poseType}.png`,\n            publicUrl: `https://storage.example.com/avatars/${testChildId}/${artStyle}_${poseType}.png`,\n            generationCost: 0.039,\n            qualityScore: 0.95,\n            safetyScore: 1.0,\n          },\n        });\n      }\n    }\n\n    // Create test pet companion\n    await prisma.petCompanion.create({\n      data: {\n        childProfileId: testChildId,\n        petType: 'dog',\n        petName: 'Buddy',\n        personality: 'brave',\n        companionUrls: {\n          pixar: 'https://storage.example.com/pets/buddy_pixar.png',\n          '2d': 'https://storage.example.com/pets/buddy_2d.png',\n          anime: 'https://storage.example.com/pets/buddy_anime.png',\n          watercolor: 'https://storage.example.com/pets/buddy_watercolor.png',\n        },\n        generationCost: 0.156,\n      },\n    });\n\n    // Create tRPC caller with mock session\n    const ctx: Context = {\n      session: {\n        user: {\n          id: testParentId,\n          email: parent.email,\n        },\n        expires: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),\n      },\n      db: prisma,\n      headers: new Headers(),\n    };\n\n    caller = appRouter.createCaller(ctx);\n  });\n\n  afterAll(async () => {\n    // Cleanup test data\n    if (testChildId) {\n      await prisma.storyGenerationJob.deleteMany({\n        where: { childProfileId: testChildId },\n      });\n      await prisma.story.deleteMany({\n        where: { childProfileId: testChildId },\n      });\n      await prisma.avatar.deleteMany({\n        where: { childProfileId: testChildId },\n      });\n      await prisma.petCompanion.deleteMany({\n        where: { childProfileId: testChildId },\n      });\n      await prisma.childProfile.delete({\n        where: { id: testChildId },\n      });\n    }\n    if (testParentId) {\n      await prisma.parent.delete({\n        where: { id: testParentId },\n      });\n    }\n\n    await prisma.$disconnect();\n  });\n\n  it('should generate complete story in <35 seconds', async () => {\n    const startTime = Date.now();\n\n    // Phase 1: Initiate story generation\n    const result = await caller.story.generateStory({\n      childProfileId: testChildId,\n      adventureTemplate: 'superhero_rescue',\n      includePet: true,\n      artStyle: 'pixar',\n    });\n\n    expect(result.status).toBe('generating');\n    expect(result.generationId).toBeDefined();\n    expect(result.estimatedTimeSeconds).toBe(30);\n\n    // Phase 2: Poll for status until complete\n    let status;\n    let attempts = 0;\n    const maxAttempts = 20; // 20 attempts * 2 seconds = 40 seconds max\n\n    do {\n      await new Promise(resolve => setTimeout(resolve, 2000)); // Poll every 2 seconds\n      status = await caller.story.getGenerationStatus({\n        generationId: result.generationId,\n      });\n      attempts++;\n\n      // Break if we exceed max attempts\n      if (attempts >= maxAttempts) {\n        break;\n      }\n    } while (status.status !== 'COMPLETE' && status.status !== 'FAILED');\n\n    const totalTime = Date.now() - startTime;\n\n    // Assertions\n    expect(status.status).toBe('COMPLETE');\n    expect(status.storyId).toBeDefined();\n    expect(status.error).toBeUndefined();\n    expect(totalTime).toBeLessThan(35000); // <35 seconds\n\n    // Verify story was created\n    const story = await caller.story.getStory({\n      storyId: status.storyId!,\n    });\n\n    expect(story).toBeDefined();\n    expect(story.title).toContain('Story Test Child');\n    expect(story.adventureType).toBe('superhero_rescue');\n    expect(story.artStyle).toBe('pixar');\n    expect(story.includedPet).toBe(true);\n    expect(story.scenes).toHaveLength(6);\n    expect(story.wordCount).toBeGreaterThan(0);\n","exit_code":0,"status":"completed"}}
