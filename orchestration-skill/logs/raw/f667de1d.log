{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/ai/src/imagen/client.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Nano Banana API Client (Google Vertex AI Imagen 3)\n * Epic 3 Story 3.3: Avatar Generation in 4 Art Styles\n *\n * Provides methods for generating child avatars and pet companions\n * using Google's Imagen 3 model via Vertex AI.\n */\n\nimport { VertexAI, HarmCategory, HarmBlockThreshold } from '@google-cloud/vertexai';\nimport { GenerateImageRequest, GenerateImageResponse, PetGenerationRequest, PetType, PetPersonality } from './types';\nimport { buildAvatarPrompt, ART_STYLE_PROMPTS } from './styles';\nimport { retryWithBackoff, createRetryableError, createNonRetryableError } from './retry';\n\n/**\n * Client configuration options\n */\nexport interface NanoBananaClientConfig {\n  projectId: string;\n  location?: string;\n  model?: string;\n}\n\n/**\n * NanoBananaClient - Handles AI image generation for avatars\n *\n * Features:\n * - Parallel batch generation for multiple art styles\n * - Automatic retry with exponential backoff\n * - Cost tracking per image ($0.039 per generation)\n * - Safety filtering and quality validation\n */\nexport class NanoBananaClient {\n  private vertexAI: VertexAI;\n  private model: string;\n  private readonly costPerImage = 0.039; // $0.039 per Imagen 3 generation\n\n  constructor(config: NanoBananaClientConfig) {\n    if (!config.projectId) {\n      throw new Error('Google Cloud Project ID is required');\n    }\n\n    this.vertexAI = new VertexAI({\n      project: config.projectId,\n      location: config.location || 'us-central1',\n    });\n\n    this.model = config.model || 'imagen-3.0-generate-001';\n  }\n\n  /**\n   * Generate a single avatar image\n   *\n   * Constructs a prompt combining art style and pose type, then calls the\n   * Imagen API with retry logic and safety settings.\n   *\n   * @param params - Generation parameters (source URL, art style, pose type)\n   * @returns Promise resolving to generated image data\n   * @throws Error if generation fails after retries\n   */\n  async generateAvatar(params: {\n    sourceImageUrl: string;\n    artStyle: 'pixar' | '2d' | 'anime' | 'watercolor';\n    poseType: 'portrait' | 'full_body';\n  }): Promise<GenerateImageResponse> {\n    const prompt = buildAvatarPrompt(params.artStyle, params.poseType);\n\n    return retryWithBackoff(\n      async () => {\n        try {\n          const startTime = Date.now();\n\n          // Call Vertex AI Imagen 3 API\n          const generativeModel = this.vertexAI.preview.getGenerativeModel({\n            model: this.model,\n          });\n\n          // Generate image with reference image (style transfer)\n          const result = await generativeModel.generateContent({\n            contents: [\n              {\n                role: 'user',\n                parts: [\n                  {\n                    text: prompt,\n                  },\n                  {\n                    fileData: {\n                      mimeType: 'image/jpeg',\n                      fileUri: params.sourceImageUrl,\n                    },\n                  },\n                ],\n              },\n            ],\n            generationConfig: {\n              temperature: 0.4,\n              topP: 0.8,\n              topK: 40,\n              maxOutputTokens: 2048,\n            },\n            safetySettings: [\n              {\n                category: HarmCategory.HARM_CATEGORY_HATE_SPEECH,\n                threshold: HarmBlockThreshold.BLOCK_MEDIUM_AND_ABOVE,\n              },\n              {\n                category: HarmCategory.HARM_CATEGORY_DANGEROUS_CONTENT,\n                threshold: HarmBlockThreshold.BLOCK_MEDIUM_AND_ABOVE,\n              },\n              {\n                category: HarmCategory.HARM_CATEGORY_SEXUALLY_EXPLICIT,\n                threshold: HarmBlockThreshold.BLOCK_MEDIUM_AND_ABOVE,\n              },\n              {\n                category: HarmCategory.HARM_CATEGORY_HARASSMENT,\n                threshold: HarmBlockThreshold.BLOCK_MEDIUM_AND_ABOVE,\n              },\n            ],\n          });\n\n          const generationTime = Date.now() - startTime;\n\n          // Extract image from response\n          const response = result.response;\n          if (!response.candidates || response.candidates.length === 0) {\n            throw createNonRetryableError('No image generated in response');\n          }\n\n          const candidate = response.candidates[0];\n          if (!candidate.content.parts || candidate.content.parts.length === 0) {\n            throw createNonRetryableError('No content parts in response');\n          }\n\n          // For Imagen, the image is typically in the first part\n          const imagePart = candidate.content.parts[0];\n\n          // Convert base64 to Buffer\n          const imageBuffer = Buffer.from(\n            (imagePart as any).inlineData?.data || '',\n            'base64'\n          );\n\n          if (imageBuffer.length === 0) {\n            throw createNonRetryableError('Empty image buffer received');\n          }\n\n          return {\n            imageBuffer,\n            cost: this.costPerImage,\n            generationTime,\n            safetyScores: this.extractSafetyScores(candidate),\n          };\n        } catch (error) {\n          // Determine if error is retryable\n          const errorMessage = error instanceof Error ? error.message : String(error);\n\n          // API quota exceeded - retryable\n          if (errorMessage.includes('quota') || errorMessage.includes('rate limit')) {\n            throw createRetryableError('API quota exceeded, retrying...', error as Error);\n          }\n\n          // Service unavailable - retryable\n          if (\n            errorMessage.includes('503') ||\n            errorMessage.includes('unavailable') ||\n            errorMessage.includes('timeout')\n          ) {\n            throw createRetryableError('Service temporarily unavailable', error as Error);\n          }\n\n          // Bad request - not retryable\n          if (errorMessage.includes('400') || errorMessage.includes('invalid')) {\n            throw createNonRetryableError('Invalid request parameters', error as Error);\n          }\n\n          // Rethrow as-is to let retry logic handle\n          throw error;\n        }\n      },\n      {\n        maxRetries: 3,\n        initialDelayMs: 1000,\n      }\n    );\n  }\n\n  /**\n   * Generate multiple avatars in parallel\n   *\n   * Uses Promise.all() to parallelize requests for faster generation.\n   * Critical for Story 3.3's <60 second requirement for 8 images.\n   *\n   * @param requests - Array of generation requests\n   * @returns Promise resolving to array of generated images\n   *\n   * @example\n   * ```typescript\n   * const avatars = await client.batchGenerateAvatars([\n   *   { sourceImageUrl: url1, artStyle: 'pixar', poseType: 'portrait' },\n   *   { sourceImageUrl: url2, artStyle: '2d', poseType: 'full_body' },\n","exit_code":0,"status":"completed"}}
