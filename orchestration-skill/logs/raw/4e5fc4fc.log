/routers/stripeWebhook.ts:      const webhookSecret = ctx.env.stripeWebhookSecret;\npackages/api/src/routers/stripeWebhook.ts:      const stripeSecretKey = ctx.env.STRIPE_SECRET_KEY || process.env.STRIPE_SECRET_KEY || 'sk_test_placeholder';\npackages/api/src/routers/stripeWebhook.ts:      if (!input.stripeSignature) {\npackages/api/src/routers/stripeWebhook.ts:      const stripe = new Stripe(stripeSecretKey, {\npackages/api/src/routers/stripeWebhook.ts:        apiVersion: stripeApiVersion,\npackages/api/src/routers/stripeWebhook.ts:        event = stripe.webhooks.constructEvent(\npackages/api/src/routers/stripeWebhook.ts:          input.stripeSignature,\npackages/api/src/routers/stripeWebhook.ts:          source: 'stripe',\npackages/api/src/routers/stripeWebhook.ts:              where: { stripePaymentId: session.payment_intent as string },\npackages/api/src/routers/stripeWebhook.ts:                  stripePaymentId: session.payment_intent as string,\npackages/api/src/routers/stripeWebhook.ts:                source: 'stripe',\npackages/api/src/routers/stripeWebhook.ts:                action: 'stripe_payment_failed',\npackages/api/src/routers/stripeWebhook.ts:            source: 'stripe',\npackages/api/src/routers/credits.ts:  stripePaymentId: z.string().optional(),\npackages/api/src/routers/credits.ts:            stripePaymentId: input.stripePaymentId,\npackages/api/src/routers/credits.ts:      const { stripe } = await import('../lib/stripe');\npackages/api/src/routers/credits.ts:        const session = await stripe.checkout.sessions.create({\npackages/api/src/routers/credits.ts:            action: 'stripe_checkout_created',\npackages/api/src/routers/credits.ts:            entityType: 'stripe_session',\npackages/api/src/routers/stripeWebhook.test.ts: *   const result = await caller.stripeWebhook.handleWebhook(webhookEvent);\napps/web/app/api/webhooks/stripe/route.ts: * @module api/webhooks/stripe\napps/web/app/api/webhooks/stripe/route.ts:import Stripe from 'stripe';