{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '280,560p' packages/api/src/routers/credits.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n        });\n      }\n    }),\n\n  /**\n   * Get credit transaction history\n   */\n  getHistory: protectedProcedure\n    .input(\n      z.object({\n        limit: z.number().min(1).max(100).default(50),\n        offset: z.number().min(0).default(0),\n      })\n    )\n    .query(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true },\n      });\n\n      if (!parent) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      const [transactions, totalCount] = await Promise.all([\n        ctx.prisma.creditTransaction.findMany({\n          where: { parentId: parent.id },\n          orderBy: { createdAt: 'desc' },\n          take: input.limit,\n          skip: input.offset,\n        }),\n        ctx.prisma.creditTransaction.count({\n          where: { parentId: parent.id },\n        }),\n      ]);\n\n      return {\n        transactions: transactions.map((tx) => ({\n          id: tx.id,\n          credits: tx.credits,\n          type: tx.type,\n          description: tx.description,\n          relatedStoryId: tx.relatedStoryId,\n          createdAt: tx.createdAt,\n        })),\n        totalCount,\n        hasMore: input.offset + input.limit < totalCount,\n      };\n    }),\n\n  /**\n   * Verify Apple In-App Purchase and grant credits\n   *\n   * ⚠️ SECURITY WARNING: This implementation is incomplete and NOT production-ready!\n   * Apple receipt verification MUST be implemented before deployment.\n   */\n  /**\n   * Verify Apple In-App Purchase and grant credits\n   */\n  verifyApplePurchase: protectedProcedure\n    .input(\n      z.object({\n        transactionId: z.string(),\n        receipt: z.string(),\n        productId: z.string(), // e.g., \"com.herokid.credits.5\"\n      })\n    )\n    .mutation(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true },\n      });\n\n      if (!parent) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      // 1. Verify Receipt with Apple\n      const APPLE_VERIFY_URL = process.env.NODE_ENV === 'production'\n        ? 'https://buy.itunes.apple.com/verifyReceipt'\n        : 'https://sandbox.itunes.apple.com/verifyReceipt';\n\n      const sharedSecret = process.env.APPLE_SHARED_SECRET;\n      if (!sharedSecret) {\n        console.error('APPLE_SHARED_SECRET is missing');\n        throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Configuration error' });\n      }\n\n      let appleResponse;\n      try {\n        appleResponse = await axios.post(APPLE_VERIFY_URL, {\n          'receipt-data': input.receipt,\n          password: sharedSecret,\n          'exclude-old-transactions': true,\n        });\n\n        // Handle Sandbox receipt sent to Prod URL (Error 21007)\n        if (appleResponse.data.status === 21007) {\n          console.log('Sandbox receipt sent to Prod URL, retrying with Sandbox URL...');\n          appleResponse = await axios.post('https://sandbox.itunes.apple.com/verifyReceipt', {\n            'receipt-data': input.receipt,\n            password: sharedSecret,\n            'exclude-old-transactions': true,\n          });\n        }\n      } catch (error) {\n        console.error('Apple verification failed:', error);\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to verify receipt with Apple',\n          cause: error,\n        });\n      }\n\n      const data = appleResponse.data;\n\n      // Log verification attempt\n      await ctx.prisma.auditLog.create({\n        data: {\n          actorParentId: parent.id,\n          action: 'apple_iap_verification',\n          entityType: 'apple_receipt',\n          entityId: input.transactionId,\n          metadata: {\n            status: data.status,\n            environment: data.environment,\n            productId: input.productId,\n          },\n          ipAddress: ctx.requestIp,\n        },\n      });\n\n      if (data.status !== 0) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: `Apple receipt verification failed with status: ${data.status}`,\n        });\n      }\n\n      // 2. Validate Receipt Content\n      const latestReceipt = data.latest_receipt_info?.[0] || data.receipt;\n      if (!latestReceipt) {\n        throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'No receipt info returned' });\n      }\n\n      if (latestReceipt.product_id !== input.productId) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: `Product ID mismatch. Expected ${input.productId}, got ${latestReceipt.product_id}`,\n        });\n      }\n\n      if (latestReceipt.transaction_id !== input.transactionId) {\n        // Note: Sometimes original_transaction_id might be needed, but strict match is safer for consumable\n        console.warn(`Transaction ID mismatch: Input ${input.transactionId} vs Receipt ${latestReceipt.transaction_id}`);\n      }\n\n      // 3. Parse Credits\n      const creditsMatch = input.productId.match(/\\.credits\\.(\\d+)$/);\n      if (!creditsMatch) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Invalid product ID format',\n        });\n      }\n\n      const credits = parseInt(creditsMatch[1], 10);\n      if (![1, 5, 10].includes(credits)) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Invalid credit amount',\n        });\n      }\n\n      // Check for duplicate transaction\n      const existingPack = await ctx.prisma.creditPack.findFirst({\n        where: { appleTransactionId: input.transactionId },\n      });\n\n      if (existingPack) {\n        const balance = await getCreditBalance(ctx, parent.id);\n        return {\n          success: true,\n          credits,\n          balance,\n          message: 'Credits already granted for this transaction',\n        };\n      }\n\n      // Grant credits using purchaseCredits logic\n      const result = await ctx.prisma.$transaction(async (tx) => {\n        const creditPack = await tx.creditPack.create({\n          data: {\n            parentId: parent.id,\n            credits,\n            price: credits * 0.99,\n            platform: 'APPLE',\n            appleTransactionId: input.transactionId,\n          },\n        });\n\n        await tx.creditTransaction.create({\n          data: {\n            parentId: parent.id,\n            credits,\n            type: 'PURCHASE',\n            description: `Apple IAP: ${credits} credits`,\n          },\n        });\n\n        // Update parent's credit balance atomically\n        const updatedParent = await tx.parent.update({\n          where: { id: parent.id },\n          data: {\n            creditBalance: {\n              increment: credits,\n            },\n          },\n          select: { creditBalance: true },\n        });\n\n        return { creditPack, newBalance: updatedParent.creditBalance };\n      });\n\n      return {\n        success: true,\n        credits,\n        balance: result.newBalance,\n        creditPackId: result.creditPack.id,\n      };\n    }),\n\n  /**\n   * Verify Google Play purchase and grant credits\n   *\n   * ⚠️ SECURITY WARNING: This implementation is incomplete and NOT production-ready!\n   * Google Play purchase token verification MUST be implemented before deployment.\n   */\n  /**\n   * Verify Google Play purchase and grant credits\n   */\n  verifyGooglePurchase: protectedProcedure\n    .input(\n      z.object({\n        purchaseToken: z.string(),\n        orderId: z.string(),\n        sku: z.string(), // e.g., \"credits_5\"\n      })\n    )\n    .mutation(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true },\n      });\n\n      if (!parent) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      // 1. Authenticate with Google\n      const serviceAccountStr = process.env.GOOGLE_PLAY_SERVICE_ACCOUNT;\n      if (!serviceAccountStr) {\n        console.error('GOOGLE_PLAY_SERVICE_ACCOUNT is missing');\n        throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Configuration error' });\n      }\n\n      let authClient;\n      try {\n        const credentials = JSON.parse(serviceAccountStr);\n        authClient = new google.auth.JWT({\n          email: credentials.client_email,\n          key: credentials.private_key,\n","exit_code":0,"status":"completed"}}
