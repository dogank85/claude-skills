{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' packages/api/src/routers/stripeWebhook.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Stripe Webhook Handler for Credit Pack Purchases\n *\n * ⚠️ SECURITY WARNING: This tRPC endpoint is for internal use only.\n *\n * Production webhook handling should use a dedicated Next.js API route with raw body parsing\n * to properly verify Stripe signatures. See: apps/web/app/api/webhooks/stripe/route.ts\n *\n * This endpoint processes Stripe webhooks for:\n * - checkout.session.completed: When a payment is successful\n * - payment_intent.succeeded: When payment is confirmed\n * - payment_intent.payment_failed: When payment fails\n */\n\nimport { TRPCError } from '@trpc/server';\nimport { z } from 'zod';\nimport { createTRPCRouter, publicProcedure } from '../trpc';\nimport Stripe from 'stripe';\n\nconst stripeWebhookInput = z.object({\n  rawBody: z.string().min(1, 'Raw request body required for verification'),\n  stripeSignature: z.string().min(1, 'Stripe signature header is required'),\n});\n\nconst stripeApiVersion = '2024-11-20.acacia';\n\nexport const stripeWebhookRouter = createTRPCRouter({\n  /**\n   * Handle Stripe webhook events\n   *\n   * ⚠️ SECURITY: This endpoint requires webhook signature verification.\n   * In production, use a dedicated API route with raw body parsing.\n   *\n   * For proper Stripe webhook handling, create:\n   * apps/web/app/api/webhooks/stripe/route.ts\n   *\n   * That route should:\n   * 1. Get raw request body\n   * 2. Verify signature with stripe.webhooks.constructEvent()\n   * 3. Call this procedure with verified event data\n   */\n  handleWebhook: publicProcedure\n    .input(stripeWebhookInput)\n    .mutation(async ({ ctx, input }) => {\n      const webhookSecret = ctx.env.stripeWebhookSecret;\n      const stripeSecretKey = ctx.env.STRIPE_SECRET_KEY || process.env.STRIPE_SECRET_KEY || 'sk_test_placeholder';\n\n      if (!webhookSecret) {\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'STRIPE_WEBHOOK_SECRET must be configured',\n        });\n      }\n\n      // SECURITY: Block unauthenticated webhooks\n      if (!input.stripeSignature) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Webhook signature required',\n        });\n      }\n\n      const stripe = new Stripe(stripeSecretKey, {\n        apiVersion: stripeApiVersion,\n        typescript: true,\n      });\n\n      let event: Stripe.Event;\n      try {\n        event = stripe.webhooks.constructEvent(\n          input.rawBody,\n          input.stripeSignature,\n          webhookSecret\n        );\n      } catch (error) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Invalid Stripe signature',\n          cause: error instanceof Error ? error : undefined,\n        });\n      }\n\n      // Log webhook receipt only after verification\n      await ctx.prisma.webhookEvent.create({\n        data: {\n          source: 'stripe',\n          eventType: event.type,\n          payload: event,\n          processed: false,\n        },\n      });\n\n      try {\n        switch (event.type) {\n          case 'checkout.session.completed': {\n            const session = event.data.object as Stripe.Checkout.Session;\n\n            // Extract metadata\n            const parentId = session.metadata?.parentId || session.client_reference_id;\n            const credits = parseInt(session.metadata?.credits || '0', 10);\n\n            if (!parentId || !credits || ![1, 5, 10].includes(credits)) {\n              throw new TRPCError({\n                code: 'BAD_REQUEST',\n                message: 'Invalid session metadata',\n              });\n            }\n\n            // Check if already processed (idempotency)\n            const existingPack = await ctx.prisma.creditPack.findFirst({\n              where: { stripePaymentId: session.payment_intent as string },\n            });\n\n            if (existingPack) {\n              // Already processed - idempotent return\n              return { success: true, message: 'Already processed' };\n            }\n\n            // Process purchase in transaction\n            const result = await ctx.prisma.$transaction(async (tx: any) => {\n              // Create credit pack record\n              const creditPack = await tx.creditPack.create({\n                data: {\n                  parentId,\n                  credits,\n                  price: (session.amount_total || 0) / 100, // Convert from cents\n                  platform: 'STRIPE',\n                  stripePaymentId: session.payment_intent as string,\n                },\n              });\n\n              // Create credit transaction\n              await tx.creditTransaction.create({\n                data: {\n                  parentId,\n                  credits,\n                  type: 'PURCHASE',\n                  description: `Stripe purchase: ${credits} credits`,\n                },\n              });\n\n              // Update parent's credit balance\n              const updatedParent = await tx.parent.update({\n                where: { id: parentId },\n                data: {\n                  creditBalance: {\n                    increment: credits,\n                  },\n                },\n                select: { creditBalance: true },\n              });\n\n              // Create audit log\n              await tx.auditLog.create({\n                data: {\n                  actorParentId: parentId,\n                  action: 'credit_purchase_completed',\n                  entityType: 'credit_pack',\n                  entityId: creditPack.id,\n                  metadata: {\n                    credits,\n                    price: (session.amount_total || 0) / 100,\n                    platform: 'STRIPE',\n                    sessionId: session.id,\n                    newBalance: updatedParent.creditBalance,\n                  },\n                },\n              });\n\n              return { creditPack, newBalance: updatedParent.creditBalance };\n            });\n\n            // Mark webhook as processed\n            await ctx.prisma.webhookEvent.updateMany({\n              where: {\n                source: 'stripe',\n                eventType: event.type,\n                payload: {\n                  path: ['id'],\n                  equals: event.id,\n                },\n              },\n              data: {\n                processed: true,\n                processedAt: new Date(),\n              },\n            });\n\n            return {\n              success: true,\n              creditPackId: result.creditPack.id,\n              newBalance: result.newBalance,\n            };\n          }\n\n          case 'payment_intent.payment_failed': {\n            const paymentIntent = event.data.object as Stripe.PaymentIntent;\n\n            // Log failed payment in audit log\n            await ctx.prisma.auditLog.create({\n              data: {\n                action: 'stripe_payment_failed',\n                entityType: 'payment_intent',\n                entityId: paymentIntent.id,\n                metadata: {\n                  error: paymentIntent.last_payment_error,\n                  amount: paymentIntent.amount / 100,\n                } as Record<string, any>,\n              },\n            });\n\n            return { success: false, message: 'Payment failed' };\n          }\n\n          default:\n            // Unhandled event type - acknowledge but don't process\n            return { success: true, message: 'Event acknowledged but not processed' };\n        }\n      } catch (error) {\n        // Mark webhook as failed\n        await ctx.prisma.webhookEvent.updateMany({\n          where: {\n            source: 'stripe',\n            eventType: event.type,\n          },\n          data: {\n            processed: false,\n            errorMessage: error instanceof Error ? error.message : 'Unknown error',\n            processedAt: new Date(),\n          },\n        });\n\n        // Error details are already logged in audit log\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to process webhook',\n          cause: error,\n        });\n      }\n    }),\n","exit_code":0,"status":"completed"}}
