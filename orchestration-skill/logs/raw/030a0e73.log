{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '140,260p' apps/web/app/api/cron/health-check/route.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n}\n\nconst ALERT_LATENCY_THRESHOLD_MS = 500;\n\nfunction buildAlertReasons(healthData: HealthResponse): string[] {\n  const reasons: string[] = [];\n\n  if (healthData.status !== 'ok') {\n    reasons.push(`overall status ${healthData.status}`);\n  }\n\n  const supabaseLatency = healthData.services.supabase.latencyMs;\n  if (typeof supabaseLatency === 'number' && supabaseLatency > ALERT_LATENCY_THRESHOLD_MS) {\n    reasons.push(`Supabase latency ${supabaseLatency}ms`);\n  }\n\n  Object.entries(healthData.services).forEach(([serviceName, service]) => {\n    if (!service.healthy) {\n      reasons.push(\n        `${serviceName} unhealthy${service.error ? ` (${service.error.slice(0, 120)})` : ''}`,\n      );\n    }\n  });\n\n  return [...new Set(reasons)];\n}\n\ntype AlertConfig = {\n  slackWebhookUrl?: string;\n  emailFrom?: string;\n  emailRecipients: string[];\n  resendApiKey?: string;\n  pagerDutyRoutingKey?: string;\n};\n\nfunction getAlertConfig(): AlertConfig {\n  const emailRecipients = (process.env.HEALTH_ALERT_EMAIL_TO ?? '')\n    .split(',')\n    .map((recipient) => recipient.trim())\n    .filter(Boolean);\n\n  return {\n    slackWebhookUrl: process.env.HEALTH_ALERT_SLACK_WEBHOOK_URL,\n    emailFrom: process.env.HEALTH_ALERT_EMAIL_FROM,\n    emailRecipients,\n    resendApiKey: process.env.RESEND_API_KEY,\n    pagerDutyRoutingKey: process.env.HEALTH_ALERT_PAGERDUTY_ROUTING_KEY,\n  };\n}\n\ntype AlertDetails = {\n  timestamp: string;\n  commitSha: string;\n  apiVersion: string;\n  runtimeEnv: string;\n  reasons: string[];\n  status: HealthResponse['status'];\n  services: HealthResponse['services'];\n};\n\nasync function sendSlackAlert(\n  webhookUrl: string,\n  summary: string,\n  details: AlertDetails,\n): Promise<boolean> {\n  const serviceLines = Object.entries(details.services)\n    .map(([serviceName, service]) => {\n      const health = service.healthy ? 'healthy' : 'unhealthy';\n      const latency = typeof service.latencyMs === 'number' ? `${service.latencyMs}ms` : 'n/a';\n      const errorSuffix = service.error ? ` – ${service.error}` : '';\n      return `• ${serviceName}: ${health} (${latency})${errorSuffix}`;\n    })\n    .join('\\n');\n\n  const body = {\n    text: `:rotating_light: ${summary}`,\n    blocks: [\n      {\n        type: 'section',\n        text: {\n          type: 'mrkdwn',\n          text: `:rotating_light: *HeroKid health monitor alert*\\n${summary}`,\n        },\n      },\n      {\n        type: 'section',\n        fields: [\n          { type: 'mrkdwn', text: `*Timestamp:* ${details.timestamp}` },\n          { type: 'mrkdwn', text: `*Environment:* ${details.runtimeEnv}` },\n          { type: 'mrkdwn', text: `*Commit:* ${details.commitSha}` },\n          { type: 'mrkdwn', text: `*Reasons:* ${details.reasons.join('; ')}` },\n        ],\n      },\n      {\n        type: 'section',\n        text: {\n          type: 'mrkdwn',\n          text: `*Services*\\n${serviceLines}`,\n        },\n      },\n    ],\n  };\n\n  const response = await fetch(webhookUrl, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify(body),\n  });\n\n  if (!response.ok) {\n    const errText = await response.text();\n    throw new Error(`Slack alert failed: ${response.status} ${errText}`);\n  }\n\n  return true;\n}\n\ntype EmailAlertConfig = {\n  apiKey: string;\n  from: string;\n  to: string[];\n","exit_code":0,"status":"completed"}}
