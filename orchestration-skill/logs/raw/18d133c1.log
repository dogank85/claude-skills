sword: values.password,\n    });\n  });\n\n  return (\n    <div className=\"auth-wrapper\">\n      <div className=\"auth-card\">\n        <p className=\"eyebrow\">Welcome back</p>\n        <h1>Sign in to your account</h1>\n        <p className=\"auth-helper\">\n          Enter your email and password to access your dashboard and stories.\n        </p>\n\n        {status === 'error' && errorMessage && (\n          <div className=\"auth-alert\" role=\"alert\">\n            {errorMessage}\n          </div>\n        )}\n\n        <form onSubmit={onSubmit} aria-busy={status === 'loading' || loginMutation.isPending}>\n          <div className=\"auth-field\">\n            <label htmlFor=\"email\">Email address</label>\n            <input\n              id=\"email\"\n              type=\"email\"\n              className=\"auth-input\"\n              placeholder=\"parent@example.com\"\n              {...register('email', { required: 'Email is required' })}\n            />\n            {errors.email && <span className=\"auth-error\">{errors.email.message}</span>}\n          </div>\n\n          <div className=\"auth-field\">\n            <div className=\"flex items-center justify-between\">\n              <label htmlFor=\"password\">Password</label>\n              <Link href=\"/forgot-password\" style={{ fontSize: '0.85rem' }} className=\"link\">\n                Forgot password?\n              </Link>\n            </div>\n            <input\n              id=\"password\"\n              type=\"password\"\n              className=\"auth-input\"\n              placeholder=\"Enter your password\"\n              {...register('password', { required: 'Password is required' })}\n            />\n            {errors.password && <span className=\"auth-error\">{errors.password.message}</span>}\n          </div>\n\n          <div className=\"auth-actions\">\n            <button\n              className=\"auth-button\"\n              type=\"submit\"\n              disabled={status === 'loading' || loginMutation.isPending}\n            >\n              {status === 'loading' || loginMutation.isPending ? 'Signing in…' : 'Sign in'}\n            </button>\n            <Link className=\"link\" href=\"/register\">\n              Don't have an account? Create one →\n            </Link>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n}\n","exit_code":0,"status":"completed"}}
