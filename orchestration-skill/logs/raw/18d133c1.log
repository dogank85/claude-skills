ar = pack.badge === 'Most Popular';\n\n            return (\n              <div\n                key={pack.credits}\n                className={`relative bg-white rounded-lg shadow-lg overflow-hidden transition-transform hover:scale-105 ${\n                  isMostPopular ? 'ring-2 ring-indigo-500' : ''\n                }`}\n              >\n                {/* Badge */}\n                {pack.badge && (\n                  <div className=\"absolute top-0 right-0 bg-indigo-500 text-white px-3 py-1 text-xs font-semibold rounded-bl-lg\">\n                    {pack.badge}\n                  </div>\n                )}\n\n                <div className=\"p-6\">\n                  {/* Pack Title */}\n                  <div className=\"text-center mb-6\">\n                    <h3 className=\"text-2xl font-bold text-gray-900 mb-2\">\n                      {pack.label}\n                    </h3>\n                    <div className=\"flex items-baseline justify-center gap-1\">\n                      <span className=\"text-4xl font-bold text-gray-900\">\n                        ${pack.price.toFixed(2)}\n                      </span>\n                    </div>\n                    <p className=\"text-sm text-gray-600 mt-2\">\n                      ${pack.perStoryPrice.toFixed(2)} per story\n                    </p>\n                    {pack.savings && (\n                      <p className=\"text-sm font-medium text-green-600 mt-1\">\n                        Save {pack.savings}%\n                      </p>\n                    )}\n                  </div>\n\n                  {/* Features */}\n                  <ul className=\"space-y-3 mb-6\">\n                    <li className=\"flex items-start\">\n","exit_code":0,"status":"completed"}}
