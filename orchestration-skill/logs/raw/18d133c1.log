  });\n    45\t\n    46\t  const {\n    47\t    register,\n    48\t    handleSubmit,\n    49\t    formState: { errors },\n    50\t  } = useForm<FormValues>({\n    51\t    defaultValues: {\n    52\t      email: '',\n    53\t      password: '',\n    54\t    },\n    55\t  });\n    56\t\n    57\t  const onSubmit = handleSubmit(async (values) => {\n    58\t    setStatus('loading');\n    59\t    setErrorMessage('');\n    60\t\n    61\t    loginMutation.mutate({\n    62\t      email: values.email,\n    63\t      password: values.password,\n    64\t    });\n    65\t  });\n    66\t\n    67\t  return (\n    68\t    <div className=\"auth-wrapper\">\n    69\t      <div className=\"auth-card\">\n    70\t        <p className=\"eyebrow\">Welcome back</p>\n    71\t        <h1>Sign in to your account</h1>\n    72\t        <p className=\"auth-helper\">\n    73\t          Enter your email and password to access your dashboard and stories.\n    74\t        </p>\n    75\t\n    76\t        {status === 'error' && errorMessage && (\n    77\t          <div className=\"auth-alert\" role=\"alert\">\n    78\t            {errorMessage}\n    79\t          </div>\n    80\t        )}\n    81\t\n    82\t        <form onSubmit={onSubmit} aria-busy={status === 'loading' || loginMutation.isPending}>\n    83\t          <div className=\"auth-field\">\n    84\t            <label htmlFor=\"email\">Email address</label>\n    85\t            <input\n    86\t              id=\"email\"\n    87\t              type=\"email\"\n    88\t              className=\"auth-input\"\n    89\t              placeholder=\"parent@example.com\"\n    90\t              {...register('email', { required: 'Email is required' })}\n    91\t            />\n    92\t            {errors.email && <span className=\"auth-error\">{errors.email.message}</span>}\n    93\t          </div>\n    94\t\n    95\t          <div className=\"auth-field\">\n    96\t            <div className=\"flex items-center justify-between\">\n    97\t              <label htmlFor=\"password\">Password</label>\n    98\t              <Link href=\"/forgot-password\" style={{ fontSize: '0.85rem' }} className=\"link\">\n    99\t                Forgot password?\n   100\t              </Link>\n   101\t            </div>\n   102\t            <input\n   103\t              id=\"password\"\n   104\t              type=\"password\"\n   105\t              className=\"auth-input\"\n   106\t              placeholder=\"Enter your password\"\n   107\t              {...register('password', { required: 'Password is required' })}\n   108\t            />\n   109\t            {errors.password && <span className=\"auth-error\">{errors.password.message}</span>}\n   110\t          </div>\n   111\t\n   112\t          <div className=\"auth-actions\">\n   113\t            <button\n   114\t              className=\"auth-button\"\n   115\t              type=\"submit\"\n   116\t              disabled={status === 'loading' || loginMutation.isPending}\n   117\t            >\n   118\t              {status === 'loading' || loginMutation.isPending ? 'Signing in…' : 'Sign in'}\n   119\t            </button>\n   120\t            <Link className=\"link\" href=\"/register\">\n   121\t              Don't have an account? Create one →\n   122\t            </Link>\n   123\t          </div>\n   124\t        </form>\n   125\t      </div>\n   126\t    </div>\n   127\t  );\n   128\t}\n","exit_code":0,"status":"completed"}}
