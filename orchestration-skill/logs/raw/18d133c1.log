y).gtag('event', 'purchase_initiated', {\n          value: CREDIT_PACKS.find(p => p.credits === purchasingPack)?.price,\n          currency: 'USD',\n          pack_size: purchasingPack,\n        });\n      }\n\n      // Redirect to Stripe checkout\n      if (data.checkoutUrl) {\n        window.location.href = data.checkoutUrl;\n      }\n    },\n    onError: (error) => {\n      console.error('Checkout error:', error);\n      alert('Failed to create checkout session. Please try again.');\n      setPurchasingPack(null);\n    },\n  });\n\n  const handlePurchase = async (pack: CreditPack) => {\n    setPurchasingPack(pack.credits);\n\n    // Track analytics\n    if (typeof window !== 'undefined' && (window as any).gtag) {\n      (window as any).gtag('event', 'pack_selected', {\n        pack_size: pack.credits,\n        price: pack.price,\n      });\n    }\n\n    const baseUrl = process.env.NEXT_PUBLIC_APP_URL || window.location.origin;\n\n    createCheckout.mutate({\n      credits: pack.credits,\n      successUrl: `${baseUrl}/purchase/success?session_id={CHECKOUT_SESSION_ID}`,\n      cancelUrl: `${baseUrl}/purchase?cancelled=true`,\n    });\n  };\n\n  // Track page view\n  if (typeof window !== 'undefined' && (window as any).gtag) {\n    (window as any).gtag('event', 'purchase_page_viewed');\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gray-50 py-12\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Header */}\n        <div className=\"text-center mb-12\">\n          <Link\n            href=\"/dashboard/billing\"\n            className=\"inline-flex items-center text-sm text-gray-600 hover:text-gray-900 mb-4\"\n          >\n            <svg className=\"w-4 h-4 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M10 19l-7-7m0 0l7-7m-7 7h18\" />\n            </svg>\n            Back to Billing\n          </Link>\n          <h1 