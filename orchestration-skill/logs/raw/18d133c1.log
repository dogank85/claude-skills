hrow new Error(\n        'GOOGLE_CLOUD_PROJECT environment variable is required for Gemini integration'\n      );\n    }\n\n    this.location = config?.location || 'us-central1';\n\n    this.vertexAI = new VertexAI({\n      project: projectId,\n      location: this.location,\n    });\n  }\n\n  /**\n   * Generate a personalized story with AI\n   *\n   * @param params - Story generation parameters\n   * @returns Generated story with scenes, cost, and metadata\n   * @throws Error if generation fails after retries\n   *\n   * @example\n   * ```typescript\n   * const story = await geminiClient.generateStory({\n   *   childName: 'Alice',\n   *   childAge: 7,\n   *   petName: 'Max',\n   *   petType: 'dog',\n   *   adventureTemplate: 'superhero_rescue',\n   *   artStyle: 'pixar',\n   * });\n   * ```\n   */\n  async generateStory(params: GenerateStoryRequest): Promise<GenerateStoryResponse> {\n    const startTime = Date.now();\n\n    // Calculate age group for adaptive prompting\n    const ageGroup = this.calculateAgeGroup(params.childAge);\n\n    // Build the prompt\n    const prompt = this.buildPrompt(params, ageGroup);\n\n    // Execute generation with retry logic\n    const result = await retryWithBackoff(\n      async () => {\n        // Get the generative model with configuration\n        const generativeModel = this.vertexAI.preview.getGenerativeModel({\n          model: this.model,\n          generationConfig: {\n            temperature: 0.7,\n            maxOutputTokens: 2000,\n            responseMimeType: 'application/json', // AC2: Structured JSON output\n          },\n          safetySettings: this.getSafetySettings(), // AC3: Safety configuration\n        });\n\n        // Generate content\n        const response = await generativeModel.generateContent(prompt);\n        return response;\n      },\n      {\n        maxRetries: 3, // AC4: Max 3 retries\n        initialDelayMs: 1000, // AC4: 1s, 2s, 4s delays\n      }\n","exit_code":0,"status":"completed"}}
