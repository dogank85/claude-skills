\n    46\t        images: {\n    47\t          orderBy: { sceneNumber: 'asc' },\n    48\t          select: {\n    49\t            sceneNumber: true,\n    50\t            publicUrl: true,\n    51\t          },\n    52\t        },\n    53\t      },\n    54\t    });\n    55\t\n    56\t    if (!story) {\n    57\t      // Update export job with error\n    58\t      await db.storyExport.update({\n    59\t        where: { id: exportId },\n    60\t        data: {\n    61\t          status: 'failed',\n    62\t          errorMessage: 'Story not found',\n    63\t          completedAt: new Date(),\n    64\t        },\n    65\t      });\n    66\t\n    67\t      return NextResponse.json({ error: 'Story not found' }, { status: 404 });\n    68\t    }\n    69\t\n    70\t    // Parse story content to extract scenes\n    71\t    const storyContent = story.content ? JSON.parse(story.content) : { scenes: [] };\n    72\t    const scenes = storyContent.scenes.map((scene: any) => ({\n    73\t      sceneNumber: scene.sceneNumber,\n    74\t      text: scene.text,\n    75\t      imageUrl: story.images.find((img) => img.sceneNumber === scene.sceneNumber)?.publicUrl || '',\n    76\t    }));\n    77\t\n    78\t    // 2. Render PDF using StoryPDF component\n    79\t    const pdfBuffer = await renderToBuffer(\n    80\t      <StoryPDF\n    81\t        story={{\n    82\t          title: story.title,\n    83\t          coverImageUrl: story.coverImageUrl || undefined,\n    84\t          scenes,\n    85\t        }}\n    86\t      />\n    87\t    );\n    88\t\n    89\t    // 3. Upload to Supabase Storage\n    90\t    const fileName = `${exportId}.pdf`;\n    91\t    const { data: uploadData, error: uploadError } = await supabase.storage\n    92\t      .from('story-pdfs')\n    93\t      .upload(fileName, pdfBuffer, {\n    94\t        contentType: 'application/pdf',\n    95\t        cacheControl: '3600',\n    96\t        upsert: true,\n    97\t      });\n    98\t\n    99\t    if (uploadError) {\n   100\t  