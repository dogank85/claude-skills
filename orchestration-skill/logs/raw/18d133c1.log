{"type":"item.completed","item":{"id":"item_128","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/api/src/routers/credits.ts | sed -n '1,220p'\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n     1\t/**\n     2\t * Credits Router - Credit-Based Monetization System\n     3\t *\n     4\t * Handles credit pack purchases and credit transactions.\n     5\t * Replaces subscription-based model with pay-per-story credit system.\n     6\t *\n     7\t * Monetization Model:\n     8\t * - FREE: 1 avatar generation, 0 stories\n     9\t * - PAID: Credit packs at $0.99 per credit (1/5/10 credit packs)\n    10\t * - Each credit = 1 personalized story + PDF download\n    11\t */\n    12\t\n    13\timport { z } from 'zod';\n    14\timport { TRPCError } from '@trpc/server';\n    15\timport { createTRPCRouter, protectedProcedure } from '../trpc';\n    16\timport axios from 'axios';\n    17\timport { google } from 'googleapis';\n    18\timport { apiEnv } from '../env';\n    19\t\n    20\t// ========================================\n    21\t// SCHEMAS\n    22\t// ========================================\n    23\t\n    24\tconst purchaseCreditsSchema = z.object({\n    25\t  credits: z.number().int().positive().refine(val => [1, 5, 10].includes(val), {\n    26\t    message: 'Credits must be 1, 5, or 10',\n    27\t  }),\n    28\t  platform: z.enum(['STRIPE', 'APPLE', 'GOOGLE']),\n    29\t\n    30\t  // Platform-specific fields\n    31\t  appleTransactionId: z.string().optional(),\n    32\t  googleOrderId: z.string().optional(),\n    33\t  stripePaymentId: z.string().optional(),\n    34\t});\n    35\t\n    36\tconst deductCreditSchema = z.object({\n    37\t  storyId: z.string().uuid().optional(),\n    38\t  childId: z.string().uuid().optional(),\n    39\t  reason: z.enum(['STORY', 'AVATAR', 'PET']).default('STORY'),\n    40\t  credits: z.number().int().positive().default(1),\n    41\t});\n    42\t\n    43\t// Helper function to get balance\n    44\tasync function getCreditBalance(ctx: any, parentId: string) {\n    45\t  const parent = await ctx.prisma.parent.findUnique({\n    46\t    where: { id: parentId },\n    47\t    select: { creditBalance: true },\n    48\t  });\n    49\t  return parent?.creditBalance ?? 0;\n    50\t}\n    51\t\n    52\texport const creditsRouter = createTRPCRouter({\n    53\t  purchaseCredits: protectedProcedure\n    54\t    .input(purchaseCreditsSchema)\n    55\t    .mutation(async ({ input, ctx }) => {\n    56\t      const parent = await ctx.prisma.parent.findUnique({\n    57\t        where: { supabaseUserId: ctx.viewer.id },\n    58\t        select: { id: true },\n    59\t      });\n    60\t\n    61\t      if (!parent) {\n    62\t        throw new TRPCError({\n    63\t          code: 'NOT_FOUND',\n    64\t          message: 'Parent account not found',\n    65\t        });\n    66\t      }\n    67\t\n    68\t      // Mock purchase for now\n    69\t      const result = await ctx.prisma.$transaction(async (tx) => {\n    70\t        const creditPack = await tx.creditPack.create({\n    71\t          data: {\n    72\t            parentId: parent.id,\n    73\t            credits: input.credits,\n    74\t            price: input.credits * 0.99,\n    75\t            platform: input.platform,\n    76\t            stripePaymentId: input.stripePaymentId,\n    77\t            appleTransactionId: input.appleTransactionId,\n    78\t            googleOrderId: input.googleOrderId,\n    79\t          },\n    80\t        });\n    81\t\n    82\t        await tx.creditTransaction.create({\n    83\t          data: {\n    84\t            parentId: parent.id,\n    85\t            credits: input.credits,\n    86\t            type: 'PURCHASE',\n    87\t            description: `Purchased ${input.credits} credits via ${input.platform}`,\n    88\t          },\n    89\t        });\n    90\t\n    91\t        const updatedParent = await tx.parent.update({\n    92\t          where: { id: parent.id },\n    93\t          data: {\n    94\t            creditBalance: { increment: input.credits },\n    95\t          },\n    96\t          select: { creditBalance: true },\n    97\t        });\n    98\t\n    99\t        return { creditPack, newBalance: updatedParent.creditBalance };\n   100\t      });\n   101\t\n   102\t      return {\n   103\t        success: true,\n   104\t        credits: input.credits,\n   105\t        balance: result.newBalance,\n   106\t      };\n   107\t    }),\n   108\t\n   109\t  getBalance: protectedProcedure.query(async ({ ctx }) => {\n   110\t    const parent = await ctx.prisma.parent.findUnique({\n   111\t      where: { supabaseUserId: ctx.viewer.id },\n   112\t      select: { id: true, creditBalance: true },\n   113\t    });\n   114\t\n   115\t    if (!parent) {\n   116\t      throw new TRPCError({\n   117\t        code: 'NOT_FOUND',\n   118\t        message: 'Parent account not found',\n   119\t      });\n   120\t    }\n   121\t\n   122\t    const childProfiles = await ctx.prisma.childProfile.findMany({\n   123\t      where: { parentId: parent.id }, // Removed deletedAt: null to include deleted children\n   124\t      select: { id: true, avatarsGenerated: true, createdAt: true },\n   125\t      orderBy: { createdAt: 'asc' },\n   126\t    });\n   127\t\n   128\t    // First child is determined by creation order (earliest createdAt)\n   129\t    const firstChild = childProfiles[0];\n   130\t\n   131\t    // Check if the first child (even if deleted) has used their free generation\n   132\t    // If the first child is deleted, no one gets free generation (strict rule)\n   133\t    // OR: If the first child is active, they get it.\n   134\t    // The requirement is \"ONLY the first child of a parent account gets free avatar + pet\"\n   135\t\n   136\t    // We need to return the ID of the first child so the UI knows WHO is free\n   137\t    const firstChildId = firstChild?.id;\n   138\t\n   139\t    // We also need to know if that specific first child has already used it\n   140\t    const hasFreeAvatarGeneration = firstChild ? !firstChild.avatarsGenerated : false;\n   141\t\n   142\t    return {\n   143\t      credits: parent.creditBalance,\n   144\t      hasFreeAvatarGeneration,\n   145\t      firstChildId, // New field for UI to identify which child is free\n   146\t    };\n   147\t  }),\n   148\t\n   149\t  /**\n   150\t   * Deduct credit when story or avatar is generated\n   151\t   * Called by client or service\n   152\t   */\n   153\t  deductCredit: protectedProcedure\n   154\t    .input(deductCreditSchema)\n   155\t    .mutation(async ({ input, ctx }) => {\n   156\t      const parent = await ctx.prisma.parent.findUnique({\n   157\t        where: { supabaseUserId: ctx.viewer.id },\n   158\t        select: { id: true },\n   159\t      });\n   160\t\n   161\t      if (!parent) {\n   162\t        throw new TRPCError({\n   163\t          code: 'NOT_FOUND',\n   164\t          message: 'Parent account not found',\n   165\t        });\n   166\t      }\n   167\t\n   168\t      // Validate input based on reason\n   169\t      if (input.reason === 'STORY' && !input.storyId) {\n   170\t        throw new TRPCError({\n   171\t          code: 'BAD_REQUEST',\n   172\t          message: 'storyId required for STORY deduction',\n   173\t        });\n   174\t      }\n   175\t      if ((input.reason === 'AVATAR' || input.reason === 'PET') && !input.childId) {\n   176\t        throw new TRPCError({\n   177\t          code: 'BAD_REQUEST',\n   178\t          message: 'childId required for AVATAR/PET deduction',\n   179\t        });\n   180\t      }\n   181\t\n   182\t      try {\n   183\t        // Wrap balance check and deduction in transaction for atomicity\n   184\t        const result = await ctx.prisma.$transaction(async (tx) => {\n   185\t          // Get current balance from parent record\n   186\t          const parentRecord = await tx.parent.findUnique({\n   187\t            where: