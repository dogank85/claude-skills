{"type":"item.completed","item":{"id":"item_86","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' apps/web/app/api/webhooks/stripe/route.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Stripe webhook handler\n * Processes credit pack purchases; legacy subscription events are logged and ignored.\n * @module api/webhooks/stripe\n */\n\nimport { NextRequest, NextResponse } from 'next/server';\nimport Stripe from 'stripe';\nimport { prisma } from '@herokid/database';\n\n// Validate required environment variables at module load time\nif (!process.env.STRIPE_SECRET_KEY) {\n  throw new Error('CRITICAL: STRIPE_SECRET_KEY environment variable is not configured');\n}\n\nif (!process.env.STRIPE_WEBHOOK_SECRET) {\n  throw new Error('CRITICAL: STRIPE_WEBHOOK_SECRET environment variable is not configured');\n}\n\nconst stripe = new Stripe(process.env.STRIPE_SECRET_KEY, {\n  apiVersion: '2024-11-20.acacia',\n  typescript: true,\n});\n\nconst webhookSecret = process.env.STRIPE_WEBHOOK_SECRET;\n\n/**\n * POST handler for Stripe webhooks\n * Verifies signature and routes events to appropriate handlers\n *\n * SECURITY:\n * - ALWAYS verifies Stripe webhook signature (no bypass)\n * - Fails immediately if STRIPE_WEBHOOK_SECRET is not configured\n * - Returns 401 if signature is missing or invalid\n */\nexport async function POST(request: NextRequest) {\n  const body = await request.text();\n  const signature = request.headers.get('stripe-signature');\n\n  if (!signature) {\n    // Return 401 for missing signature (no logging to prevent info disclosure)\n    return NextResponse.json({ error: 'Missing signature' }, { status: 401 });\n  }\n\n  let event: Stripe.Event;\n\n  try {\n    // Verify webhook signature - this will throw if signature is invalid\n    event = stripe.webhooks.constructEvent(body, signature, webhookSecret);\n  } catch (err) {\n    // Signature verification failed - return 401 without exposing details\n    return NextResponse.json(\n      { error: 'Invalid signature' },\n      { status: 401 }\n    );\n  }\n\n  try {\n    // Route event to appropriate handler\n    switch (event.type) {\n      case 'checkout.session.completed':\n        await handleCheckoutCompleted(event.data.object as Stripe.Checkout.Session);\n        break;\n\n      case 'customer.subscription.updated':\n      case 'customer.subscription.deleted':\n      case 'invoice.paid':\n      case 'invoice.payment_failed':\n        console.info('Ignoring legacy Stripe subscription webhook (credit-first system)', {\n          type: event.type,\n        });\n        break;\n\n      case 'payment_intent.succeeded':\n        await handlePaymentIntentSucceeded(event.data.object as Stripe.PaymentIntent);\n        break;\n\n      default:\n        // Unhandled event type - acknowledge but don't process\n        break;\n    }\n\n    return NextResponse.json({ received: true });\n  } catch (err) {\n    // Return 500 so Stripe will retry\n    // Error details are already logged in audit log within handler functions\n    return NextResponse.json(\n      { error: 'Webhook processing failed' },\n      { status: 500 }\n    );\n  }\n}\n\n/**\n * Handle checkout.session.completed event\n * Handles credit pack purchases; legacy subscription checkouts are acknowledged only\n */\nasync function handleCheckoutCompleted(session: Stripe.Checkout.Session) {\n  const parentId = session.client_reference_id!;\n\n  // Check if this is a credit pack purchase (one-time payment)\n  if (session.mode === 'payment' && session.metadata?.credits) {\n    await handleCreditPackPurchase(session);\n    return;\n  }\n\n  // Legacy subscription checkout flow (deprecated). Keep acknowledgement but do not create records.\n  console.info('Received legacy Stripe subscription checkout; skipping (credit model only)', {\n    parentId,\n    sessionId: session.id,\n  });\n}\n\n/**\n * Handle credit pack purchase (Story 6.12)\n * Creates CreditPack record and updates parent balance\n */\nasync function handleCreditPackPurchase(session: Stripe.Checkout.Session) {\n  const parentId = session.metadata?.parentId || session.client_reference_id!;\n  const credits = parseInt(session.metadata?.credits || '0', 10);\n\n  if (!parentId || !credits || ![1, 5, 10].includes(credits)) {\n    throw new Error(`Invalid credit pack purchase metadata: parentId=${parentId}, credits=${credits}`);\n  }\n\n  // Check for duplicate processing (idempotency)\n  const existingPack = await prisma.creditPack.findFirst({\n    where: { stripePaymentId: session.payment_intent as string },\n  });\n\n  if (existingPack) {\n    // Already processed - idempotent return\n    return;\n  }\n\n  // Process purchase in transaction\n  await prisma.$transaction(async (tx) => {\n    // Create credit pack record\n    const creditPack = await tx.creditPack.create({\n      data: {\n        parentId,\n        credits,\n        price: (session.amount_total || 0) / 100, // Convert from cents\n        platform: 'STRIPE',\n        stripePaymentId: session.payment_intent as string,\n      },\n    });\n\n    // Create credit transaction\n    await tx.creditTransaction.create({\n      data: {\n        parentId,\n        credits,\n        type: 'PURCHASE',\n        description: `Stripe purchase: ${credits} ${credits === 1 ? 'credit' : 'credits'}`,\n      },\n    });\n\n    // Update parent's credit balance atomically\n    const updatedParent = await tx.parent.update({\n      where: { id: parentId },\n      data: {\n        creditBalance: {\n          increment: credits,\n        },\n      },\n      select: { creditBalance: true },\n    });\n\n    // Create audit log\n    await tx.auditLog.create({\n      data: {\n        actorParentId: parentId,\n        action: 'credit_purchase_completed',\n        entityType: 'credit_pack',\n        entityId: creditPack.id,\n        metadata: {\n          credits,\n          price: (session.amount_total || 0) / 100,\n          platform: 'STRIPE',\n          sessionId: session.id,\n          newBalance: updatedParent.creditBalance,\n        },\n      },\n    });\n  });\n}\n\n/**\n * Handle payment_intent.succeeded for credit pack purchases\n * Alternative webhook for credit pack fulfillment\n */\nasync function handlePaymentIntentSucceeded(paymentIntent: Stripe.PaymentIntent) {\n  // Only process if this is a credit pack purchase (has metadata)\n  if (!paymentIntent.metadata?.parentId || !paymentIntent.metadata?.credits) {\n    return; // Not a credit pack purchase, ignore\n  }\n\n  const parentId = paymentIntent.metadata.parentId;\n  const credits = parseInt(paymentIntent.metadata.credits, 10);\n\n  // Check for duplicate processing (idempotency)\n  const existingPack = await prisma.creditPack.findFirst({\n    where: { stripePaymentId: paymentIntent.id },\n  });\n\n  if (existingPack) {\n    // Already processed - idempotent return\n    return;\n  }\n\n  // Process purchase in transaction\n  await prisma.$transaction(async (tx) => {\n    // Create credit pack record\n    const creditPack = await tx.creditPack.create({\n      data: {\n        parentId,\n        credits,\n        price: paymentIntent.amount / 100, // Convert from cents\n        platform: 'STRIPE',\n        stripePaymentId: paymentIntent.id,\n      },\n    });\n\n    // Create credit transaction\n    await tx.creditTransaction.create({\n      data: {\n        parentId,\n        credits,\n        type: 'PURCHASE',\n        description: `Stripe purchase: ${credits} ${credits === 1 ? 'credit' : 'credits'}`,\n      },\n    });\n\n    // Update parent's credit balance atomically\n    const updatedParent = await tx.parent.update({\n      where: { id: parentId },\n      data: {\n        creditBalance: {\n          increment: credits,\n","exit_code":0,"status":"completed"}}
