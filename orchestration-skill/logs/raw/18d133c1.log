{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"sed -n '430,560p' packages/api/src/routers/auth.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n          ipAddress: ip,\n        });\n\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'An unexpected error occurred',\n        });\n      }\n    }),\n\n  /**\n   * Login endpoint\n   * Signs in a parent using email and password.\n   * Validates credentials, enforces email verification, and returns session tokens.\n   * Rate limited to 5 attempts per email/IP per 15 minutes.\n   */\n  login: publicProcedure\n    .input(authSchemas.loginInput)\n    .mutation(async ({ ctx, input }) => {\n      const ipAddress = extractIpAddress(ctx.requestHeaders) ?? 'unknown';\n      const rateLimitKey = `auth:login:${ipAddress}:${input.email}`;\n\n      // 1. Check rate limiting - 5 attempts per email/IP per 15 minutes\n      try {\n        rateLimiter.assertWithinLimit(rateLimitKey, RATE_LIMITS.AUTH_LOGIN.limit, RATE_LIMITS.AUTH_LOGIN.windowMs);\n      } catch (error) {\n        // Log failed rate limit check\n        await createAuditLog(ctx.prisma, {\n          action: 'login_rate_limited',\n          entityType: 'parent',\n          metadata: {\n            email_hash: hashEmail(input.email),\n            ip: ipAddress,\n          },\n          ipAddress,\n        });\n        throw new TRPCError({\n          code: 'TOO_MANY_REQUESTS',\n          message: 'Too many login attempts. Please try again later.',\n        });\n      }\n\n      // 2. Validate Supabase is configured\n      if (!ctx.supabase) {\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Authentication service is not configured. Please contact support.',\n        });\n      }\n\n      // 3. Attempt to sign in with Supabase\n      let supabaseSession;\n      try {\n        const { data, error } = await ctx.supabase.auth.signInWithPassword({\n          email: input.email,\n          password: input.password,\n        });\n\n        if (error || !data?.session || !data?.user) {\n          // Log failed login attempt\n          await createAuditLog(ctx.prisma, {\n            action: 'login_failed',\n            entityType: 'parent',\n            metadata: {\n              email_hash: hashEmail(input.email),\n              reason: 'invalid_credentials',\n              error: error?.message,\n            },\n            ipAddress,\n          });\n\n          throw new TRPCError({\n            code: 'UNAUTHORIZED',\n            message: 'Invalid email or password.',\n            cause: error,\n          });\n        }\n\n        supabaseSession = data.session;\n      } catch (error) {\n        if (error instanceof TRPCError) {\n          throw error;\n        }\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to authenticate. Please try again.',\n          cause: error,\n        });\n      }\n\n      // 4. Find the parent record\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: supabaseSession.user.id },\n        select: {\n          id: true,\n          email: true,\n          status: true,\n          consentAt: true,\n        },\n      });\n\n      if (!parent) {\n        await createAuditLog(ctx.prisma, {\n          action: 'login_failed',\n          entityType: 'parent',\n          metadata: {\n            email_hash: hashEmail(input.email),\n            reason: 'parent_not_found',\n          },\n          ipAddress,\n        });\n\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Account not found. Please register first.',\n        });\n      }\n\n      // 5. Check account status\n      if (parent.status !== 'ACTIVE') {\n        await createAuditLog(ctx.prisma, {\n          action: 'login_failed',\n          actorParentId: parent.id,\n          entityType: 'parent',\n          entityId: parent.id,\n          metadata: {\n            reason: 'account_not_active',\n            status: parent.status,\n          },\n          ipAddress,\n        });\n","exit_code":0,"status":"completed"}}
