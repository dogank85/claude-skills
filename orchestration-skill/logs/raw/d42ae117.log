{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cd /Users/dogankarakaya/LocalProjects/HeroKid && sed -n '240,480p' packages/api/src/routers/story.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n      await tx.creditTransaction.update({\n        where: { id: reservationTransactionId },\n        data: {\n          description: `Story generation reservation (${job.id})`,\n        },\n      });\n    }\n\n    if (firstFreeCreditId) {\n      await tx.creditTransaction.update({\n        where: { id: firstFreeCreditId },\n        data: {\n          description: `FIRST_FREE_STORY_LOCK:${job.id}`,\n        },\n      });\n    }\n\n    return {\n      jobId: job.id,\n      appliedCost,\n      reservationTransactionId,\n      firstFreeCreditId,\n      creditsRemaining: updatedParent?.creditBalance ?? 0,\n    };\n  });\n}\n\nexport const storyRouter = createTRPCRouter({\n  /**\n   * Generate Story - Initiate async story generation\n   * Story 6.11: Reserve credits BEFORE generation, commit/refund AFTER success/failure\n   */\n  generateStory: protectedProcedure\n    .input(generateStorySchema)\n    .mutation(async ({ input, ctx }) => {\n      const { childProfileId, adventureTemplate, includePet, artStyle, isGeneric } = input;\n      const STORY_COST = isGeneric ? 0 : 10;\n\n      // 1. Verify ownership without mutating credits (reservation handles deduction)\n      const { parentId, childProfile } = await verifyParentOwnership(ctx, childProfileId, 0, '');\n\n      // 2. Verify avatars exist (only for personalized stories)\n      if (!isGeneric && !childProfile.avatarsGenerated) {\n        throw new TRPCError({\n          code: 'PRECONDITION_FAILED',\n          message: 'Please create avatars first before generating stories',\n        });\n      }\n\n      // 3. Determine art style (use input or fallback to preferred)\n      const selectedArtStyle = artStyle || childProfile.preferredArtStyle || 'pixar';\n\n      // 4. Reserve credits atomically with job creation (prevents race conditions)\n      const reservation = await reserveCreditsForStory({\n        ctx,\n        parentId,\n        childProfileId,\n        adventureTemplate,\n        artStyle: selectedArtStyle,\n        includePet,\n        cost: STORY_COST,\n      });\n\n      // 5. Start async generation (fire and forget)\n      // The async function handles its own error logging and job status updates\n      // It now also handles REFUNDS if generation fails\n      generateStoryAsync({\n        generationId: reservation.jobId,\n        parentId,\n        childProfile: {\n          id: childProfile.id,\n          name: childProfile.name,\n          birthMonth: childProfile.birthMonth,\n          birthYear: childProfile.birthYear,\n          avatars: childProfile.avatars,\n          petCompanions: childProfile.petCompanions,\n        },\n        adventureTemplate: input.adventureTemplate,\n        includePet: input.includePet,\n        artStyle: input.artStyle,\n        cost: reservation.appliedCost, // Pass applied cost for potential refund\n        creditReservationId: reservation.reservationTransactionId,\n        firstFreeCreditId: reservation.firstFreeCreditId,\n      }).catch((error) => {\n        console.error('Background story generation failed:', error);\n      });\n\n      return {\n        success: true,\n        jobId: reservation.jobId,\n        creditsRemaining: reservation.creditsRemaining,\n        firstFree: reservation.appliedCost === 0 && STORY_COST > 0,\n      };\n    }),\n\n  /**\n   * Get Generation Status - Poll for generation progress\n   */\n  getGenerationStatus: protectedProcedure\n    .input(getGenerationStatusSchema)\n    .query(async ({ input, ctx }) => {\n      const { generationId } = input;\n\n      // Fetch generation job\n      const job = await ctx.prisma.storyGenerationJob.findUnique({\n        where: { id: generationId },\n        select: {\n          id: true,\n          status: true,\n          progress: true,\n          storyId: true,\n          errorMessage: true,\n        },\n      });\n\n      if (!job) {\n        throw new TRPCError({ code: 'NOT_FOUND', message: 'Generation job not found' });\n      }\n\n      return {\n        status: job.status as any,\n        progress: calculateProgress(job.status),\n        storyId: job.storyId || undefined,\n        error: job.errorMessage || undefined,\n      };\n    }),\n\n  /**\n   * Get Story - Retrieve complete story with all scenes\n   */\n  getStory: protectedProcedure.input(getStorySchema).query(async ({ input, ctx }) => {\n    const { storyId } = input;\n\n    // Fetch story with images\n    const story = await ctx.prisma.story.findUnique({\n      where: { id: storyId },\n      select: {\n        id: true,\n        title: true,\n        childProfileId: true,\n        adventureType: true,\n        artStyle: true,\n        includedPet: true,\n        ageGroup: true,\n        wordCount: true,\n        storyContent: true,\n        generationCost: true,\n        generationTimeMs: true,\n        createdAt: true,\n        images: {\n          select: {\n            sceneNumber: true,\n            publicUrl: true,\n          },\n          orderBy: {\n            sceneNumber: 'asc',\n          },\n        },\n      },\n    });\n\n    if (!story) {\n      throw new TRPCError({ code: 'NOT_FOUND', message: 'Story not found' });\n    }\n\n    // Verify ownership\n    await verifyChildProfileOwnership(ctx, story.childProfileId!);\n\n    // Build scenes from story_content and images\n    const storyContent = story.storyContent as { scenes: Array<{ sceneNumber: number; text: string }> };\n    const scenes = (storyContent?.scenes || []).map((scene) => ({\n      sceneNumber: scene.sceneNumber,\n      text: scene.text,\n      imageUrl: story.images.find((img) => img.sceneNumber === scene.sceneNumber)?.publicUrl || '',\n    }));\n\n    return {\n      id: story.id,\n      title: story.title,\n      adventureType: story.adventureType as any,\n      artStyle: story.artStyle as any,\n      includedPet: story.includedPet,\n      ageGroup: (story.ageGroup as any) || '5-7',\n      wordCount: story.wordCount || 0,\n      scenes,\n      metadata: {\n        generatedAt: story.createdAt,\n        generationTimeMs: story.generationTimeMs || 30000,\n        generationCost: Number(story.generationCost),\n      },\n    };\n  }),\n\n  /**\n   * List Stories - Get all stories for a child profile\n   */\n  listStories: protectedProcedure.input(listStoriesSchema).query(async ({ input, ctx }) => {\n    const { childProfileId, sortBy, limit, offset } = input;\n\n    // Verify ownership\n    await verifyChildProfileOwnership(ctx, childProfileId);\n\n    // Build safe order by clause using Prisma's type-safe orderBy\n    // Favorites sorting uses related field ordering (database-level)\n    const orderByClause: any[] = [];\n    if (sortBy === 'favorites') {\n      orderByClause.push(\n        { metadata: { favorited: 'desc' } },\n        { createdAt: 'desc' }\n      );\n    } else if (sortBy === 'adventure_type') {\n      orderByClause.push({ adventureType: 'asc' }, { createdAt: 'desc' });\n    } else {\n      orderByClause.push({ createdAt: 'desc' });\n    }\n\n    // Fetch stories with metadata and progress\n    const stories = await ctx.prisma.story.findMany({\n      where: { childProfileId },\n      select: {\n        id: true,\n        title: true,\n        adventureType: true,\n        coverImageUrl: true,\n        createdAt: true,\n        metadata: {\n          select: {\n            favorited: true,\n          },\n        },\n        progress: {\n          where: {\n            childProfileId,\n          },\n          select: {\n            completed: true,\n          },\n        },\n      },\n      orderBy: orderByClause,\n      take: limit,\n","exit_code":0,"status":"completed"}}
