{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"cd /Users/dogankarakaya/LocalProjects/HeroKid && sed -n '1,200p' packages/api/src/trpc.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { initTRPC, TRPCError } from '@trpc/server';\nimport superjson from 'superjson';\nimport type { Context } from './context';\nimport { isAllowlistedAdminEmail } from './utils/admin';\n\nconst t = initTRPC.context<Context>().create({\n  transformer: superjson,\n});\n\nexport const createTRPCRouter = t.router;\nexport const publicProcedure = t.procedure;\n\nconst enforceViewer = t.middleware(({ ctx, next }) => {\n  if (!ctx.viewer) {\n    throw new TRPCError({ code: 'UNAUTHORIZED', message: 'Authentication required.' });\n  }\n\n  return next({\n    ctx: {\n      viewer: ctx.viewer,\n      prisma: ctx.prisma,\n      supabase: ctx.supabase,\n      env: ctx.env,\n      requestHeaders: ctx.requestHeaders,\n      requestIp: ctx.requestIp,\n    },\n  });\n});\n\nexport const protectedProcedure = t.procedure.use(enforceViewer);\n\nconst enforceAdmin = t.middleware(async ({ ctx, next }) => {\n  if (!ctx.viewer) {\n    throw new TRPCError({ code: 'UNAUTHORIZED', message: 'Authentication required.' });\n  }\n\n  const parent = await ctx.prisma.parent.findUnique({\n    where: { supabaseUserId: ctx.viewer.id },\n    select: {\n      id: true,\n      email: true,\n      status: true,\n      role: true,\n    },\n  });\n\n  if (!parent) {\n    throw new TRPCError({ code: 'FORBIDDEN', message: 'Admin profile not found.' });\n  }\n\n  const isAllowlisted = isAllowlistedAdminEmail(ctx.env.adminEmails, parent.email);\n\n  if (isAllowlisted && parent.role !== 'ADMIN') {\n    await ctx.prisma.parent.update({\n      where: { id: parent.id },\n      data: { role: 'ADMIN' },\n    });\n    parent.role = 'ADMIN';\n  }\n\n  if (parent.status !== 'ACTIVE') {\n    throw new TRPCError({ code: 'FORBIDDEN', message: 'Admin account is not active.' });\n  }\n\n  if (parent.role !== 'ADMIN') {\n    throw new TRPCError({ code: 'FORBIDDEN', message: 'Admin access required.' });\n  }\n\n  return next({\n    ctx: {\n      ...ctx,\n      admin: {\n        parentId: parent.id,\n        email: parent.email,\n        role: parent.role,\n      },\n    },\n  });\n});\n\nexport const adminProcedure = t.procedure.use(enforceAdmin);\n","exit_code":0,"status":"completed"}}
