e = existingProgress\n      ? Math.max(existingProgress.farthestScene, currentScene)\n      : currentScene;\n\n    // Upsert progress using Prisma's upsert\n    await ctx.prisma.storyProgress.upsert({\n      where: {\n        storyId_childProfileId: {\n          storyId,\n          childProfileId,\n        },\n      },\n      create: {\n        storyId,\n        childProfileId,\n        currentScene,\n        farthestScene: currentScene,\n        completed: completed || false,\n        completedAt: completed ? new Date() : null,\n      },\n      update: {\n        currentScene,\n        farthestScene: newFarthestScene,\n        completed: completed || false,\n        completedAt: completed ? new Date() : undefined,\n        updatedAt: new Date(),\n      },\n    });\n\n    return {\n      success: true,\n      currentScene,\n      completed: completed || false,\n    };\n  }),\n\n  /**\n   * Report Inappropriate Content (Story 4.5)\n   *\n   * Allows parents to report stories that contain inappropriate content.\n   */\n  reportInappropriate: protectedProcedure\n    .input(\n      z.object({\n        storyId: z.string().uuid(),\n        reason: z\n          .string()\n          .min(1, 'Reason is required')\n          .max(500, 'Reason must be less than 500 characters'),\n        details: z\n          .string()\n          .max(2000, 'Details must be less than 2000 characters')\n          .optional(),\n      })\n    )\n    .mutation(async ({ input, ctx }) => {\n      // 1. Verify parent is authenticated and active\n      const parent = await assertAuthenticatedParent(ctx);\n\n      // 2. Verify parent owns the story\n      const story = await assertStoryOwnership(ctx, input.storyId, parent.id);\n\n      // 3. Create safety incident record in a transaction\n      const result = await ctx.prisma.$transaction(async (tx: any) => {\n        // Create safety incident\n        const incident = await tx.storySafetyIncident.create({\n          data: {\n            storyId: input.storyId,\n            issueType: 'PARENT_REPORTED',\n            status: 'PENDING',\n            flaggedContent: {\n              reason: input.reason,\n              details: input.details || null,\n              reportedBy: parent.id,\n              reportedAt: new Date().toISOString(),\n            },\n            resolution: 'MANUAL_REVIEW',\n            timestamp: new Date(),\n          },\n        });\n\n        // Get or create story metadata and flag the story\n        const metadata = await tx.storyMetadata.upsert({\n          where: { storyId: input.storyId },\n          create: {\n            storyId: input.storyId,\n            childProfileId: story.childProfileId!,\n            flagged: true,\n            flagReason: input.reason,\n          },\n          update: {\n            flagged: true,\n            flagReason: input.reason,\n          },\n        });\n\n        // Log audit event\n        await tx.auditLog.create({\n          data: {\n            actorParentId: parent.id,\n            action: 'REPORT_STORY_INAPPROPRIATE',\n            entityType: 'Story',\n            entityId: input.storyId,\n            metadata: {\n              incidentId: incident.id,\n              reason: input.reason,\n              details: input.details,\n            },\n          },\n        });\n\n        return {\n          incidentId: incident.id,\n          ticketId: incident.id,\n        };\n      });\n\n      return {\n        success: true,\n        ticketId: result.ticketId,\n        message:\n          'Thank you for your report. Our content team will review this story within 24 hours.',\n      };\n    }),\n\n  /**\n   * Get Story Safety Status\n   */\n  getSafetyStatus: protectedProcedure\n    .input(z.object({ storyId: z.string().uuid() }))\n    .query(async ({ input, ctx }) => {\n      const parent = await assertAuthenticatedParent(ctx);\n      await assertStoryOwnership(ctx, input.storyId, parent.id);\n\n      const metadata = await ctx.prisma.storyMetadata.findUnique({\n        where: { storyId: input.storyId },\n        select: {\n          flagged: true,\n          flagReason: true,\n          textSafetyScore: true,\n          avgImageSafetyScore: true,\n        },\n      });\n\n      const incidents = await ctx.prisma.storySafetyIncident.findMany({\n        where: { storyId: input.storyId },\n        select: {\n          id: true,\n          issueType: true,\n          status: true,\n          resolution: true,\n          timestamp: true,\n          resolvedAt: true,\n        },\n        orderBy: { timestamp: 'desc' },\n      });\n\n      return {\n        flagged: metadata?.flagged || false,\n        flagReason: metadata?.flagReason,\n        safetyScores: {\n          text: metadata?.textSafetyScore,\n          images: metadata?.avgImageSafetyScore,\n        },\n        incidents: incidents.map((incident) => ({\n          id: incident.id,\n          issueType: incident.issueType,\n          status: incident.status,\n          resolution: incident.resolution,\n          timestamp: incident.timestamp,\n          resolvedAt: incident.resolvedAt,\n        })),\n      };\n    }),\n\n  /**\n   * Get Public Story - Retrieve a generic or public story (No auth required)\n   */\n  getPublicStory: publicProcedure\n    .input(z.object({ storyId: z.string().uuid() }))\n    .query(async ({ input, ctx }) => {\n      const story = await ctx.prisma.story.findFirst({\n        where: {\n          id: input.storyId,\n          OR: [{ isGeneric: true }, { isPublic: true }],\n        },\n        select: {\n          id: true,\n          title: true,\n          adventureType: true,\n          artStyle: true,\n          includedPet: true,\n          ageGroup: true,\n          wordCount: true,\n          storyContent: true,\n          generationCost: true,\n          generationTimeMs: true,\n          createdAt: true,\n        },\n      });\n\n      if (!story) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Story not found or not public',\n        });\n      }\n\n      // Fetch scene images\n      const images = await ctx.prisma.storyImage.findMany({\n        where: { storyId: input.storyId },\n        orderBy: { sceneNumber: 'asc' },\n        select: {\n          sceneNumber: true,\n          publicUrl: true,\n        },\n      });\n\n      // Build scenes\n      const storyContent = story.storyContent as { scenes: Array<{ sceneNumber: number; text: string }> };\n      const scenes = (storyContent?.scenes || []).map((scene) => ({\n        sceneNumber: scene.sceneNumber,\n        text: scene.text,\n        imageUrl: images.find((img) => img.sceneNumber === scene.sceneNumber)?.publicUrl || '',\n      }));\n\n      return {\n        id: story.id,\n        title: story.title,\n        adventureType: story.adventureType,\n        artStyle: story.artStyle,\n        includedPet: story.includedPet,\n        ageGroup: story.ageGroup || '5-7',\n        wordCount: story.wordCount,\n        scenes,\n        metadata: {\n          generatedAt: story.createdAt,\n          generationTimeMs: story.generationTimeMs || 30000,\n          generationCost: Number(story.generationCost),\n        },\n      };\n    }),\n\n  /**\n   * List Public Stories - Get all generic stories (No auth required)\n   */\n  listPublicStories: publicProcedure\n    .input(\n      z.object({\n        limit: z.number().min(1).max(50).default(10),\n        offset: z.number().min(0).default(0),\n      })\n    )\n    .query(async ({ input, ctx }) => {\n      const stories = await ctx.prisma.story.findMany({\n        where: { isGeneric: true },\n        orderBy: { createdAt: 'desc' },\n        take: input.limit,\n        skip: input.offset,\n        select: {\n          id: true,\n          title: true,\n          adventureType: true,\n          coverImageUrl: true,\n          createdAt: true,\n        },\n      });\n\n      const totalCount = await ctx.prisma.story.count({\n        where: { isGeneric: true },\n      });\n\n      return {\n        stories: stories.map((story) => ({\n          id: story.id,\n          title: story.title,\n          adventureType: story.adventureType,\n          coverImageUrl: story.coverImageUrl || '',\n          createdAt: story.createdAt,\n        })),\n        totalCount,\n        hasMore: input.offset + input.limit < totalCount,\n      };\n    }),\n});\n","exit_code":0,"status":"completed"}}
