{"type":"item.completed","item":{"id":"item_151","type":"command_execution","command":"/bin/zsh -lc \"cd /Users/dogankarakaya/LocalProjects/HeroKid && sed -n '1,200p' apps/mobile/src/components/PurchaseModal.tsx\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport React, { useState } from 'react';\nimport { View, Text, Modal, StyleSheet, TouchableOpacity, ActivityIndicator, Alert } from 'react-native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { usePurchaseCredits } from '../hooks/useCredits';\n\ninterface PurchaseModalProps {\n    visible: boolean;\n    onClose: () => void;\n}\n\ntype Step = 'selection' | 'confirm' | 'processing' | 'success' | 'error';\n\nconst PACKAGES = [\n    { credits: 1, price: 0.99, label: 'Starter', badge: 'Popular' },\n    { credits: 5, price: 4.49, label: 'Value', badge: 'Save 10%' },\n    { credits: 10, price: 7.99, label: 'Pro', badge: 'Save 20%' },\n];\n\nexport function PurchaseModal({ visible, onClose }: PurchaseModalProps) {\n    const [step, setStep] = useState<Step>('selection');\n    const [selectedPackage, setSelectedPackage] = useState<typeof PACKAGES[0] | null>(null);\n    const { purchase, loading } = usePurchaseCredits();\n    const [errorMsg, setErrorMsg] = useState<string | null>(null);\n\n    const handleSelect = (pkg: typeof PACKAGES[0]) => {\n        setSelectedPackage(pkg);\n        setStep('confirm');\n    };\n\n    const handlePurchase = async () => {\n        if (!selectedPackage) return;\n\n        setStep('processing');\n        setErrorMsg(null);\n\n        try {\n            // In a real app, this would trigger the native payment sheet (Stripe/Apple/Google)\n            // For this UI implementation, we simulate the API call\n            // The usePurchaseCredits hook currently mocks this or calls a dev endpoint\n\n            // Simulate network delay for better UX\n            await new Promise(resolve => setTimeout(resolve, 1500));\n\n            await purchase({\n                credits: selectedPackage.credits,\n                platform: 'STRIPE', // Defaulting to Stripe for now as per brief example\n                stripePaymentId: 'mock_payment_id', // Mock ID\n            });\n\n            setStep('success');\n        } catch (err: any) {\n            console.error('Purchase failed', err);\n            setErrorMsg(err.message || 'Payment failed. Please try again.');\n            setStep('error');\n        }\n    };\n\n    const handleClose = () => {\n        setStep('selection');\n        setSelectedPackage(null);\n        setErrorMsg(null);\n        onClose();\n    };\n\n    const renderSelection = () => (\n        <View style={styles.content}>\n            <Text style={styles.title}>Buy Credits</Text>\n            <Text style={styles.subtitle}>Choose a credit package to continue</Text>\n\n            <View style={styles.packagesContainer}>\n                {PACKAGES.map((pkg) => (\n                    <TouchableOpacity\n                        key={pkg.credits}\n                        style={styles.packageCard}\n                        onPress={() => handleSelect(pkg)}\n                    >\n                        <View style={styles.packageHeader}>\n                            <Text style={styles.creditsCount}>{pkg.credits} {pkg.credits === 1 ? 'Credit' : 'Credits'}</Text>\n                            {pkg.badge && (\n                                <View style={styles.badge}>\n                                    <Text style={styles.badgeText}>{pkg.badge}</Text>\n                                </View>\n                            )}\n                        </View>\n                        <Text style={styles.price}>${pkg.price}</Text>\n                    </TouchableOpacity>\n                ))}\n            </View>\n\n            <TouchableOpacity style={styles.closeButton} onPress={handleClose}>\n                <Text style={styles.closeButtonText}>Cancel</Text>\n            </TouchableOpacity>\n        </View>\n    );\n\n    const renderConfirm = () => (\n        <View style={styles.content}>\n            <Text style={styles.title}>Confirm Purchase</Text>\n\n            <View style={styles.summaryCard}>\n                <View style={styles.summaryRow}>\n                    <Text style={styles.summaryLabel}>Package</Text>\n                    <Text style={styles.summaryValue}>{selectedPackage?.credits} Credits</Text>\n                </View>\n                <View style={styles.summaryRow}>\n                    <Text style={styles.summaryLabel}>Price</Text>\n                    <Text style={styles.summaryValue}>${selectedPackage?.price}</Text>\n                </View>\n                <View style={styles.divider} />\n                <View style={styles.summaryRow}>\n                    <Text style={styles.summaryLabel}>Total</Text>\n                    <Text style={styles.totalValue}>${selectedPackage?.price}</Text>\n                </View>\n            </View>\n\n            <View style={styles.actions}>\n                <TouchableOpacity style={styles.secondaryButton} onPress={() => setStep('selection')}>\n                    <Text style={styles.secondaryButtonText}>Back</Text>\n                </TouchableOpacity>\n                <TouchableOpacity style={styles.primaryButton} onPress={handlePurchase}>\n                    <Text style={styles.primaryButtonText}>Pay Now</Text>\n                </TouchableOpacity>\n            </View>\n        </View>\n    );\n\n    const renderProcessing = () => (\n        <View style={styles.content}>\n            <ActivityIndicator size=\"large\" color=\"#6366F1\" style={styles.spinner} />\n            <Text style={styles.title}>Processing Payment...</Text>\n            <Text style={styles.subtitle}>Please do not close the app</Text>\n        </View>\n    );\n\n    const renderSuccess = () => (\n        <View style={styles.content}>\n            <View style={styles.successIcon}>\n                <Ionicons name=\"checkmark\" size={40} color=\"#FFF\" />\n            </View>\n            <Text style={styles.title}>Success!</Text>\n            <Text style={styles.subtitle}>\n                You have purchased {selectedPackage?.credits} credits.\n            </Text>\n\n            <TouchableOpacity style={styles.primaryButton} onPress={handleClose}>\n                <Text style={styles.primaryButtonText}>Done</Text>\n            </TouchableOpacity>\n        </View>\n    );\n\n    const renderError = () => (\n        <View style={styles.content}>\n            <View style={styles.errorIcon}>\n                <Ionicons name=\"close\" size={40} color=\"#FFF\" />\n            </View>\n            <Text style={styles.title}>Payment Failed</Text>\n            <Text style={styles.errorMsg}>{errorMsg}</Text>\n\n            <View style={styles.actions}>\n                <TouchableOpacity style={styles.secondaryButton} onPress={handleClose}>\n                    <Text style={styles.secondaryButtonText}>Cancel</Text>\n                </TouchableOpacity>\n                <TouchableOpacity style={styles.primaryButton} onPress={handlePurchase}>\n                    <Text style={styles.primaryButtonText}>Retry</Text>\n                </TouchableOpacity>\n            </View>\n        </View>\n    );\n\n    return (\n        <Modal\n            visible={visible}\n            transparent\n            animationType=\"slide\"\n            onRequestClose={handleClose}\n        >\n            <View style={styles.overlay}>\n                <View style={styles.container}>\n                    {step === 'selection' && renderSelection()}\n                    {step === 'confirm' && renderConfirm()}\n                    {step === 'processing' && renderProcessing()}\n                    {step === 'success' && renderSuccess()}\n                    {step === 'error' && renderError()}\n                </View>\n            </View>\n        </Modal>\n    );\n}\n\nconst styles = StyleSheet.create({\n    overlay: {\n        flex: 1,\n        backgroundColor: 'rgba(0, 0, 0, 0.5)',\n        justifyContent: 'flex-end',\n    },\n    container: {\n        backgroundColor: 'white',\n        borderTopLeftRadius: 20,\n        borderTopRightRadius: 20,\n        padding: 24,\n","exit_code":0,"status":"completed"}}
