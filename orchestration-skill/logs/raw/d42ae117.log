{"type":"item.completed","item":{"id":"item_146","type":"command_execution","command":"/bin/zsh -lc \"cd /Users/dogankarakaya/LocalProjects/HeroKid && sed -n '1,200p' apps/mobile/src/hooks/useCredits.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { trpc } from '../providers/trpc';\nimport { Alert } from 'react-native';\n\nexport function useCredits() {\n    const utils = trpc.useContext();\n    const { data: balanceData, isLoading, error, refetch } = trpc.credits.getBalance.useQuery();\n\n    return {\n        balance: balanceData?.credits ?? 0,\n        hasFreeAvatarGeneration: balanceData?.hasFreeAvatarGeneration ?? false,\n        loading: isLoading,\n        error,\n        refetch: async () => {\n            await refetch();\n            await utils.credits.getBalance.invalidate();\n        },\n    };\n}\n\nexport function useCreditHistory(limit = 50, type = 'all') {\n    // Supported types: 'all', 'purchase', 'story_debit', 'avatar_debit', 'pet_debit'\n    const { data, isLoading, fetchNextPage, hasNextPage, isFetchingNextPage, refetch } =\n        trpc.credits.getHistory.useInfiniteQuery(\n            {\n                limit,\n            },\n            {\n                getNextPageParam: (lastPage) => lastPage.hasMore ? lastPage.transactions.length : undefined,\n            }\n        );\n\n    // Flatten pages into a single list of transactions\n    const transactions = data?.pages.flatMap((page) => page.transactions) ?? [];\n\n    return {\n        transactions,\n        loading: isLoading,\n        hasMore: hasNextPage,\n        loadMore: fetchNextPage,\n        isFetchingMore: isFetchingNextPage,\n        refetch,\n    };\n}\n\nexport function usePurchaseCredits() {\n    const utils = trpc.useContext();\n\n    // We'll use the platform specific verification endpoints\n    // For now, we'll just expose the purchase mutation which might be platform specific\n    // But since the brief mentions \"Purchase Modal\" with \"Process Payment\", \n    // we might need to coordinate with native payment libraries.\n\n    // For this implementation, we will assume we are using the platform specific mutations directly in the UI\n    // or we can wrap them here. Given the brief, let's expose a generic \"purchase\" that might \n    // eventually delegate to specific platform logic.\n\n    // However, the brief asks for `usePurchaseCredits` returning `{ purchase, loading, error, success }`.\n    // Since actual payment implementation involves native SDKs (Stripe/Apple/Google), \n    // and the backend has `verifyApplePurchase` / `verifyGooglePurchase`, \n    // we will implement a placeholder that simulates the flow or calls the appropriate backend if we were doing direct API calls (like Stripe).\n\n    // For the purpose of this task (UI implementation), we will focus on the UI flow.\n    // Real payment integration usually requires a lot more setup (Stripe Provider, etc).\n\n    // Let's implement a mock purchase for now that calls a \"debug\" endpoint or just simulates it, \n    // OR if we want to be closer to real life, we would use `trpc.credits.purchaseCredits` \n    // but that requires a platform ID.\n\n    const purchaseMutation = trpc.credits.purchaseCredits.useMutation({\n        onSuccess: () => {\n            utils.credits.getBalance.invalidate();\n            utils.credits.getHistory.invalidate();\n        },\n    });\n\n    return {\n        purchase: purchaseMutation.mutateAsync,\n        loading: purchaseMutation.isLoading,\n        error: purchaseMutation.error,\n        success: purchaseMutation.isSuccess,\n    };\n}\n\nexport function useCheckBalance() {\n    const { balance } = useCredits();\n\n    return {\n        checkBalance: (required: number) => {\n            return {\n                hasSufficientBalance: balance >= required,\n                currentBalance: balance,\n                missing: Math.max(0, required - balance),\n            };\n        },\n    };\n}\n","exit_code":0,"status":"completed"}}
