{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"cd /Users/dogankarakaya/LocalProjects/HeroKid && sed -n '1,200p' packages/api/src/utils/verifyParentOwnership.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { TRPCError } from '@trpc/server';\nimport type { Context } from '../context';\n\n/**\n * Verify parent owns the child profile\n */\nexport async function verifyParentOwnership(\n    ctx: Context,\n    childProfileId: string,\n    requiredCredits: number = 0,\n    deductionReason: string = '',\n    transactionType: 'STORY_DEBIT' | 'AVATAR_DEBIT' | 'PET_DEBIT' = 'STORY_DEBIT'\n): Promise<{ parentId: string; childProfile: any; deductionResult?: any }> {\n    if (!ctx.viewer) {\n        throw new TRPCError({ code: 'UNAUTHORIZED', message: 'Authentication required' });\n    }\n\n    // Get parent ID from viewer\n    const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true, creditBalance: true },\n    });\n\n    if (!parent) {\n        throw new TRPCError({ code: 'NOT_FOUND', message: 'Parent profile not found' });\n    }\n\n    // Verify child profile ownership\n    const childProfile = await ctx.prisma.childProfile.findFirst({\n        where: {\n            id: childProfileId,\n            parentId: parent.id,\n            deletedAt: null,\n        },\n        include: {\n            avatars: true,\n            petCompanions: true\n        }\n    });\n\n    if (!childProfile) {\n        throw new TRPCError({\n            code: 'NOT_FOUND',\n            message: 'Child profile not found or access denied',\n        });\n    }\n\n    let deductionResult;\n\n    // Optional: Handle credit deduction if requiredCredits > 0\n    if (requiredCredits > 0) {\n        if (parent.creditBalance < requiredCredits) {\n            throw new TRPCError({\n                code: 'FORBIDDEN',\n                message: `Insufficient credits. You need ${requiredCredits} credits.`,\n            });\n        }\n\n        // Perform deduction\n        deductionResult = await ctx.prisma.$transaction(async (tx) => {\n            // Create debit transaction\n            await tx.creditTransaction.create({\n                data: {\n                    parentId: parent.id,\n                    credits: -requiredCredits,\n                    type: transactionType,\n                    description: deductionReason || 'Credit deduction',\n                },\n            });\n\n            // Update parent balance\n            const updatedParent = await tx.parent.update({\n                where: { id: parent.id },\n                data: {\n                    creditBalance: { decrement: requiredCredits },\n                },\n            });\n\n            return { creditsRemaining: updatedParent.creditBalance };\n        });\n    }\n\n    return { parentId: parent.id, childProfile, deductionResult };\n}\n","exit_code":0,"status":"completed"}}
