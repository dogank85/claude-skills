{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/zsh -lc \"cd /Users/dogankarakaya/LocalProjects/HeroKid && sed -n '1,240p' apps/mobile/app/credits/purchase.tsx\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Credit Purchase Screen - Story 6.11\n *\n * Allows parents to purchase story credit packs (1/5/10 credits)\n * Each credit = 1 personalized story at $0.99 per credit\n */\n\nimport React, { useState } from 'react';\nimport {\n  View,\n  Text,\n  ScrollView,\n  TouchableOpacity,\n  StyleSheet,\n  SafeAreaView,\n  Alert,\n  ActivityIndicator,\n} from 'react-native';\nimport { useRouter } from 'expo-router';\nimport { Ionicons } from '@expo/vector-icons';\nimport { trpc } from '../../src/providers/trpc';\n\ninterface CreditPack {\n  credits: 1 | 5 | 10;\n  price: number;\n  description: string;\n  popular?: boolean;\n  bestValue?: boolean;\n}\n\nconst CREDIT_PACKS: CreditPack[] = [\n  { credits: 1, price: 0.99, description: '1 personalized story' },\n  { credits: 5, price: 4.95, description: '5 personalized stories', popular: true },\n  { credits: 10, price: 9.90, description: '10 personalized stories', bestValue: true },\n];\n\nexport default function CreditPurchaseScreen() {\n  const router = useRouter();\n  const [selectedPack, setSelectedPack] = useState<CreditPack | null>(null);\n\n  // Get current credit balance\n  const { data: balanceData, isLoading: balanceLoading } = trpc.credits.getBalance.useQuery();\n\n  // Purchase mutation\n  const purchaseMutation = trpc.credits.purchaseCredits.useMutation({\n    onSuccess: (data) => {\n      Alert.alert(\n        'Purchase Successful!',\n        `You now have ${data.balance} credits. Start creating stories!`,\n        [\n          {\n            text: 'Create Story',\n            onPress: () => router.back(),\n          },\n        ]\n      );\n    },\n    onError: (error) => {\n      Alert.alert('Purchase Failed', error.message || 'An error occurred. Please try again.');\n    },\n  });\n\n  const handlePurchase = (pack: CreditPack) => {\n    setSelectedPack(pack);\n\n    Alert.alert(\n      'Confirm Purchase',\n      `Purchase ${pack.credits} ${pack.credits === 1 ? 'credit' : 'credits'} for $${pack.price.toFixed(2)}?`,\n      [\n        { text: 'Cancel', style: 'cancel', onPress: () => setSelectedPack(null) },\n        {\n          text: 'Purchase',\n          onPress: () => {\n            // In production, this would integrate with:\n            // - Apple In-App Purchase (iOS)\n            // - Google Play Billing (Android)\n            // - Stripe (Web fallback)\n            Alert.alert(\n              'Payment Integration Required',\n              'This would integrate with Apple IAP / Google Play Billing in production. For now, simulating purchase...'\n            );\n            setSelectedPack(null);\n\n            // TODO: Replace with actual IAP integration\n            // purchaseMutation.mutate({\n            //   credits: pack.credits,\n            //   platform: Platform.OS === 'ios' ? 'APPLE' : 'GOOGLE',\n            //   appleTransactionId: 'mock-txn-123',\n            // });\n          },\n        },\n      ]\n    );\n  };\n\n  return (\n    <SafeAreaView style={styles.container}>\n      {/* Header */}\n      <View style={styles.header}>\n        <TouchableOpacity onPress={() => router.back()} style={styles.backButton}>\n          <Ionicons name=\"arrow-back\" size={24} color=\"#111827\" />\n        </TouchableOpacity>\n        <Text style={styles.headerTitle}>Purchase Credits</Text>\n        <View style={styles.headerRight} />\n      </View>\n\n      <ScrollView style={styles.scrollView} contentContainerStyle={styles.scrollContent}>\n        {/* Current Balance */}\n        <View style={styles.balanceCard}>\n          <Text style={styles.balanceLabel}>Your Current Balance</Text>\n          {balanceLoading ? (\n            <ActivityIndicator size=\"large\" color=\"#3B82F6\" />\n          ) : (\n            <View style={styles.balanceRow}>\n              <Ionicons name=\"wallet-outline\" size={32} color=\"#3B82F6\" />\n              <Text style={styles.balanceAmount}>\n                {balanceData?.credits || 0} {balanceData?.credits === 1 ? 'credit' : 'credits'}\n              </Text>\n            </View>\n          )}\n        </View>\n\n        {/* Info */}\n        <View style={styles.infoCard}>\n          <Text style={styles.infoText}>\n            Each credit unlocks 1 fully personalized story featuring your child as the hero!\n          </Text>\n        </View>\n\n        {/* Credit Packs */}\n        <Text style={styles.sectionTitle}>Choose a Credit Pack</Text>\n        {CREDIT_PACKS.map((pack) => (\n          <TouchableOpacity\n            key={pack.credits}\n            style={[\n              styles.packCard,\n              pack.popular && styles.packCardPopular,\n              pack.bestValue && styles.packCardBestValue,\n              selectedPack?.credits === pack.credits && styles.packCardSelected,\n            ]}\n            onPress={() => handlePurchase(pack)}\n            disabled={purchaseMutation.isLoading}\n          >\n            {/* Badge */}\n            {pack.popular && (\n              <View style={[styles.badge, styles.badgePopular]}>\n                <Text style={styles.badgeText}>POPULAR</Text>\n              </View>\n            )}\n            {pack.bestValue && (\n              <View style={[styles.badge, styles.badgeBestValue]}>\n                <Text style={styles.badgeText}>BEST VALUE</Text>\n              </View>\n            )}\n\n            <View style={styles.packContent}>\n              <View style={styles.packLeft}>\n                <Text style={styles.packCredits}>{pack.credits}</Text>\n                <Text style={styles.packCreditsLabel}>\n                  {pack.credits === 1 ? 'Credit' : 'Credits'}\n                </Text>\n              </View>\n\n              <View style={styles.packCenter}>\n                <Text style={styles.packPrice}>${pack.price.toFixed(2)}</Text>\n                <Text style={styles.packPricePerCredit}>\n                  ${(pack.price / pack.credits).toFixed(2)} per story\n                </Text>\n                <Text style={styles.packDescription}>{pack.description}</Text>\n              </View>\n\n              <View style={styles.packRight}>\n                <Ionicons\n                  name=\"chevron-forward\"\n                  size={24}\n                  color={\n                    pack.popular ? '#A855F7' : pack.bestValue ? '#10B981' : '#9CA3AF'\n                  }\n                />\n              </View>\n            </View>\n          </TouchableOpacity>\n        ))}\n\n        {/* What's Included */}\n        <View style={styles.featuresCard}>\n          <Text style={styles.featuresTitle}>What's included with each credit:</Text>\n          <View style={styles.featureRow}>\n            <Ionicons name=\"checkmark-circle\" size={20} color=\"#10B981\" />\n            <Text style={styles.featureText}>1 fully personalized story featuring your child</Text>\n          </View>\n          <View style={styles.featureRow}>\n            <Ionicons name=\"checkmark-circle\" size={20} color=\"#10B981\" />\n            <Text style={styles.featureText}>Custom illustrations in your chosen art style</Text>\n          </View>\n          <View style={styles.featureRow}>\n            <Ionicons name=\"checkmark-circle\" size={20} color=\"#10B981\" />\n            <Text style={styles.featureText}>Downloadable PDF for offline reading</Text>\n          </View>\n          <View style={styles.featureRow}>\n            <Ionicons name=\"checkmark-circle\" size={20} color=\"#10B981\" />\n            <Text style={styles.featureText}>Story saved permanently in your library</Text>\n          </View>\n        </View>\n\n        {/* Restore Purchase */}\n        <TouchableOpacity\n          style={styles.restoreButton}\n          onPress={() => {\n            Alert.alert(\n              'Restore Purchases',\n              'This will restore any previous credit purchases from your Apple or Google account.'\n            );\n          }}\n        >\n          <Text style={styles.restoreButtonText}>Restore Previous Purchases</Text>\n        </TouchableOpacity>\n      </ScrollView>\n    </SafeAreaView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#F9FAFB',\n  },\n  header: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    paddingHorizontal: 16,\n    paddingVertical: 12,\n    borderBottomWidth: 1,\n    borderBottomColor: '#E5E7EB',\n    backgroundColor: '#FFFFFF',\n  },\n  backButton: {\n    padding: 4,\n  },\n","exit_code":0,"status":"completed"}}
