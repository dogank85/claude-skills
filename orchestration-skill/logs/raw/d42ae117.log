n      const androidPublisher = google.androidpublisher({ version: 'v3', auth: authClient });\n      const packageName = process.env.ANDROID_PACKAGE_NAME || 'com.herokid.mobile';\n\n      // 2. Verify Purchase with Google\n      let purchase;\n      try {\n        const response = await androidPublisher.purchases.products.get({\n          packageName,\n          productId: input.sku,\n          token: input.purchaseToken,\n        });\n        purchase = response.data;\n      } catch (error) {\n        console.error('Google verification failed:', error);\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to verify purchase with Google',\n          cause: error,\n        });\n      }\n\n      // Log verification attempt\n      await ctx.prisma.auditLog.create({\n        data: {\n          actorParentId: parent.id,\n          action: 'google_iap_verification',\n          entityType: 'google_purchase',\n          entityId: input.orderId,\n          metadata: {\n            purchaseState: purchase.purchaseState,\n            consumptionState: purchase.consumptionState,\n            sku: input.sku,\n          },\n          ipAddress: ctx.requestIp,\n        },\n      });\n\n      // 3. Validate Purchase State\n      // purchaseState: 0=Purchased, 1=Canceled, 2=Pending\n      if (purchase.purchaseState !== 0) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: `Purchase not completed. State: ${purchase.purchaseState}`,\n        });\n      }\n\n      if (purchase.orderId !== input.orderId) {\n        console.warn(`Order ID mismatch: Input ${input.orderId} vs Google ${purchase.orderId}`);\n        // We might accept this if Google returns a different internal ID, but logging is good.\n      }\n\n      // 4. Parse Credits\n      const creditsMatch = input.sku.match(/^credits_(\\d+)$/);\n      if (!creditsMatch) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Invalid SKU format',\n        });\n      }\n\n      const credits = parseInt(creditsMatch[1], 10);\n      if (![1, 5, 10].includes(credits)) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Invalid credit amount',\n        });\n      }\n\n      // Check for duplicate transaction\n      const existingPack = await ctx.prisma.creditPack.findFirst({\n        where: { googleOrderId: input.orderId },\n      });\n\n      if (existingPack) {\n        const balance = await getCreditBalance(ctx, parent.id);\n        return {\n          success: true,\n          credits,\n          balance,\n          message: 'Credits already granted for this transaction',\n        };\n      }\n\n      const result = await ctx.prisma.$transaction(async (tx) => {\n        const creditPack = await tx.creditPack.create({\n          data: {\n            parentId: parent.id,\n            credits,\n            price: credits * 0.99,\n            platform: 'GOOGLE',\n            googleOrderId: input.orderId,\n          },\n        });\n\n        await tx.creditTransaction.create({\n          data: {\n            parentId: parent.id,\n            credits,\n            type: 'PURCHASE',\n            description: `Google Play: ${credits} credits`,\n          },\n        });\n\n        // Update parent's credit balance atomically\n        const updatedParent = await tx.parent.update({\n          where: { id: parent.id },\n          data: {\n            creditBalance: {\n              increment: credits,\n            },\n          },\n          select: { creditBalance: true },\n        });\n\n        return { creditPack, newBalance: updatedParent.creditBalance };\n      });\n\n      return {\n        success: true,\n        credits,\n        balance: result.newBalance,\n        creditPackId: result.creditPack.id,\n      };\n    }),\n\n  /**\n   * Create Stripe checkout session for credit purchase\n   */\n  createStripeCheckout: protectedProcedure\n    .input(\n      z.object({\n        credits: z.number().int().refine(val => [1, 5, 10].includes(val)),\n        successUrl: z.string().url().optional(),\n        cancelUrl: z.string().url().optional(),\n      })\n    )\n    .mutation(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true, email: true },\n      });\n\n      if (!parent || !parent.email) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      // Import Stripe client\n      const { stripe } = await import('../lib/stripe');\n\n      // Credit pack pricing with bundle discounts\n      // IMPORTANT: These prices MUST match the UI in apps/web/app/(dashboard)/dashboard/credits/buy/page.tsx\n      const CREDIT_PACK_PRICES: Record<1 | 5 | 10, number> = {\n        1: 0.99,   // $0.99 - no discount\n        5: 4.49,   // $4.49 - 10% discount (was $4.95)\n        10: 7.99,  // $7.99 - 20% discount (was $9.90)\n      };\n\n      const price = CREDIT_PACK_PRICES[input.credits as 1 | 5 | 10];\n      const baseUrl = process.env.NEXT_PUBLIC_APP_URL || 'http://localhost:3000';\n\n      const successUrl = input.successUrl || `${baseUrl}/purchase/success?session_id={CHECKOUT_SESSION_ID}`;\n      const cancelUrl = input.cancelUrl || `${baseUrl}/purchase?cancelled=true`;\n\n      try {\n        // Create Stripe checkout session\n        const session = await stripe.checkout.sessions.create({\n          payment_method_types: ['card'],\n          line_items: [\n            {\n              price_data: {\n                currency: 'usd',\n                product_data: {\n                  name: `${input.credits} Story ${input.credits === 1 ? 'Credit' : 'Credits'}`,\n                  description: `Generate ${input.credits} personalized ${input.credits === 1 ? 'story' : 'stories'} with PDF downloads`,\n                  images: ['https://herokid.app/images/credit-pack.png'], // Optional: Add product image\n                },\n                unit_amount: Math.round(price * 100), // Convert to cents\n              },\n              quantity: 1,\n            },\n          ],\n          mode: 'payment',\n          success_url: successUrl,\n          cancel_url: cancelUrl,\n          customer_email: parent.email,\n          client_reference_id: parent.id,\n          metadata: {\n            parentId: parent.id,\n            credits: input.credits.toString(),\n            source: 'web',\n          },\n        });\n\n        // Log checkout session creation\n        await ctx.prisma.auditLog.create({\n          data: {\n            actorParentId: parent.id,\n            action: 'stripe_checkout_created',\n            entityType: 'stripe_session',\n            entityId: session.id,\n            metadata: {\n              credits: input.credits,\n              amount: price,\n              sessionId: session.id,\n            },\n            ipAddress: ctx.requestIp,\n          },\n        });\n\n        return {\n          checkoutUrl: session.url!,\n          sessionId: session.id,\n        };\n      } catch (error) {\n        console.error('Stripe checkout session creation failed:', error);\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to create checkout session',\n          cause: error,\n        });\n      }\n    }),\n});\n","exit_code":0,"status":"completed"}}
