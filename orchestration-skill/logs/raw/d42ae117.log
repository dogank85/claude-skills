{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"cd /Users/dogankarakaya/LocalProjects/HeroKid && sed -n '1,240p' apps/web/app/api/generate-pdf/route.tsx\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * PDF Generation Serverless Function - Epic 5 Story 5.7\n * Generates PDF storybooks using @react-pdf/renderer\n *\n * Flow:\n * 1. Fetch story from database with all scenes and images\n * 2. Render PDF using StoryPDF component\n * 3. Upload to Supabase Storage\n * 4. Generate 7-day signed URL\n * 5. Update export job status\n */\n\nimport { NextResponse } from 'next/server';\nimport { renderToBuffer } from '@react-pdf/renderer';\nimport { StoryPDF } from './StoryPDF';\nimport { createClient } from '@supabase/supabase-js';\nimport { db } from '@herokid/database';\n\n// Initialize Supabase client\nconst supabase = createClient(\n  process.env.NEXT_PUBLIC_SUPABASE_URL!,\n  process.env.SUPABASE_SERVICE_KEY!\n);\n\nexport async function POST(request: Request) {\n  // Parse request body outside try block so exportId is available in catch\n  let exportId: string | undefined;\n  let storyId: string | undefined;\n\n  try {\n    const body = await request.json();\n    exportId = body.exportId;\n    storyId = body.storyId;\n\n    if (!exportId || !storyId) {\n      return NextResponse.json(\n        { error: 'Missing exportId or storyId' },\n        { status: 400 }\n      );\n    }\n\n    // 1. Fetch story from database with all scenes and images\n    const story = await db.story.findUnique({\n      where: { id: storyId },\n      include: {\n        images: {\n          orderBy: { sceneNumber: 'asc' },\n          select: {\n            sceneNumber: true,\n            publicUrl: true,\n          },\n        },\n      },\n    });\n\n    if (!story) {\n      // Update export job with error\n      await db.storyExport.update({\n        where: { id: exportId },\n        data: {\n          status: 'failed',\n          errorMessage: 'Story not found',\n          completedAt: new Date(),\n        },\n      });\n\n      return NextResponse.json({ error: 'Story not found' }, { status: 404 });\n    }\n\n    // Parse story content to extract scenes\n    const storyContent = story.content ? JSON.parse(story.content) : { scenes: [] };\n    const scenes = storyContent.scenes.map((scene: any) => ({\n      sceneNumber: scene.sceneNumber,\n      text: scene.text,\n      imageUrl: story.images.find((img) => img.sceneNumber === scene.sceneNumber)?.publicUrl || '',\n    }));\n\n    // 2. Render PDF using StoryPDF component\n    const pdfBuffer = await renderToBuffer(\n      <StoryPDF\n        story={{\n          title: story.title,\n          coverImageUrl: story.coverImageUrl || undefined,\n          scenes,\n        }}\n      />\n    );\n\n    // 3. Upload to Supabase Storage\n    const fileName = `${exportId}.pdf`;\n    const { data: uploadData, error: uploadError } = await supabase.storage\n      .from('story-pdfs')\n      .upload(fileName, pdfBuffer, {\n        contentType: 'application/pdf',\n        cacheControl: '3600',\n        upsert: true,\n      });\n\n    if (uploadError) {\n      // Update export job with error\n      await db.storyExport.update({\n        where: { id: exportId },\n        data: {\n          status: 'failed',\n          errorMessage: `Upload failed: ${uploadError.message}`,\n          completedAt: new Date(),\n        },\n      });\n\n      return NextResponse.json(\n        { error: `Upload failed: ${uploadError.message}` },\n        { status: 500 }\n      );\n    }\n\n    // 4. Generate 7-day signed URL\n    const { data: signedUrlData, error: signedUrlError } = await supabase.storage\n      .from('story-pdfs')\n      .createSignedUrl(fileName, 60 * 60 * 24 * 7); // 7 days\n\n    if (signedUrlError || !signedUrlData) {\n      // Update export job with error\n      await db.storyExport.update({\n        where: { id: exportId },\n        data: {\n          status: 'failed',\n          errorMessage: `Failed to generate signed URL: ${signedUrlError?.message}`,\n          completedAt: new Date(),\n        },\n      });\n\n      return NextResponse.json(\n        { error: `Failed to generate signed URL: ${signedUrlError?.message}` },\n        { status: 500 }\n      );\n    }\n\n    // 5. Update export job status\n    const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);\n    await db.storyExport.update({\n      where: { id: exportId },\n      data: {\n        status: 'complete',\n        storagePath: uploadData.path,\n        downloadUrl: signedUrlData.signedUrl,\n        expiresAt,\n        completedAt: new Date(),\n      },\n    });\n\n    return NextResponse.json({\n      success: true,\n      downloadUrl: signedUrlData.signedUrl,\n      expiresAt,\n    });\n  } catch (error) {\n    console.error('PDF generation error:', error);\n\n    // Update export job with error if we have the exportId (cached from above)\n    if (exportId) {\n      try {\n        await db.storyExport.update({\n          where: { id: exportId },\n          data: {\n            status: 'failed',\n            errorMessage: error instanceof Error ? error.message : 'Unknown error',\n            completedAt: new Date(),\n          },\n        });\n      } catch (updateError) {\n        console.error('Failed to update export job:', updateError);\n      }\n    }\n\n    return NextResponse.json(\n      {\n        error: 'Internal server error',\n        details: error instanceof Error ? error.message : 'Unknown error',\n      },\n      { status: 500 }\n    );\n  }\n}\n\n// Set max duration for serverless function (10 seconds should be enough)\nexport const maxDuration = 10;\n","exit_code":0,"status":"completed"}}
