{"type":"item.completed","item":{"id":"item_156","type":"command_execution","command":"/bin/zsh -lc \"cd /Users/dogankarakaya/LocalProjects/HeroKid && sed -n '40,160p' packages/api/src/routers/credits.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n  credits: z.number().int().positive().default(1),\n});\n\n// Helper function to get balance\nasync function getCreditBalance(ctx: any, parentId: string) {\n  const parent = await ctx.prisma.parent.findUnique({\n    where: { id: parentId },\n    select: { creditBalance: true },\n  });\n  return parent?.creditBalance ?? 0;\n}\n\nexport const creditsRouter = createTRPCRouter({\n  purchaseCredits: protectedProcedure\n    .input(purchaseCreditsSchema)\n    .mutation(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true },\n      });\n\n      if (!parent) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      // Mock purchase for now\n      const result = await ctx.prisma.$transaction(async (tx) => {\n        const creditPack = await tx.creditPack.create({\n          data: {\n            parentId: parent.id,\n            credits: input.credits,\n            price: input.credits * 0.99,\n            platform: input.platform,\n            stripePaymentId: input.stripePaymentId,\n            appleTransactionId: input.appleTransactionId,\n            googleOrderId: input.googleOrderId,\n          },\n        });\n\n        await tx.creditTransaction.create({\n          data: {\n            parentId: parent.id,\n            credits: input.credits,\n            type: 'PURCHASE',\n            description: `Purchased ${input.credits} credits via ${input.platform}`,\n          },\n        });\n\n        const updatedParent = await tx.parent.update({\n          where: { id: parent.id },\n          data: {\n            creditBalance: { increment: input.credits },\n          },\n          select: { creditBalance: true },\n        });\n\n        return { creditPack, newBalance: updatedParent.creditBalance };\n      });\n\n      return {\n        success: true,\n        credits: input.credits,\n        balance: result.newBalance,\n      };\n    }),\n\n  getBalance: protectedProcedure.query(async ({ ctx }) => {\n    const parent = await ctx.prisma.parent.findUnique({\n      where: { supabaseUserId: ctx.viewer.id },\n      select: { id: true, creditBalance: true },\n    });\n\n    if (!parent) {\n      throw new TRPCError({\n        code: 'NOT_FOUND',\n        message: 'Parent account not found',\n      });\n    }\n\n    const childProfiles = await ctx.prisma.childProfile.findMany({\n      where: { parentId: parent.id }, // Removed deletedAt: null to include deleted children\n      select: { id: true, avatarsGenerated: true, createdAt: true },\n      orderBy: { createdAt: 'asc' },\n    });\n\n    // First child is determined by creation order (earliest createdAt)\n    const firstChild = childProfiles[0];\n\n    // Check if the first child (even if deleted) has used their free generation\n    // If the first child is deleted, no one gets free generation (strict rule)\n    // OR: If the first child is active, they get it.\n    // The requirement is \"ONLY the first child of a parent account gets free avatar + pet\"\n\n    // We need to return the ID of the first child so the UI knows WHO is free\n    const firstChildId = firstChild?.id;\n\n    // We also need to know if that specific first child has already used it\n    const hasFreeAvatarGeneration = firstChild ? !firstChild.avatarsGenerated : false;\n\n    return {\n      credits: parent.creditBalance,\n      hasFreeAvatarGeneration,\n      firstChildId, // New field for UI to identify which child is free\n    };\n  }),\n\n  /**\n   * Deduct credit when story or avatar is generated\n   * Called by client or service\n   */\n  deductCredit: protectedProcedure\n    .input(deductCreditSchema)\n    .mutation(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true },\n      });\n\n","exit_code":0,"status":"completed"}}
