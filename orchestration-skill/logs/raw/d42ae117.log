w TRPCError({\n        code: 'UNAUTHORIZED',\n        message: 'Invalid Supabase session token.',\n        cause: error ?? undefined,\n      });\n    }\n\n    viewer = { id: data.user.id, email: data.user.email };\n  }\n\n  const requestIp = headers ? extractRequestIp(headers) : null;\n\n  return {\n    prisma,\n    supabase,\n    viewer,\n    requestHeaders: headers,\n    requestIp,\n    env: apiEnv,\n    admin: null,\n  };\n}\n\ntype BaseContext = Awaited<ReturnType<typeof createContext>>;\nexport type Context = Omit<BaseContext, 'admin'> & { admin?: AdminContext | null };\n\nexport function createContextFactory(baseOptions?: Partial<CreateContextOptions>) {\n  return async (opts: FetchCreateContextFnOptions) =>\n    createContext({\n      headers: opts.req.headers,\n      prisma: baseOptions?.prisma ?? defaultPrisma,\n      supabase: baseOptions?.supabase ?? supabaseAdminClient ?? undefined,\n      viewer: baseOptions?.viewer ?? null,\n    });\n}\n\nfunction extractAuthToken(headers: Headers) {\n  const authHeader =\n    headers.get('authorization') ?? headers.get('Authorization') ?? headers.get('AUTHORIZATION');\n  if (authHeader) {\n    const parts = authHeader.split(' ');\n    if (parts.length === 2 && parts[0].toLowerCase() === 'bearer') {\n      return parts[1];\n    }\n  }\n\n  const cookies = parseCookies(headers.get('cookie'));\n  if (cookies['sb-access-token']) {\n    return decodeURIComponent(cookies['sb-access-token']);\n  }\n\n  if (cookies['supabase-auth-token']) {\n    const raw = decodeURIComponent(cookies['supabase-auth-token']);\n    try {\n      const parsed = JSON.parse(raw);\n      if (Array.isArray(parsed) && parsed[0]) {\n        return parsed[0];\n      }\n      if (parsed?.currentSession?.access_token) {\n        return parsed.currentSession.access_token;\n      }\n    } catch {\n      // Fall through to header-based extraction below\n    }\n  }\n\n  return headers.get('x-supabase-auth') ?? headers.get('x-herokid-supabase');\n}\n\n/**\n * Extract the real client IP address from trusted proxy headers.\n * We capture the originating IP (first X-Forwarded-For value) for audit logs, with fallbacks.\n */\nfunction extractRequestIp(headers: Headers): string | null {\n  const forwardedFor = headers.get('x-forwarded-for');\n  if (forwardedFor) {\n    const ips = forwardedFor.split(',').map((ip) => ip.trim());\n    if (ips[0]) {\n      return ips[0];\n    }\n  }\n\n  const realIp = headers.get('x-real-ip');\n  if (realIp) {\n    return realIp;\n  }\n\n  const cfIp = headers.get('cf-connecting-ip');\n  if (cfIp) {\n    return cfIp;\n  }\n\n  const vercelIp = headers.get('x-vercel-forwarded-for');\n  if (vercelIp) {\n    return vercelIp;\n  }\n\n  return null;\n}\n\nfunction parseCookies(cookieHeader: string | null): Record<string, string> {\n  if (!cookieHeader) return {};\n\n  return cookieHeader.split(';').reduce<Record<string, string>>((acc, cookie) => {\n    const [name, ...rest] = cookie.trim().split('=');\n    if (!name) return acc;\n    acc[name] = rest.join('=');\n    return acc;\n  }, {});\n}\n","exit_code":0,"status":"completed"}}
