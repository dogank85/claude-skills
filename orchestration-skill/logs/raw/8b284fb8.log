{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/ai/src/gemini/client.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Gemini AI Client for Story Text Generation\n * Story 4.1: Gemini 2.5 Flash-Lite Integration\n *\n * Implements all 5 acceptance criteria:\n * AC1: GeminiClient class with generateStory() method using gemini-2.5-flash-lite\n * AC2: Structured JSON output with response MIME type application/json\n * AC3: Safety settings configured for all harmful categories\n * AC4: Retry logic with exponential backoff (3 retries: 1s, 2s, 4s)\n * AC5: Cost tracking from token metadata\n */\n\nimport { VertexAI, HarmCategory, HarmBlockThreshold } from '@google-cloud/vertexai';\nimport type {\n  GenerateStoryRequest,\n  GenerateStoryResponse,\n  AgeGroup,\n  StoryScene,\n  SafetyRating,\n  TokenUsageMetadata,\n} from './types';\nimport { retryWithBackoff } from './retry';\n\n/**\n * Gemini AI pricing constants (as of 2024)\n * Source: https://cloud.google.com/vertex-ai/generative-ai/pricing\n */\nconst PRICING = {\n  /** Input tokens cost per 1K tokens in USD */\n  INPUT_PER_1K: 0.00001,\n  /** Output tokens cost per 1K tokens in USD */\n  OUTPUT_PER_1K: 0.00002,\n  /** Fallback estimate if metadata unavailable */\n  FALLBACK_ESTIMATE: 0.001,\n} as const;\n\n/**\n * Configuration options for GeminiClient\n */\nexport interface GeminiClientConfig {\n  projectId?: string;\n  location?: string;\n}\n\n/**\n * Gemini client for AI-powered story generation\n */\nexport class GeminiClient {\n  private vertexAI: VertexAI;\n  private readonly model = 'gemini-2.5-flash-lite';\n  private readonly location: string;\n\n  constructor(config?: GeminiClientConfig) {\n    // Initialize Vertex AI with GCP project and location\n    const projectId = config?.projectId || process.env.GOOGLE_CLOUD_PROJECT;\n\n    if (!projectId) {\n      throw new Error(\n        'GOOGLE_CLOUD_PROJECT environment variable is required for Gemini integration'\n      );\n    }\n\n    this.location = config?.location || 'us-central1';\n\n    this.vertexAI = new VertexAI({\n      project: projectId,\n      location: this.location,\n    });\n  }\n\n  /**\n   * Generate a personalized story with AI\n   *\n   * @param params - Story generation parameters\n   * @returns Generated story with scenes, cost, and metadata\n   * @throws Error if generation fails after retries\n   *\n   * @example\n   * ```typescript\n   * const story = await geminiClient.generateStory({\n   *   childName: 'Alice',\n   *   childAge: 7,\n   *   petName: 'Max',\n   *   petType: 'dog',\n   *   adventureTemplate: 'superhero_rescue',\n   *   artStyle: 'pixar',\n   * });\n   * ```\n   */\n  async generateStory(params: GenerateStoryRequest): Promise<GenerateStoryResponse> {\n    const startTime = Date.now();\n\n    // Calculate age group for adaptive prompting\n    const ageGroup = this.calculateAgeGroup(params.childAge);\n\n    // Build the prompt\n    const prompt = this.buildPrompt(params, ageGroup);\n\n    // Execute generation with retry logic\n    const result = await retryWithBackoff(\n      async () => {\n        // Get the generative model with configuration\n        const generativeModel = this.vertexAI.preview.getGenerativeModel({\n          model: this.model,\n          generationConfig: {\n            temperature: 0.7,\n            maxOutputTokens: 2000,\n            responseMimeType: 'application/json', // AC2: Structured JSON output\n          },\n          safetySettings: this.getSafetySettings(), // AC3: Safety configuration\n        });\n\n        // Generate content\n        const response = await generativeModel.generateContent(prompt);\n        return response;\n      },\n      {\n        maxRetries: 3, // AC4: Max 3 retries\n        initialDelayMs: 1000, // AC4: 1s, 2s, 4s delays\n      }\n    );\n\n    // Parse the response\n    const responseData = result.response;\n    const responseText = responseData.candidates?.[0]?.content?.parts?.[0]?.text || '';\n\n    // Parse JSON output\n    let storyData: { title: string; scenes: StoryScene[] };\n    try {\n      storyData = JSON.parse(responseText);\n    } catch (error) {\n      throw new Error(`Failed to parse Gemini response as JSON: ${error instanceof Error ? error.message : 'Unknown error'}`);\n    }\n\n    // Validate story structure\n    if (!storyData.title || !Array.isArray(storyData.scenes)) {\n      throw new Error('Invalid story structure: missing title or scenes');\n    }\n\n    if (storyData.scenes.length !== 6) {\n      console.warn(`Expected 6 scenes, got ${storyData.scenes.length}`);\n    }\n\n    // Calculate word count\n    const wordCount = this.countWords(storyData.scenes);\n\n    // Calculate generation time\n    const generationTime = Date.now() - startTime;\n\n    // Calculate cost from token usage metadata (AC5)\n    const usageMetadata = (responseData as any).usageMetadata as TokenUsageMetadata | undefined;\n    const cost = this.calculateCost(usageMetadata);\n\n    // Extract safety ratings\n    const safetyRatings = this.extractSafetyRatings(responseData);\n\n    return {\n      title: storyData.title,\n      scenes: storyData.scenes,\n      wordCount,\n      generationTime,\n      cost,\n      safetyRatings,\n    };\n  }\n\n  /**\n   * Calculate age group from child's age\n   * Maps to one of three developmental stages\n   *\n   * @param age - Child's age in years\n   * @returns Age group classification\n   */\n  private calculateAgeGroup(age: number): AgeGroup {\n    if (age <= 7) return '5-7';\n    if (age <= 10) return '8-10';\n    return '11-12';\n  }\n\n  /**\n   * Count total words across all scenes\n   *\n   * @param scenes - Array of story scenes\n   * @returns Total word count\n   */\n  private countWords(scenes: StoryScene[]): number {\n    return scenes.reduce((count, scene) => {\n      const words = scene.text.split(/\\s+/).filter((word) => word.length > 0);\n      return count + words.length;\n    }, 0);\n  }\n\n  /**\n   * Calculate generation cost from token usage metadata\n   * AC5: Cost tracking per generation\n   *\n   * @param metadata - Token usage metadata from Gemini\n   * @returns Cost in USD\n   */\n  private calculateCost(metadata?: TokenUsageMetadata): number {\n","exit_code":0,"status":"completed"}}
