{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"sed -n '400,800p' packages/api/src/routers/auth.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n          actorParentId: parent.id,\n          entityType: 'parent',\n          entityId: parent.id,\n          metadata: {\n            email_hash: hashEmail(parent.email),\n          },\n          ipAddress: ip,\n        });\n\n        // Force logout of existing sessions by revoking all refresh tokens\n        // This is a security best practice\n        await ctx.supabase.auth.admin.signOut(userData.user.id, 'global');\n\n        return {\n          success: true,\n          message: 'Password has been reset successfully. Please log in with your new password.',\n        };\n      } catch (error) {\n        // Re-throw TRPCErrors\n        if (error instanceof TRPCError) {\n          throw error;\n        }\n\n        // Log unexpected errors\n        await createAuditLog(ctx.prisma, {\n          action: 'password_reset_error',\n          entityType: 'parent',\n          metadata: {\n            error: error instanceof Error ? error.message : 'Unknown error',\n          },\n          ipAddress: ip,\n        });\n\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'An unexpected error occurred',\n        });\n      }\n    }),\n\n  /**\n   * Login endpoint\n   * Signs in a parent using email and password.\n   * Validates credentials, enforces email verification, and returns session tokens.\n   * Rate limited to 5 attempts per email/IP per 15 minutes.\n   */\n  login: publicProcedure\n    .input(authSchemas.loginInput)\n    .mutation(async ({ ctx, input }) => {\n      const ipAddress = extractIpAddress(ctx.requestHeaders) ?? 'unknown';\n      const rateLimitKey = `auth:login:${ipAddress}:${input.email}`;\n\n      // 1. Check rate limiting - 5 attempts per email/IP per 15 minutes\n      try {\n        rateLimiter.assertWithinLimit(rateLimitKey, RATE_LIMITS.AUTH_LOGIN.limit, RATE_LIMITS.AUTH_LOGIN.windowMs);\n      } catch (error) {\n        // Log failed rate limit check\n        await createAuditLog(ctx.prisma, {\n          action: 'login_rate_limited',\n          entityType: 'parent',\n          metadata: {\n            email_hash: hashEmail(input.email),\n            ip: ipAddress,\n          },\n          ipAddress,\n        });\n        throw new TRPCError({\n          code: 'TOO_MANY_REQUESTS',\n          message: 'Too many login attempts. Please try again later.',\n        });\n      }\n\n      // 2. Validate Supabase is configured\n      if (!ctx.supabase) {\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Authentication service is not configured. Please contact support.',\n        });\n      }\n\n      // 3. Attempt to sign in with Supabase\n      let supabaseSession;\n      try {\n        const { data, error } = await ctx.supabase.auth.signInWithPassword({\n          email: input.email,\n          password: input.password,\n        });\n\n        if (error || !data?.session || !data?.user) {\n          // Log failed login attempt\n          await createAuditLog(ctx.prisma, {\n            action: 'login_failed',\n            entityType: 'parent',\n            metadata: {\n              email_hash: hashEmail(input.email),\n              reason: 'invalid_credentials',\n              error: error?.message,\n            },\n            ipAddress,\n          });\n\n          throw new TRPCError({\n            code: 'UNAUTHORIZED',\n            message: 'Invalid email or password.',\n            cause: error,\n          });\n        }\n\n        supabaseSession = data.session;\n      } catch (error) {\n        if (error instanceof TRPCError) {\n          throw error;\n        }\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to authenticate. Please try again.',\n          cause: error,\n        });\n      }\n\n      // 4. Find the parent record\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: supabaseSession.user.id },\n        select: {\n          id: true,\n          email: true,\n          status: true,\n          consentAt: true,\n        },\n      });\n\n      if (!parent) {\n        await createAuditLog(ctx.prisma, {\n          action: 'login_failed',\n          entityType: 'parent',\n          metadata: {\n            email_hash: hashEmail(input.email),\n            reason: 'parent_not_found',\n          },\n          ipAddress,\n        });\n\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Account not found. Please register first.',\n        });\n      }\n\n      // 5. Check account status\n      if (parent.status !== 'ACTIVE') {\n        await createAuditLog(ctx.prisma, {\n          action: 'login_failed',\n          actorParentId: parent.id,\n          entityType: 'parent',\n          entityId: parent.id,\n          metadata: {\n            reason: 'account_not_active',\n            status: parent.status,\n          },\n          ipAddress,\n        });\n\n        if (parent.status === 'PENDING_VERIFICATION') {\n          throw new TRPCError({\n            code: 'FORBIDDEN',\n            message: 'Please verify your email address before logging in.',\n            cause: {\n              status: parent.status,\n              needsVerification: true,\n            },\n          });\n        }\n\n        throw new TRPCError({\n          code: 'FORBIDDEN',\n          message: `Your account is ${parent.status.toLowerCase()}. Please contact support.`,\n          cause: {\n            status: parent.status,\n          },\n        });\n      }\n\n      // 6. Log successful login\n      await createAuditLog(ctx.prisma, {\n        action: 'login_success',\n        actorParentId: parent.id,\n        entityType: 'parent',\n        entityId: parent.id,\n        metadata: {\n          userAgent: input.userAgent,\n        },\n        ipAddress,\n      });\n\n      // 7. Return session data\n      return {\n        session: {\n          accessToken: supabaseSession.access_token,\n          refreshToken: supabaseSession.refresh_token,\n          expiresAt: supabaseSession.expires_at,\n          expiresIn: supabaseSession.expires_in,\n        },\n        parent: {\n          id: parent.id,\n          email: parent.email,\n          status: parent.status,\n          hasConsent: !!parent.consentAt,\n        },\n      };\n    }),\n\n  /**\n   * Refresh session endpoint\n   * Exchanges a refresh token for new access and refresh tokens.\n   * Used by mobile apps to maintain authentication without re-login.\n   */\n  refreshSession: publicProcedure\n    .input(z.object({ refreshToken: z.string().min(1, 'Refresh token is required') }))\n    .mutation(async ({ ctx, input }) => {\n      const ipAddress = extractIpAddress(ctx.requestHeaders) ?? 'unknown';\n\n      if (!ctx.supabase) {\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Authentication service is not configured.',\n        });\n      }\n\n      try {\n        // Refresh the session using Supabase\n        const { data, error } = await ctx.supabase.auth.refreshSession({\n          refresh_token: input.refreshToken,\n        });\n\n        if (error || !data?.session) {\n          await createAuditLog(ctx.prisma, {\n            action: 'refresh_failed',\n            entityType: 'parent',\n            metadata: {\n              reason: 'invalid_refresh_token',\n              error: error?.message,\n            },\n            ipAddress,\n          });\n\n          throw new TRPCError({\n            code: 'UNAUTHORIZED',\n            message: 'Invalid or expired refresh token. Please log in again.',\n            cause: error,\n          });\n        }\n\n        // Find the parent record to log the refresh\n        const parent = await ctx.prisma.parent.findUnique({\n          where: { supabaseUserId: data.session.user.id },\n          select: { id: true },\n        });\n\n        if (parent) {\n          await createAuditLog(ctx.prisma, {\n            action: 'refresh_success',\n            actorParentId: parent.id,\n            entityType: 'parent',\n            entityId: parent.id,\n            metadata: {},\n            ipAddress,\n          });\n        }\n\n        return {\n          session: {\n            accessToken: data.session.access_token,\n            refreshToken: data.session.refresh_token,\n            expiresAt: data.session.expires_at,\n            expiresIn: data.session.expires_in,\n          },\n        };\n      } catch (error) {\n        if (error instanceof TRPCError) {\n          throw error;\n        }\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to refresh session. Please try again.',\n          cause: error,\n        });\n      }\n    }),\n\n  /**\n   * Get current authenticated user (me)\n   * Returns the full parent profile with consent status and child counts.\n   * Used by both web and mobile apps after login.\n   */\n  me: protectedProcedure.query(async ({ ctx }) => {\n    if (!ctx.viewer) {\n      throw new TRPCError({ code: 'UNAUTHORIZED' });\n    }\n\n    const parent = await ctx.prisma.parent.findUnique({\n      where: { supabaseUserId: ctx.viewer.id },\n      select: {\n        id: true,\n        email: true,\n        fullName: true,\n        status: true,\n        role: true,\n        consentAt: true,\n        consentMethod: true,\n        consentIp: true,\n        deletionEffectiveAt: true,\n        createdAt: true,\n        updatedAt: true,\n        _count: {\n          select: {\n            children: true,\n          },\n        },\n      },\n    });\n\n    if (!parent) {\n      throw new TRPCError({\n        code: 'NOT_FOUND',\n        message: 'Parent profile not found.',\n      });\n    }\n\n    const isAllowlisted = isAllowlistedAdminEmail(ctx.env.adminEmails, parent.email);\n    let role = parent.role;\n\n    if (isAllowlisted && parent.role !== 'ADMIN') {\n      const updated = await ctx.prisma.parent.update({\n        where: { id: parent.id },\n        data: { role: 'ADMIN' },\n        select: { role: true },\n      });\n      role = updated.role;\n    }\n\n    return {\n      id: parent.id,\n      email: parent.email,\n      fullName: parent.fullName,\n      status: parent.status,\n      role,\n      hasConsent: !!parent.consentAt,\n      consentAt: parent.consentAt,\n      consentMethod: parent.consentMethod,\n      consentIp: parent.consentIp,\n      childCount: parent._count.children,\n      childrenCount: parent._count.children, // Alias for compatibility\n      needsConsent: parent.status === 'ACTIVE' && !parent.consentAt,\n      isPendingDeletion: parent.status === 'DELETION_PENDING',\n      deletionEffectiveAt: parent.deletionEffectiveAt,\n      createdAt: parent.createdAt,\n      updatedAt: parent.updatedAt,\n    };\n  }),\n\n  /**\n   * Logout endpoint\n   * Revokes the Supabase session and clears all tokens.\n   * Mobile apps should also clear keychain storage after calling this.\n   */\n  logout: protectedProcedure.mutation(async ({ ctx }) => {\n    if (!ctx.viewer || !ctx.supabase) {\n      throw new TRPCError({ code: 'UNAUTHORIZED' });\n    }\n\n    const ipAddress = extractIpAddress(ctx.requestHeaders) ?? 'unknown';\n\n    // Find the parent record\n    const parent = await ctx.prisma.parent.findUnique({\n      where: { supabaseUserId: ctx.viewer.id },\n      select: { id: true },\n    });\n\n    try {\n      // Sign out from Supabase (revokes refresh tokens)\n      const { error } = await ctx.supabase.auth.signOut();\n\n      if (error) {\n        console.error('Supabase logout error:', error);\n      }\n\n      // Log the logout\n      if (parent) {\n        await createAuditLog(ctx.prisma, {\n          action: 'logout',\n          actorParentId: parent.id,\n          entityType: 'parent',\n          entityId: parent.id,\n          metadata: {},\n          ipAddress,\n        });\n      }\n\n      return {\n        success: true,\n        message: 'Logged out successfully.',\n","exit_code":0,"status":"completed"}}
