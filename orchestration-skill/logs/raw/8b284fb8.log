{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/routers/credits.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Credits Router - Credit-Based Monetization System\n *\n * Handles credit pack purchases and credit transactions.\n * Replaces subscription-based model with pay-per-story credit system.\n *\n * Monetization Model:\n * - FREE: 1 avatar generation, 0 stories\n * - PAID: Credit packs at $0.99 per credit (1/5/10 credit packs)\n * - Each credit = 1 personalized story + PDF download\n */\n\nimport { z } from 'zod';\nimport { TRPCError } from '@trpc/server';\nimport { createTRPCRouter, protectedProcedure } from '../trpc';\nimport axios from 'axios';\nimport { google } from 'googleapis';\nimport { apiEnv } from '../env';\n\n// ========================================\n// SCHEMAS\n// ========================================\n\nconst purchaseCreditsSchema = z.object({\n  credits: z.number().int().positive().refine(val => [1, 5, 10].includes(val), {\n    message: 'Credits must be 1, 5, or 10',\n  }),\n  platform: z.enum(['STRIPE', 'APPLE', 'GOOGLE']),\n\n  // Platform-specific fields\n  appleTransactionId: z.string().optional(),\n  googleOrderId: z.string().optional(),\n  stripePaymentId: z.string().optional(),\n});\n\nconst deductCreditSchema = z.object({\n  storyId: z.string().uuid().optional(),\n  childId: z.string().uuid().optional(),\n  reason: z.enum(['STORY', 'AVATAR', 'PET']).default('STORY'),\n  credits: z.number().int().positive().default(1),\n});\n\nconst CREDIT_PACK_PRICES: Record<1 | 5 | 10, number> = {\n  1: 0.99,\n  5: 4.49,\n  10: 7.99,\n};\n\n// Helper function to get balance\nasync function getCreditBalance(ctx: any, parentId: string) {\n  const parent = await ctx.prisma.parent.findUnique({\n    where: { id: parentId },\n    select: { creditBalance: true },\n  });\n  return parent?.creditBalance ?? 0;\n}\n\nexport const creditsRouter = createTRPCRouter({\n  purchaseCredits: protectedProcedure\n    .input(purchaseCreditsSchema)\n    .mutation(async ({ input, ctx }) => {\n      const isProduction = ctx.env?.runtimeEnv === 'production';\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true },\n      });\n\n      if (!parent) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      if (isProduction) {\n        throw new TRPCError({\n          code: 'FORBIDDEN',\n          message: 'Direct credit purchases are disabled. Use Stripe checkout or in-app purchases.',\n        });\n      }\n\n      if (input.platform === 'STRIPE' && !input.stripePaymentId) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'STRIPE transaction ID required',\n        });\n      }\n\n      if (input.platform === 'APPLE' && !input.appleTransactionId) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'APPLE transaction ID required',\n        });\n      }\n\n      if (input.platform === 'GOOGLE' && !input.googleOrderId) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'GOOGLE order ID required',\n        });\n      }\n\n      const price = CREDIT_PACK_PRICES[input.credits as 1 | 5 | 10];\n\n      const result = await ctx.prisma.$transaction(async (tx) => {\n        const creditPack = await tx.creditPack.create({\n          data: {\n            parentId: parent.id,\n            credits: input.credits,\n            price,\n            platform: input.platform,\n            stripePaymentId: input.stripePaymentId,\n            appleTransactionId: input.appleTransactionId,\n            googleOrderId: input.googleOrderId,\n          },\n        });\n\n        await tx.creditTransaction.create({\n          data: {\n            parentId: parent.id,\n            credits: input.credits,\n            type: 'PURCHASE',\n            description: `Purchased ${input.credits} credits via ${input.platform}`,\n          },\n        });\n\n        const updatedParent = await tx.parent.update({\n          where: { id: parent.id },\n          data: {\n            creditBalance: { increment: input.credits },\n          },\n          select: { creditBalance: true },\n        });\n\n        await tx.auditLog.create({\n          data: {\n            actorParentId: parent.id,\n            action: 'credit_purchase_mock',\n            entityType: 'credit_pack',\n            entityId: creditPack.id,\n            metadata: {\n              platform: input.platform,\n              credits: input.credits,\n              price,\n              transactionId: input.stripePaymentId || input.appleTransactionId || input.googleOrderId,\n              mock: true,\n            },\n            ipAddress: ctx.requestIp,\n          },\n        });\n\n        return { creditPack, newBalance: updatedParent.creditBalance };\n      });\n\n      return {\n        success: true,\n        credits: input.credits,\n        balance: result.newBalance,\n        price,\n      };\n    }),\n\n  getBalance: protectedProcedure.query(async ({ ctx }) => {\n    const parent = await ctx.prisma.parent.findUnique({\n      where: { supabaseUserId: ctx.viewer.id },\n      select: { id: true, creditBalance: true },\n    });\n\n    if (!parent) {\n      throw new TRPCError({\n        code: 'NOT_FOUND',\n        message: 'Parent account not found',\n      });\n    }\n\n    const childProfiles = await ctx.prisma.childProfile.findMany({\n      where: { parentId: parent.id }, // Removed deletedAt: null to include deleted children\n      select: { id: true, avatarsGenerated: true, createdAt: true },\n      orderBy: { createdAt: 'asc' },\n    });\n\n    // First child is determined by creation order (earliest createdAt)\n    const firstChild = childProfiles[0];\n\n    // Check if the first child (even if deleted) has used their free generation\n    // If the first child is deleted, no one gets free generation (strict rule)\n    // OR: If the first child is active, they get it.\n    // The requirement is \"ONLY the first child of a parent account gets free avatar + pet\"\n\n    // We need to return the ID of the first child so the UI knows WHO is free\n    const firstChildId = firstChild?.id;\n\n    // We also need to know if that specific first child has already used it\n    const hasFreeAvatarGeneration = firstChild ? !firstChild.avatarsGenerated : false;\n\n    return {\n      credits: parent.creditBalance,\n      hasFreeAvatarGeneration,\n      firstChildId, // New field for UI to identify which child is free\n    };\n","exit_code":0,"status":"completed"}}
