{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,400p' packages/api/src/lib/generateStoryAsync.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n              actorParentId: params.parentId,\n              action: 'credit_refunded',\n              entityType: 'credit_transaction',\n              entityId: refundTx.id,\n              metadata: {\n                reason: 'story_generation_failed',\n                generationId: params.generationId,\n                refundAmount: params.cost,\n              },\n              ipAddress: 'system', // System-initiated refund\n            },\n          });\n\n          await tx.creditTransaction.update({\n            where: { id: params.creditReservationId! },\n            data: {\n              description: 'Story generation reservation (released)',\n            },\n          });\n        });\n        console.log(`Refunded ${params.cost} credits for failed generation ${params.generationId}`);\n      } catch (refundError) {\n        console.error('Failed to process refund:', refundError);\n        // Critical error - refund failed. Should alert admin/monitoring.\n      }\n    }\n\n    throw error;\n  }\n}\n\n/**\n * Update generation job status and progress\n */\nasync function updateJobStatus(\n  generationId: string,\n  status: StoryGenerationJobStatus,\n  progress: number\n) {\n  await prisma.storyGenerationJob.update({\n    where: { id: generationId },\n    data: { status, progress },\n  });\n}\n\n/**\n * Calculate age from birth month and year\n */\nfunction calculateAge(birthMonth: number | null, birthYear: number | null): number {\n  if (!birthMonth || !birthYear) return 8; // Default to 8 if not available\n\n  const now = new Date();\n  const currentYear = now.getFullYear();\n  const currentMonth = now.getMonth() + 1;\n\n  let age = currentYear - birthYear;\n  if (currentMonth < birthMonth) {\n    age--;\n  }\n\n  return age;\n}\n\n/**\n * Calculate age group from age\n */\nfunction calculateAgeGroup(age: number): '5-7' | '8-10' | '11-12' {\n  if (age <= 7) return '5-7';\n  if (age <= 10) return '8-10';\n  return '11-12';\n}\n\n/**\n * Generate story text using Gemini API\n * TODO: This should be implemented in Story 4.1 (packages/ai/gemini)\n */\nasync function generateStoryText(params: {\n  childName: string;\n  childAge: number;\n  petName?: string;\n  petType?: 'dog' | 'cat' | 'other';\n  adventureTemplate: 'superhero_rescue' | 'treasure_hunt' | 'magic_training';\n  artStyle: 'pixar' | '2d' | 'anime' | 'watercolor';\n}) {\n  return generateStory({\n    childName: params.childName,\n    childAge: params.childAge,\n    petName: params.petName,\n    petType: params.petType,\n    adventureTemplate: params.adventureTemplate,\n    artStyle: params.artStyle,\n  });\n}\n\n/**\n * Generate scene images using Nano Banana API\n * TODO: This should be implemented in Story 4.4 (packages/ai/imagen)\n */\nasync function generateSceneImages(params: {\n  scenes: Array<{ sceneNumber: number; text: string; imagePrompt: string }>;\n  childAvatarUrl: string;\n  petCompanionUrl?: string;\n  artStyle: 'pixar' | '2d' | 'anime' | 'watercolor';\n}) {\n  if (!supabase) {\n    throw new Error('Supabase service credentials are missing for image upload');\n  }\n\n  // Generate images in parallel\n  const images = await Promise.all(\n    params.scenes.map(async (scene) => {\n      try {\n        // 1. Generate image with Nano Banana (Imagen)\n        const result = await nanoBananaClient.generateSceneImage({\n          prompt: scene.imagePrompt,\n          referenceImages: params.petCompanionUrl\n            ? [params.childAvatarUrl, params.petCompanionUrl]\n            : [params.childAvatarUrl],\n          artStyle: params.artStyle,\n        });\n\n        // 2. Upload to Supabase\n        const fileName = `story_scene_${scene.sceneNumber}_${Date.now()}.png`;\n        const storagePath = `stories/${fileName}`; // Should probably be organized by story ID but we don't have it yet easily here without passing it down. \n        // Actually, let's use a temp path or just a flat structure for now, or pass generationId?\n        // Let's use a timestamp-based name to avoid collisions.\n\n        const { error: uploadError } = await supabase.storage\n          .from('stories')\n          .upload(storagePath, result.imageBuffer, {\n            contentType: 'image/png',\n            upsert: true,\n          });\n\n        if (uploadError) {\n          throw new Error(`Failed to upload scene image: ${uploadError.message}`);\n        }\n\n        const { data: publicUrlData } = supabase.storage\n          .from('stories')\n          .getPublicUrl(storagePath);\n\n        return {\n          sceneNumber: scene.sceneNumber,\n          publicUrl: publicUrlData.publicUrl,\n          cost: result.cost,\n          safetyScore: 1.0, // TODO: Use actual safety score from result\n        };\n      } catch (error) {\n        console.error(`Failed to generate image for scene ${scene.sceneNumber}:`, error);\n        // Return a placeholder or fail? \n        // For now, let's fail the whole story if a scene fails, or return a placeholder.\n        // Returning placeholder to allow partial success might be better for UX, but for now let's throw to trigger refund logic.\n        throw error;\n      }\n    })\n  );\n\n  return images;\n}\n","exit_code":0,"status":"completed"}}
