{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/routers/auth.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { z } from 'zod';\nimport { TRPCError } from '@trpc/server';\nimport { createTRPCRouter, protectedProcedure, publicProcedure } from '../trpc';\nimport { authSchemas } from '@herokid/validators';\nimport { rateLimiter, RATE_LIMITS } from '../utils/ratelimit';\nimport { AUDIT_ACTIONS } from '../utils/audit';\nimport { checkPasswordResetRateLimit } from '../lib/rateLimit';\nimport { createAuditLog, hashEmail, extractIpAddress } from '../lib/audit';\nimport { isAllowlistedAdminEmail } from '../utils/admin';\n\nconst upsertParentInput = z.object({\n  email: z.string().email(),\n  fullName: z.string().min(2).max(120),\n});\n\n// Password validation schema (≥12 chars with complexity requirements)\nconst passwordSchema = z\n  .string()\n  .min(12, 'Password must be at least 12 characters')\n  .regex(/[a-z]/, 'Password must contain at least one lowercase letter')\n  .regex(/[A-Z]/, 'Password must contain at least one uppercase letter')\n  .regex(/[0-9]/, 'Password must contain at least one number')\n  .regex(/[^a-zA-Z0-9]/, 'Password must contain at least one special character');\n\nconst resetPasswordInput = z.object({\n  email: z.string().email('Invalid email address'),\n});\n\nconst completeResetInput = z.object({\n  token: z.string().min(1, 'Reset token is required'),\n  newPassword: passwordSchema,\n});\n\nexport const authRouter = createTRPCRouter({\n  session: protectedProcedure.query(async ({ ctx }) => {\n    if (!ctx.viewer) {\n      throw new TRPCError({ code: 'UNAUTHORIZED' });\n    }\n\n    return {\n      viewer: ctx.viewer,\n    };\n  }),\n\n  upsertParentProfile: protectedProcedure\n    .input(upsertParentInput)\n    .mutation(async ({ ctx, input }) => {\n      let record = await ctx.prisma.parent.upsert({\n        where: { supabaseUserId: ctx.viewer!.id },\n        create: {\n          supabaseUserId: ctx.viewer!.id,\n          email: input.email,\n          fullName: input.fullName,\n        },\n        update: {\n          email: input.email,\n          fullName: input.fullName,\n        },\n      });\n\n      const isAllowlisted = isAllowlistedAdminEmail(ctx.env.adminEmails, input.email);\n      if (isAllowlisted && record.role !== 'ADMIN') {\n        record = await ctx.prisma.parent.update({\n          where: { id: record.id },\n          data: { role: 'ADMIN' },\n        });\n      }\n\n      return {\n        id: record.id,\n        email: record.email,\n        fullName: record.fullName,\n        role: record.role,\n      };\n    }),\n\n  publicPreviewToken: publicProcedure.query(() => ({\n    message: 'Supabase Auth wiring ready for Story 1.4 (Vercel).',\n  })),\n\n  register: publicProcedure\n    .input(authSchemas.registerInput)\n    .mutation(async ({ ctx, input }) => {\n      // 1. Rate limiting - 5 registrations per IP per hour\n      const ipAddress = extractIpAddress(ctx.requestHeaders) ?? 'unknown';\n      const rateLimitKey = `auth:register:${ipAddress}`;\n      rateLimiter.assertWithinLimit(\n        rateLimitKey,\n        RATE_LIMITS.AUTH_REGISTER.limit,\n        RATE_LIMITS.AUTH_REGISTER.windowMs\n      );\n\n      // 2. Validate Supabase is configured\n      if (!ctx.supabase) {\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Authentication service is not configured. Please contact support.',\n        });\n      }\n\n      // 3. Check for duplicate email in parents table\n      const existingParent = await ctx.prisma.parent.findUnique({\n        where: { email: input.email },\n      });\n\n      if (existingParent) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'An account with this email already exists.',\n          cause: { field: 'email', code: 'EMAIL_ALREADY_EXISTS' },\n        });\n      }\n\n      // 4. Create user in Supabase Auth (will error if email already exists)\n      let supabaseUser;\n      try {\n        const { data, error } = await ctx.supabase.auth.admin.createUser({\n          email: input.email,\n          password: input.password,\n          email_confirm: false, // User must verify email\n          user_metadata: {\n            marketingOptIn: input.marketingOptIn,\n          },\n        });\n\n        if (error) {\n          throw new TRPCError({\n            code: 'INTERNAL_SERVER_ERROR',\n            message: 'Failed to create account. Please try again.',\n            cause: error,\n          });\n        }\n\n        if (!data?.user) {\n          throw new TRPCError({\n            code: 'INTERNAL_SERVER_ERROR',\n            message: 'Failed to create account. Please try again.',\n          });\n        }\n\n        supabaseUser = data.user;\n      } catch (error) {\n        if (error instanceof TRPCError) {\n          throw error;\n        }\n\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to create account. Please try again.',\n          cause: error,\n        });\n      }\n\n      // 5. Create Parent row and AuditLog entry in a transaction\n      const isAllowlistedAdmin = isAllowlistedAdminEmail(ctx.env.adminEmails, input.email);\n      try {\n        const parent = await ctx.prisma.$transaction(async (tx: any) => {\n          // Create parent record\n          const newParent = await tx.parent.create({\n            data: {\n              supabaseUserId: supabaseUser.id,\n              email: input.email,\n              role: isAllowlistedAdmin ? 'ADMIN' : 'USER',\n              status: 'PENDING_VERIFICATION',\n              consentIp: input.requestIp || ipAddress,\n            },\n          });\n\n          // Create audit log entry\n          await tx.auditLog.create({\n            data: {\n              actorParentId: newParent.id,\n              action: AUDIT_ACTIONS.ACCOUNT_CREATED,\n              entityType: 'parent',\n              entityId: newParent.id,\n              metadata: {\n                userAgent: input.userAgent,\n                marketingOptIn: input.marketingOptIn,\n                trialCreated: true,\n              },\n              ipAddress: input.requestIp || ipAddress,\n            },\n          });\n\n          return newParent;\n        });\n\n        // 6. Return success response\n        return {\n          parentId: parent.id,\n          message: 'Account created successfully. Please check your email to verify your account.',\n        };\n      } catch (error) {\n        // If parent creation fails, we should delete the Supabase user\n        // to avoid orphaned accounts\n        try {\n          await ctx.supabase.auth.admin.deleteUser(supabaseUser.id);\n        } catch (cleanupError) {\n          // Log cleanup error but don't throw\n          console.error('Failed to cleanup Supabase user after parent creation failure:', cleanupError);\n","exit_code":0,"status":"completed"}}
