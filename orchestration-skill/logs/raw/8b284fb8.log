{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' apps/web/app/api/generate-pdf/route.tsx\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * PDF Generation Serverless Function - Epic 5 Story 5.7\n * Generates PDF storybooks using @react-pdf/renderer\n *\n * Flow:\n * 1. Fetch story from database with all scenes and images\n * 2. Render PDF using StoryPDF component\n * 3. Upload to Supabase Storage\n * 4. Generate 7-day signed URL\n * 5. Update export job status\n */\n\nimport { NextResponse } from 'next/server';\nimport { renderToBuffer } from '@react-pdf/renderer';\nimport { StoryPDF } from './StoryPDF';\nimport { createClient } from '@supabase/supabase-js';\nimport { prisma } from '@herokid/database';\n\n// Initialize Supabase client\nconst supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;\nconst supabaseServiceKey = process.env.SUPABASE_SERVICE_ROLE_KEY;\nconst supabase =\n  supabaseUrl && supabaseServiceKey ? createClient(supabaseUrl, supabaseServiceKey) : null;\n\nexport async function POST(request: Request) {\n  // Parse request body outside try block so exportId is available in catch\n  let exportId: string | undefined;\n  let storyId: string | undefined;\n\n  if (!supabase) {\n    return NextResponse.json(\n      { error: 'Supabase configuration is missing' },\n      { status: 500 }\n    );\n  }\n\n  try {\n    const body = await request.json();\n    exportId = body.exportId;\n    storyId = body.storyId;\n\n    if (!exportId || !storyId) {\n      return NextResponse.json(\n        { error: 'Missing exportId or storyId' },\n        { status: 400 }\n      );\n    }\n\n    const userId = await getAuthenticatedUserId(request);\n    if (!userId) {\n      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });\n    }\n\n    const exportJob = await prisma.storyExport.findUnique({\n      where: { id: exportId },\n      select: { storyId: true, status: true },\n    });\n\n    if (!exportJob || exportJob.storyId !== storyId) {\n      return NextResponse.json(\n        { error: 'Export job not found for this story' },\n        { status: 404 }\n      );\n    }\n\n    // 1. Fetch story from database with all scenes and images\n    const story = await prisma.story.findUnique({\n      where: { id: storyId },\n      include: {\n        parent: {\n          select: {\n            id: true,\n            supabaseUserId: true,\n          },\n        },\n        childProfile: {\n          select: {\n            id: true,\n            parentId: true,\n            parent: {\n              select: {\n                id: true,\n                supabaseUserId: true,\n              },\n            },\n          },\n        },\n        images: {\n          orderBy: { sceneNumber: 'asc' },\n          select: {\n            sceneNumber: true,\n            publicUrl: true,\n          },\n        },\n      },\n    });\n\n    if (!story) {\n      // Update export job with error\n      await markExportFailed(exportId, 'Story not found');\n\n      return NextResponse.json({ error: 'Story not found' }, { status: 404 });\n    }\n\n    const storyOwnerSupabaseId =\n      story.parent?.supabaseUserId ?? story.childProfile?.parent?.supabaseUserId;\n\n    if (!storyOwnerSupabaseId || storyOwnerSupabaseId !== userId) {\n      await markExportFailed(exportId, 'Unauthorized export request');\n      return NextResponse.json({ error: 'Forbidden' }, { status: 403 });\n    }\n\n    // Parse story content to extract scenes\n    const storyContent = normalizeStoryContent(story.storyContent, story.content);\n    const scenes = storyContent.scenes.map((scene: any) => ({\n      sceneNumber: scene.sceneNumber,\n      text: scene.text,\n      imageUrl: story.images.find((img) => img.sceneNumber === scene.sceneNumber)?.publicUrl || '',\n    }));\n\n    // 2. Render PDF using StoryPDF component\n    const pdfBuffer = await renderToBuffer(\n      <StoryPDF\n        story={{\n          title: story.title,\n          coverImageUrl: story.coverImageUrl || undefined,\n          scenes,\n        }}\n      />\n    );\n\n    // 3. Upload to Supabase Storage\n    const fileName = `${exportId}.pdf`;\n    const { data: uploadData, error: uploadError } = await supabase.storage\n      .from('story-pdfs')\n      .upload(fileName, pdfBuffer, {\n        contentType: 'application/pdf',\n        cacheControl: '3600',\n        upsert: true,\n      });\n\n    if (uploadError) {\n      // Update export job with error\n      await markExportFailed(exportId, `Upload failed: ${uploadError.message}`);\n\n      return NextResponse.json(\n        { error: `Upload failed: ${uploadError.message}` },\n        { status: 500 }\n      );\n    }\n\n    // 4. Generate 7-day signed URL\n    const { data: signedUrlData, error: signedUrlError } = await supabase.storage\n      .from('story-pdfs')\n      .createSignedUrl(fileName, 60 * 60 * 24 * 7); // 7 days\n\n    if (signedUrlError || !signedUrlData) {\n      // Update export job with error\n      await markExportFailed(exportId, `Failed to generate signed URL: ${signedUrlError?.message}`);\n\n      return NextResponse.json(\n        { error: `Failed to generate signed URL: ${signedUrlError?.message}` },\n        { status: 500 }\n      );\n    }\n\n    // 5. Update export job status\n    const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);\n    await prisma.storyExport.update({\n      where: { id: exportId },\n      data: {\n        status: 'complete',\n        storagePath: uploadData.path,\n        downloadUrl: signedUrlData.signedUrl,\n        expiresAt,\n        completedAt: new Date(),\n      },\n    });\n\n    return NextResponse.json({\n      success: true,\n      downloadUrl: signedUrlData.signedUrl,\n      expiresAt,\n    });\n  } catch (error) {\n    console.error('PDF generation error:', error);\n\n    // Update export job with error if we have the exportId (cached from above)\n    if (exportId) {\n      await markExportFailed(\n        exportId,\n        error instanceof Error ? error.message : 'Unknown error'\n      );\n    }\n\n    return NextResponse.json(\n      {\n        error: 'Internal server error',\n        details: error instanceof Error ? error.message : 'Unknown error',\n      },\n      { status: 500 }\n    );\n  }\n}\n\nasync function getAuthenticatedUserId(request: Request) {\n  const token = extractAuthTokenFromRequest(request);\n  if (!token || !supabase) return null;\n\n  const { data, error } = await supabase.auth.getUser(token);\n  if (error || !data?.user) {\n    return null;\n  }\n\n  return data.user.id;\n}\n\nfunction extractAuthTokenFromRequest(request: Request) {\n  const authHeader =\n    request.headers.get('authorization') ??\n","exit_code":0,"status":"completed"}}
