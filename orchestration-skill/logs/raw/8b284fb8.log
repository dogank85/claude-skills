{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"sed -n '220,440p' apps/web/app/api/generate-pdf/route.tsx\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n    request.headers.get('authorization') ??\n    request.headers.get('Authorization') ??\n    request.headers.get('AUTHORIZATION');\n\n  if (authHeader) {\n    const parts = authHeader.split(' ');\n    if (parts.length === 2 && parts[0].toLowerCase() === 'bearer') {\n      return parts[1];\n    }\n  }\n\n  const cookies = parseCookies(request.headers.get('cookie'));\n  if (cookies['sb-access-token']) {\n    return decodeURIComponent(cookies['sb-access-token']);\n  }\n\n  if (cookies['supabase-auth-token']) {\n    const raw = decodeURIComponent(cookies['supabase-auth-token']);\n    try {\n      const parsed = JSON.parse(raw);\n      if (Array.isArray(parsed) && parsed[0]) {\n        return parsed[0];\n      }\n      if (parsed?.currentSession?.access_token) {\n        return parsed.currentSession.access_token;\n      }\n    } catch {\n      // ignore malformed cookie\n    }\n  }\n\n  return null;\n}\n\nfunction parseCookies(cookieHeader: string | null): Record<string, string> {\n  if (!cookieHeader) return {};\n\n  return cookieHeader.split(';').reduce<Record<string, string>>((acc, cookie) => {\n    const [name, ...rest] = cookie.trim().split('=');\n    if (!name) return acc;\n    acc[name] = rest.join('=');\n    return acc;\n  }, {});\n}\n\nfunction normalizeStoryContent(storyContent: any, content: string | null | undefined) {\n  if (storyContent && typeof storyContent === 'object' && (storyContent as any).scenes) {\n    return storyContent as { scenes: Array<{ sceneNumber: number; text: string }> };\n  }\n\n  if (content) {\n    const scenes = content\n      .split('\\n\\n')\n      .filter(Boolean)\n      .map((text, index) => ({\n        sceneNumber: index + 1,\n        text,\n      }));\n\n    return { scenes };\n  }\n\n  return { scenes: [] as Array<{ sceneNumber: number; text: string }> };\n}\n\nasync function markExportFailed(exportId: string | undefined, message: string) {\n  if (!exportId) return;\n\n  try {\n    await prisma.storyExport.update({\n      where: { id: exportId },\n      data: {\n        status: 'failed',\n        errorMessage: message,\n        completedAt: new Date(),\n      },\n    });\n  } catch (updateError) {\n    console.error('Failed to update export job:', updateError);\n  }\n}\n\n// Set max duration for serverless function (10 seconds should be enough)\nexport const maxDuration = 10;\n","exit_code":0,"status":"completed"}}
