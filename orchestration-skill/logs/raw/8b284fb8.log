{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/context.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { prisma as defaultPrisma } from '@herokid/database';\nimport type { ParentRole, PrismaClient } from '@prisma/client';\nimport { TRPCError } from '@trpc/server';\nimport type { SupabaseClient } from '@supabase/supabase-js';\nimport { createClient } from '@supabase/supabase-js';\nimport type { FetchCreateContextFnOptions } from '@trpc/server/adapters/fetch';\nimport { apiEnv } from './env';\n\nexport type Viewer = {\n  id: string;\n  email?: string | null;\n};\n\nexport type AdminContext = {\n  parentId: string;\n  email?: string | null;\n  role: ParentRole;\n};\n\nexport interface CreateContextOptions {\n  headers?: Headers | null;\n  prisma?: PrismaClient;\n  supabase?: SupabaseClient;\n  viewer?: Viewer | null;\n}\n\nconst supabaseAdminClient =\n  apiEnv.supabaseConfigured && apiEnv.supabaseUrl && apiEnv.supabaseServiceRoleKey\n    ? createClient(apiEnv.supabaseUrl, apiEnv.supabaseServiceRoleKey, {\n      auth: {\n        autoRefreshToken: false,\n        persistSession: false,\n      },\n    })\n    : null;\n\nexport async function createContext(options: CreateContextOptions = {}) {\n  const prisma = options.prisma ?? defaultPrisma;\n  const headers = options.headers ?? null;\n  const supabase = options.supabase ?? supabaseAdminClient;\n\n  let viewer = options.viewer ?? null;\n  const token = headers ? extractAuthToken(headers) : null;\n\n  if (token && !viewer) {\n    if (!supabase) {\n      throw new TRPCError({\n        code: 'INTERNAL_SERVER_ERROR',\n        message: 'Supabase admin credentials are not configured.',\n      });\n    }\n\n    const { data, error } = await supabase.auth.getUser(token);\n    if (error || !data?.user) {\n      throw new TRPCError({\n        code: 'UNAUTHORIZED',\n        message: 'Invalid Supabase session token.',\n        cause: error ?? undefined,\n      });\n    }\n\n    viewer = { id: data.user.id, email: data.user.email };\n  }\n\n  const requestIp = headers ? extractRequestIp(headers) : null;\n\n  return {\n    prisma,\n    supabase,\n    viewer,\n    requestHeaders: headers,\n    requestIp,\n    env: apiEnv,\n    admin: null,\n  };\n}\n\ntype BaseContext = Awaited<ReturnType<typeof createContext>>;\nexport type Context = Omit<BaseContext, 'admin'> & { admin?: AdminContext | null };\n\nexport function createContextFactory(baseOptions?: Partial<CreateContextOptions>) {\n  return async (opts: FetchCreateContextFnOptions) =>\n    createContext({\n      headers: opts.req.headers,\n      prisma: baseOptions?.prisma ?? defaultPrisma,\n      supabase: baseOptions?.supabase ?? supabaseAdminClient ?? undefined,\n      viewer: baseOptions?.viewer ?? null,\n    });\n}\n\nfunction extractAuthToken(headers: Headers) {\n  const authHeader =\n    headers.get('authorization') ?? headers.get('Authorization') ?? headers.get('AUTHORIZATION');\n  if (authHeader) {\n    const parts = authHeader.split(' ');\n    if (parts.length === 2 && parts[0].toLowerCase() === 'bearer') {\n      return parts[1];\n    }\n  }\n\n  const cookies = parseCookies(headers.get('cookie'));\n  if (cookies['sb-access-token']) {\n    return decodeURIComponent(cookies['sb-access-token']);\n  }\n\n  if (cookies['supabase-auth-token']) {\n    const raw = decodeURIComponent(cookies['supabase-auth-token']);\n    try {\n      const parsed = JSON.parse(raw);\n      if (Array.isArray(parsed) && parsed[0]) {\n        return parsed[0];\n      }\n      if (parsed?.currentSession?.access_token) {\n        return parsed.currentSession.access_token;\n      }\n    } catch {\n      // Fall through to header-based extraction below\n    }\n  }\n\n  return headers.get('x-supabase-auth') ?? headers.get('x-herokid-supabase');\n}\n\n/**\n * Extract the real client IP address from trusted proxy headers.\n * We capture the originating IP (first X-Forwarded-For value) for audit logs, with fallbacks.\n */\nfunction extractRequestIp(headers: Headers): string | null {\n  const forwardedFor = headers.get('x-forwarded-for');\n  if (forwardedFor) {\n    const ips = forwardedFor.split(',').map((ip) => ip.trim());\n    if (ips[0]) {\n      return ips[0];\n    }\n  }\n\n  const realIp = headers.get('x-real-ip');\n  if (realIp) {\n    return realIp;\n  }\n\n  const cfIp = headers.get('cf-connecting-ip');\n  if (cfIp) {\n    return cfIp;\n  }\n\n  const vercelIp = headers.get('x-vercel-forwarded-for');\n  if (vercelIp) {\n    return vercelIp;\n  }\n\n  return null;\n}\n\nfunction parseCookies(cookieHeader: string | null): Record<string, string> {\n  if (!cookieHeader) return {};\n\n  return cookieHeader.split(';').reduce<Record<string, string>>((acc, cookie) => {\n    const [name, ...rest] = cookie.trim().split('=');\n    if (!name) return acc;\n    acc[name] = rest.join('=');\n    return acc;\n  }, {});\n}\n","exit_code":0,"status":"completed"}}
