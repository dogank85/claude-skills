{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/routers/avatar.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n/**\n * Avatar Router - Epic 3: Multi-Avatar Creation System\n *\n * Handles avatar and pet companion generation using:\n * - Google Imagen (Nano Banana) for image generation\n * - Google Cloud Vision for pet type detection\n * - Supabase Storage for photo and avatar storage\n */\n\nimport { TRPCError } from '@trpc/server';\nimport { z } from 'zod';\nimport { createTRPCRouter, protectedProcedure } from '../trpc';\nimport { verifyParentOwnership } from '../utils/verifyParentOwnership';\nimport {\n  requestUploadInput,\n  requestUploadOutput,\n  generateAvatarsInput,\n  generatePetCompanionInput,\n  listAvatarsInput,\n  regenerateAvatarsInput,\n} from '@herokid/validators';\nimport { nanoBananaClient, detectPetType } from '@herokid/ai';\nimport { type Prisma, UploadStatus, PoseType, ArtStyle } from '@prisma/client';\nimport type { Context } from '../context';\n\nconst MAX_DAILY_REGENERATIONS = 5; // Maximum regenerations per day (FREE)\nconst AVATAR_GENERATION_COST = 0.039; // $0.039 per image\n\n/**\n * Ensure the authenticated parent exists, is active, and has granted COPPA consent.\n */\nasync function assertCoppaConsent(ctx: Context): Promise<{ id: string; email: string }> {\n  if (!ctx.viewer) {\n    throw new TRPCError({ code: 'UNAUTHORIZED', message: 'Authentication required.' });\n  }\n\n  const parent = await ctx.prisma.parent.findUnique({\n    where: { supabaseUserId: ctx.viewer.id },\n    select: {\n      id: true,\n      email: true,\n      status: true,\n      consentAt: true,\n    },\n  });\n\n  if (!parent) {\n    throw new TRPCError({\n      code: 'NOT_FOUND',\n      message: 'Parent profile not found. Please complete onboarding first.',\n    });\n  }\n\n  if (parent.status === 'DELETION_PENDING') {\n    throw new TRPCError({\n      code: 'FORBIDDEN',\n      message: 'Your account is scheduled for deletion. Please cancel the deletion request to continue.',\n    });\n  }\n\n  if (parent.status !== 'ACTIVE') {\n    throw new TRPCError({\n      code: 'FORBIDDEN',\n      message: `Account is ${parent.status.toLowerCase()}. Please contact support.`,\n    });\n  }\n\n  if (!parent.consentAt) {\n    throw new TRPCError({\n      code: 'FORBIDDEN',\n      message: 'Parental consent required before uploading photos.',\n      cause: {\n        consentRequired: true,\n        reason: 'COPPA_CONSENT_REQUIRED',\n        consentUrl: '/consent',\n      },\n    });\n  }\n\n  return parent;\n}\n\n/**\n * Verify parent owns the child profile\n */\n\n\n/**\n * Count regenerations today for rate limiting\n * Counts Avatar records created today for the child profile (excluding first generation)\n */\nasync function countRegenerationsToday(\n  ctx: Context,\n  childProfileId: string\n): Promise<number> {\n  const today = new Date();\n  today.setHours(0, 0, 0, 0);\n\n  const count = await ctx.prisma.avatar.count({\n    where: {\n      childProfileId,\n      createdAt: {\n        gte: today,\n      },\n    },\n  });\n\n  // Each generation creates 8 avatars (4 styles × 2 poses)\n  // First 8 avatars = first generation (not a regeneration)\n  // Next 8 avatars = 1 regeneration, etc.\n  // Formula: floor(count / 8) gives total generations, subtract 1 for first generation\n  if (count <= 8) return 0; // First generation or no avatars yet\n  return Math.floor((count - 8) / 8);\n}\n\n/**\n * Verify daily regeneration limit hasn't been exceeded\n */\nasync function verifyDailyRegenerationLimit(\n  ctx: Context,\n  childProfileId: string\n): Promise<void> {\n  const regenerationsToday = await countRegenerationsToday(ctx, childProfileId);\n\n  if (regenerationsToday >= MAX_DAILY_REGENERATIONS) {\n    throw new TRPCError({\n      code: 'FORBIDDEN',\n      message: 'REGENERATION_LIMIT_EXCEEDED',\n      cause: {\n        reason: 'REGENERATION_LIMIT_EXCEEDED',\n        currentCount: regenerationsToday,\n        maxDaily: MAX_DAILY_REGENERATIONS,\n      },\n    });\n  }\n}\n\n/**\n * Get or reuse photo uploads for regeneration\n */\nasync function getPhotoUploads(\n  ctx: Context,\n  childProfileId: string,\n  portraitUploadId?: string,\n  fullBodyUploadId?: string\n): Promise<{ portraitUploadId: string; fullBodyUploadId: string }> {\n  let finalPortraitId = portraitUploadId;\n  let finalFullBodyId = fullBodyUploadId;\n\n  // If no new upload IDs provided, fetch the most recent uploads\n  if (!portraitUploadId || !fullBodyUploadId) {\n    const recentUploads = await ctx.prisma.photoUpload.findMany({\n      where: {\n        childProfileId,\n        status: UploadStatus.UPLOADED,\n        deletedAt: null,\n      },\n      orderBy: { uploadedAt: 'desc' },\n      take: 10, // Get recent uploads to find portrait and full_body\n    });\n\n    if (!portraitUploadId) {\n      const portraitUpload = recentUploads.find((u) => u.uploadType === 'portrait');\n      if (!portraitUpload) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'No portrait photo found. Please upload a new portrait photo.',\n        });\n      }\n      finalPortraitId = portraitUpload.id;\n    }\n\n    if (!fullBodyUploadId) {\n      const fullBodyUpload = recentUploads.find((u) => u.uploadType === 'full_body');\n      if (!fullBodyUpload) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'No full-body photo found. Please upload a new full-body photo.',\n        });\n      }\n      finalFullBodyId = fullBodyUpload.id;\n    }\n  }\n\n  // Verify the upload IDs exist and belong to this child profile\n  const uploads = await ctx.prisma.photoUpload.findMany({\n    where: {\n      id: { in: [finalPortraitId!, finalFullBodyId!] },\n      childProfileId,\n      status: UploadStatus.UPLOADED,\n    },\n  });\n\n  if (uploads.length !== 2) {\n    throw new TRPCError({\n      code: 'NOT_FOUND',\n      message: 'One or more photo uploads not found or invalid.',\n    });\n  }\n\n","exit_code":0,"status":"completed"}}
