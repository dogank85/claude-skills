{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,400p' packages/api/src/routers/credits.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n    };\n  }),\n\n  /**\n   * Deduct credit when story or avatar is generated\n   * Called by client or service\n   */\n  deductCredit: protectedProcedure\n    .input(deductCreditSchema)\n    .mutation(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true },\n      });\n\n      if (!parent) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      // Validate input based on reason\n      if (input.reason === 'STORY' && !input.storyId) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'storyId required for STORY deduction',\n        });\n      }\n      if ((input.reason === 'AVATAR' || input.reason === 'PET') && !input.childId) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'childId required for AVATAR/PET deduction',\n        });\n      }\n\n      try {\n        // Wrap balance check and deduction in transaction for atomicity\n        const result = await ctx.prisma.$transaction(async (tx) => {\n          // Get current balance from parent record\n          const parentRecord = await tx.parent.findUnique({\n            where: { id: parent.id },\n            select: { creditBalance: true },\n          });\n\n          const currentBalance = parentRecord?.creditBalance ?? 0;\n\n          // Check balance atomically\n          if (currentBalance < input.credits) {\n            throw new TRPCError({\n              code: 'FORBIDDEN',\n              message: `Insufficient credits. You need ${input.credits} credits.`,\n            });\n          }\n\n          // Create debit transaction\n          const creditTransaction = await tx.creditTransaction.create({\n            data: {\n              parentId: parent.id,\n              credits: -input.credits, // Negative for deduction\n              type: input.reason === 'AVATAR' ? 'AVATAR_DEBIT' : input.reason === 'PET' ? 'PET_DEBIT' : 'STORY_DEBIT',\n              relatedStoryId: input.storyId,\n              // relatedChildId: input.childId, // If schema supports it\n              description: input.reason === 'STORY' ? 'Story generation' : input.reason === 'AVATAR' ? 'Avatar generation' : 'Pet generation',\n            },\n          });\n\n          // Update parent's credit balance atomically with concurrent deduction protection\n          // This WHERE clause prevents negative balance in race conditions\n          const updatedParent = await tx.parent.updateMany({\n            where: {\n              id: parent.id,\n              creditBalance: { gte: input.credits }, // Only update if balance >= required\n            },\n            data: {\n              creditBalance: {\n                decrement: input.credits,\n              },\n            },\n          });\n\n          // If no rows were updated, balance was insufficient (race condition)\n          if (updatedParent.count === 0) {\n            throw new TRPCError({\n              code: 'FORBIDDEN',\n              message: 'Insufficient credits.',\n            });\n          }\n\n          // Get updated balance\n          const updatedParentRecord = await tx.parent.findUnique({\n            where: { id: parent.id },\n            select: { creditBalance: true },\n          });\n\n          // Create audit log\n          await tx.auditLog.create({\n            data: {\n              actorParentId: parent.id,\n              action: 'credit_deducted',\n              entityType: 'credit_transaction',\n              entityId: creditTransaction.id,\n              metadata: {\n                reason: input.reason,\n                storyId: input.storyId,\n                childId: input.childId,\n                creditsDeducted: input.credits,\n                creditsRemaining: updatedParentRecord?.creditBalance ?? 0,\n              },\n              ipAddress: ctx.requestIp,\n            },\n          });\n\n          return {\n            creditTransaction,\n            newBalance: updatedParentRecord?.creditBalance ?? 0,\n          };\n        });\n\n        return {\n          success: true,\n          creditsRemaining: result.newBalance,\n          transactionId: result.creditTransaction.id,\n        };\n      } catch (error) {\n        // Re-throw TRPCError without wrapping (e.g., insufficient credits)\n        if (error instanceof TRPCError) {\n          throw error;\n        }\n        console.error('Credit deduction failed:', error);\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to deduct credit',\n          cause: error,\n        });\n      }\n    }),\n\n  /**\n   * Get credit transaction history\n   */\n  getHistory: protectedProcedure\n    .input(\n      z.object({\n        limit: z.number().min(1).max(100).default(50),\n        offset: z.number().min(0).default(0),\n      })\n    )\n    .query(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true },\n      });\n\n      if (!parent) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      const [transactions, totalCount] = await Promise.all([\n        ctx.prisma.creditTransaction.findMany({\n          where: { parentId: parent.id },\n          orderBy: { createdAt: 'desc' },\n          take: input.limit,\n          skip: input.offset,\n        }),\n        ctx.prisma.creditTransaction.count({\n          where: { parentId: parent.id },\n        }),\n      ]);\n\n      return {\n        transactions: transactions.map((tx) => ({\n          id: tx.id,\n          credits: tx.credits,\n          type: tx.type,\n          description: tx.description,\n          relatedStoryId: tx.relatedStoryId,\n          createdAt: tx.createdAt,\n        })),\n        totalCount,\n        hasMore: input.offset + input.limit < totalCount,\n      };\n    }),\n\n  /**\n   * Verify Apple In-App Purchase and grant credits\n   */\n  verifyApplePurchase: protectedProcedure\n    .input(\n      z.object({\n        transactionId: z.string(),\n        receipt: z.string(),\n        productId: z.string(), // e.g., \"com.herokid.credits.5\"\n      })\n    )\n    .mutation(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n","exit_code":0,"status":"completed"}}
