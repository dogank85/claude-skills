{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"sed -n '400,800p' packages/api/src/routers/credits.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true },\n      });\n\n      if (!parent) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      // 1. Verify Receipt with Apple\n      const APPLE_VERIFY_URL = process.env.NODE_ENV === 'production'\n        ? 'https://buy.itunes.apple.com/verifyReceipt'\n        : 'https://sandbox.itunes.apple.com/verifyReceipt';\n\n      const sharedSecret = process.env.APPLE_SHARED_SECRET;\n      if (!sharedSecret) {\n        console.error('APPLE_SHARED_SECRET is missing');\n        throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Configuration error' });\n      }\n\n      let appleResponse;\n      try {\n        appleResponse = await axios.post(APPLE_VERIFY_URL, {\n          'receipt-data': input.receipt,\n          password: sharedSecret,\n          'exclude-old-transactions': true,\n        });\n\n        // Handle Sandbox receipt sent to Prod URL (Error 21007)\n        if (appleResponse.data.status === 21007) {\n          console.log('Sandbox receipt sent to Prod URL, retrying with Sandbox URL...');\n          appleResponse = await axios.post('https://sandbox.itunes.apple.com/verifyReceipt', {\n            'receipt-data': input.receipt,\n            password: sharedSecret,\n            'exclude-old-transactions': true,\n          });\n        }\n      } catch (error) {\n        console.error('Apple verification failed:', error);\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to verify receipt with Apple',\n          cause: error,\n        });\n      }\n\n      const data = appleResponse.data;\n\n      // Log verification attempt\n      await ctx.prisma.auditLog.create({\n        data: {\n          actorParentId: parent.id,\n          action: 'apple_iap_verification',\n          entityType: 'apple_receipt',\n          entityId: input.transactionId,\n          metadata: {\n            status: data.status,\n            environment: data.environment,\n            productId: input.productId,\n          },\n          ipAddress: ctx.requestIp,\n        },\n      });\n\n      if (data.status !== 0) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: `Apple receipt verification failed with status: ${data.status}`,\n        });\n      }\n\n      // 2. Validate Receipt Content\n      const latestReceipt = data.latest_receipt_info?.[0] || data.receipt;\n      if (!latestReceipt) {\n        throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'No receipt info returned' });\n      }\n\n      if (latestReceipt.product_id !== input.productId) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: `Product ID mismatch. Expected ${input.productId}, got ${latestReceipt.product_id}`,\n        });\n      }\n\n      if (latestReceipt.transaction_id !== input.transactionId) {\n        // Note: Sometimes original_transaction_id might be needed, but strict match is safer for consumable\n        console.warn(`Transaction ID mismatch: Input ${input.transactionId} vs Receipt ${latestReceipt.transaction_id}`);\n      }\n\n      if (latestReceipt.cancellation_date_ms) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Purchase was cancelled or refunded',\n        });\n      }\n\n      // 3. Parse Credits\n      const creditsMatch = input.productId.match(/\\.credits\\.(\\d+)$/);\n      if (!creditsMatch) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Invalid product ID format',\n        });\n      }\n\n      const credits = parseInt(creditsMatch[1], 10);\n      if (![1, 5, 10].includes(credits)) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Invalid credit amount',\n        });\n      }\n\n      // Check for duplicate transaction\n      const existingPack = await ctx.prisma.creditPack.findFirst({\n        where: { appleTransactionId: input.transactionId },\n      });\n\n      if (existingPack) {\n        const balance = await getCreditBalance(ctx, parent.id);\n        return {\n          success: true,\n          credits,\n          balance,\n          message: 'Credits already granted for this transaction',\n        };\n      }\n\n      // Grant credits using purchaseCredits logic\n      const result = await ctx.prisma.$transaction(async (tx) => {\n        const creditPack = await tx.creditPack.create({\n          data: {\n            parentId: parent.id,\n            credits,\n            price: credits * 0.99,\n            platform: 'APPLE',\n            appleTransactionId: input.transactionId,\n          },\n        });\n\n        await tx.creditTransaction.create({\n          data: {\n            parentId: parent.id,\n            credits,\n            type: 'PURCHASE',\n            description: `Apple IAP: ${credits} credits`,\n          },\n        });\n\n        // Update parent's credit balance atomically\n        const updatedParent = await tx.parent.update({\n          where: { id: parent.id },\n          data: {\n            creditBalance: {\n              increment: credits,\n            },\n          },\n          select: { creditBalance: true },\n        });\n\n        return { creditPack, newBalance: updatedParent.creditBalance };\n      });\n\n      return {\n        success: true,\n        credits,\n        balance: result.newBalance,\n        creditPackId: result.creditPack.id,\n      };\n    }),\n\n  /**\n   * Verify Google Play purchase and grant credits\n   */\n  verifyGooglePurchase: protectedProcedure\n    .input(\n      z.object({\n        purchaseToken: z.string(),\n        orderId: z.string(),\n        sku: z.string(), // e.g., \"credits_5\"\n      })\n    )\n    .mutation(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true },\n      });\n\n      if (!parent) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      // 1. Authenticate with Google\n      const serviceAccountStr = process.env.GOOGLE_PLAY_SERVICE_ACCOUNT;\n      if (!serviceAccountStr) {\n        console.error('GOOGLE_PLAY_SERVICE_ACCOUNT is missing');\n        throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Configuration error' });\n      }\n\n      let authClient;\n      try {\n        const credentials = JSON.parse(serviceAccountStr);\n        authClient = new google.auth.JWT({\n          email: credentials.client_email,\n          key: credentials.private_key,\n          scopes: ['https://www.googleapis.com/auth/androidpublisher'],\n        });\n        await authClient.authorize();\n      } catch (error) {\n        console.error('Google Auth failed:', error);\n        throw new TRPCError({ code: 'INTERNAL_SERVER_ERROR', message: 'Failed to authenticate with Google' });\n      }\n\n      const androidPublisher = google.androidpublisher({ version: 'v3', auth: authClient });\n      const packageName = process.env.ANDROID_PACKAGE_NAME || 'com.herokid.mobile';\n\n      // 2. Verify Purchase with Google\n      let purchase;\n      try {\n        const response = await androidPublisher.purchases.products.get({\n          packageName,\n          productId: input.sku,\n          token: input.purchaseToken,\n        });\n        purchase = response.data;\n      } catch (error) {\n        console.error('Google verification failed:', error);\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to verify purchase with Google',\n          cause: error,\n        });\n      }\n\n      // Log verification attempt\n      await ctx.prisma.auditLog.create({\n        data: {\n          actorParentId: parent.id,\n          action: 'google_iap_verification',\n          entityType: 'google_purchase',\n          entityId: input.orderId,\n          metadata: {\n            purchaseState: purchase.purchaseState,\n            consumptionState: purchase.consumptionState,\n            sku: input.sku,\n          },\n          ipAddress: ctx.requestIp,\n        },\n      });\n\n      // 3. Validate Purchase State\n      // purchaseState: 0=Purchased, 1=Canceled, 2=Pending\n      if (purchase.purchaseState !== 0) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: `Purchase not completed. State: ${purchase.purchaseState}`,\n        });\n      }\n\n      if (purchase.consumptionState === 1) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Purchase token already consumed',\n        });\n      }\n\n      if (purchase.orderId !== input.orderId) {\n        console.warn(`Order ID mismatch: Input ${input.orderId} vs Google ${purchase.orderId}`);\n        // We might accept this if Google returns a different internal ID, but logging is good.\n      }\n\n      // 4. Parse Credits\n      const creditsMatch = input.sku.match(/^credits_(\\d+)$/);\n      if (!creditsMatch) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Invalid SKU format',\n        });\n      }\n\n      const credits = parseInt(creditsMatch[1], 10);\n      if (![1, 5, 10].includes(credits)) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'Invalid credit amount',\n        });\n      }\n\n      // Check for duplicate transaction\n      const existingPack = await ctx.prisma.creditPack.findFirst({\n        where: { googleOrderId: input.orderId },\n      });\n\n      if (existingPack) {\n        const balance = await getCreditBalance(ctx, parent.id);\n        return {\n          success: true,\n          credits,\n          balance,\n          message: 'Credits already granted for this transaction',\n        };\n      }\n\n      const result = await ctx.prisma.$transaction(async (tx) => {\n        const creditPack = await tx.creditPack.create({\n          data: {\n            parentId: parent.id,\n            credits,\n            price: credits * 0.99,\n            platform: 'GOOGLE',\n            googleOrderId: input.orderId,\n          },\n        });\n\n        await tx.creditTransaction.create({\n          data: {\n            parentId: parent.id,\n            credits,\n            type: 'PURCHASE',\n            description: `Google Play: ${credits} credits`,\n          },\n        });\n\n        // Update parent's credit balance atomically\n        const updatedParent = await tx.parent.update({\n          where: { id: parent.id },\n          data: {\n            creditBalance: {\n              increment: credits,\n            },\n          },\n          select: { creditBalance: true },\n        });\n\n        return { creditPack, newBalance: updatedParent.creditBalance };\n      });\n\n      return {\n        success: true,\n        credits,\n        balance: result.newBalance,\n        creditPackId: result.creditPack.id,\n      };\n    }),\n\n  /**\n   * Create Stripe checkout session for credit purchase\n   */\n  createStripeCheckout: protectedProcedure\n    .input(\n      z.object({\n        credits: z.number().int().refine(val => [1, 5, 10].includes(val)),\n        successUrl: z.string().url().optional(),\n        cancelUrl: z.string().url().optional(),\n      })\n    )\n    .mutation(async ({ input, ctx }) => {\n      const parent = await ctx.prisma.parent.findUnique({\n        where: { supabaseUserId: ctx.viewer.id },\n        select: { id: true, email: true },\n      });\n\n      if (!parent || !parent.email) {\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n          message: 'Parent account not found',\n        });\n      }\n\n      // Import Stripe client\n      const { stripe } = await import('../lib/stripe');\n\n      const price = CREDIT_PACK_PRICES[input.credits as 1 | 5 | 10];\n      const baseUrl = process.env.NEXT_PUBLIC_APP_URL || 'http://localhost:3000';\n\n      const successUrl = input.successUrl || `${baseUrl}/purchase/success?session_id={CHECKOUT_SESSION_ID}`;\n      const cancelUrl = input.cancelUrl || `${baseUrl}/purchase?cancelled=true`;\n\n      try {\n        // Create Stripe checkout session\n        const session = await stripe.checkout.sessions.create({\n          payment_method_types: ['card'],\n          line_items: [\n            {\n              price_data: {\n                currency: 'usd',\n                product_data: {\n                  name: `${input.credits} Story ${input.credits === 1 ? 'Credit' : 'Credits'}`,\n                  description: `Generate ${input.credits} personalized ${input.credits === 1 ? 'story' : 'stories'} with PDF downloads`,\n                  images: ['https://herokid.app/images/credit-pack.png'], // Optional: Add product image\n                },\n                unit_amount: Math.round(price * 100), // Convert to cents\n              },\n              quantity: 1,\n            },\n          ],\n","exit_code":0,"status":"completed"}}
