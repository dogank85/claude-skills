{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,400p' packages/api/src/routers/story.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n  cost: number;\n}): Promise<StoryReservationResult> {\n  const { ctx, parentId, childProfileId, adventureTemplate, artStyle, includePet, cost } = params;\n\n  return ctx.prisma.$transaction(async (tx) => {\n    // Lock parent row to serialize free-story claims and concurrent deductions\n    await tx.$executeRaw`SELECT 1 FROM \"parents\" WHERE id = ${parentId} FOR UPDATE`;\n\n    const existingStories = await tx.story.count({\n      where: {\n        parentId,\n        deletedAt: null,\n        isGeneric: false,\n      },\n    });\n\n    const existingFirstFree = await tx.creditTransaction.findFirst({\n      where: {\n        parentId,\n        type: 'BONUS',\n        description: { in: ['FIRST_FREE_STORY_LOCK', 'FIRST_FREE_STORY_GRANTED'] },\n      },\n      select: { id: true },\n    });\n\n    const firstFreeAvailable = cost > 0 && existingStories === 0 && !existingFirstFree;\n\n    let appliedCost = cost;\n    let reservationTransactionId: string | undefined;\n    let firstFreeCreditId: string | undefined;\n\n    if (firstFreeAvailable) {\n      const bonusTx = await tx.creditTransaction.create({\n        data: {\n          parentId,\n          credits: 0,\n          type: 'BONUS',\n          description: 'FIRST_FREE_STORY_LOCK',\n        },\n      });\n\n      firstFreeCreditId = bonusTx.id;\n      appliedCost = 0;\n    }\n\n    if (appliedCost > 0) {\n      const debitResult = await tx.parent.updateMany({\n        where: {\n          id: parentId,\n          creditBalance: { gte: appliedCost },\n        },\n        data: {\n          creditBalance: { decrement: appliedCost },\n        },\n      });\n\n      if (debitResult.count === 0) {\n        throw new TRPCError({\n          code: 'FORBIDDEN',\n          message: 'INSUFFICIENT_CREDITS',\n        });\n      }\n\n      const debitTx = await tx.creditTransaction.create({\n        data: {\n          parentId,\n          credits: -appliedCost,\n          type: 'STORY_DEBIT',\n          description: 'Story generation reservation',\n        },\n      });\n\n      reservationTransactionId = debitTx.id;\n    }\n\n    const updatedParent = await tx.parent.findUnique({\n      where: { id: parentId },\n      select: { creditBalance: true },\n    });\n\n    const job = await tx.storyGenerationJob.create({\n      data: {\n        childProfileId,\n        status: 'PENDING',\n        progress: 0,\n        adventureType,\n        artStyle,\n        includePet,\n        startedAt: new Date(),\n      },\n    });\n\n    if (reservationTransactionId) {\n      await tx.creditTransaction.update({\n        where: { id: reservationTransactionId },\n        data: {\n          description: `Story generation reservation (${job.id})`,\n        },\n      });\n    }\n\n    if (firstFreeCreditId) {\n      await tx.creditTransaction.update({\n        where: { id: firstFreeCreditId },\n        data: {\n          description: `FIRST_FREE_STORY_LOCK:${job.id}`,\n        },\n      });\n    }\n\n    return {\n      jobId: job.id,\n      appliedCost,\n      reservationTransactionId,\n      firstFreeCreditId,\n      creditsRemaining: updatedParent?.creditBalance ?? 0,\n    };\n  });\n}\n\nexport const storyRouter = createTRPCRouter({\n  /**\n   * Generate Story - Initiate async story generation\n   * Story 6.11: Reserve credits BEFORE generation, commit/refund AFTER success/failure\n   */\n  generateStory: protectedProcedure\n    .input(generateStorySchema)\n    .mutation(async ({ input, ctx }) => {\n      const { childProfileId, adventureTemplate, includePet, artStyle, isGeneric } = input;\n      const STORY_COST = isGeneric ? 0 : 10;\n\n      // 1. Verify ownership without mutating credits (reservation handles deduction)\n      const { parentId, childProfile } = await verifyParentOwnership(ctx, childProfileId, 0, '');\n\n      // 2. Verify avatars exist (only for personalized stories)\n      if (!isGeneric && !childProfile.avatarsGenerated) {\n        throw new TRPCError({\n          code: 'PRECONDITION_FAILED',\n          message: 'Please create avatars first before generating stories',\n        });\n      }\n\n      // 3. Determine art style (use input or fallback to preferred)\n      const selectedArtStyle = artStyle || childProfile.preferredArtStyle || 'pixar';\n\n      // 4. Reserve credits atomically with job creation (prevents race conditions)\n      const reservation = await reserveCreditsForStory({\n        ctx,\n        parentId,\n        childProfileId,\n        adventureTemplate,\n        artStyle: selectedArtStyle,\n        includePet,\n        cost: STORY_COST,\n      });\n\n      // 5. Start async generation (fire and forget)\n      // The async function handles its own error logging and job status updates\n      // It now also handles REFUNDS if generation fails\n      generateStoryAsync({\n        generationId: reservation.jobId,\n        parentId,\n        childProfile: {\n          id: childProfile.id,\n          name: childProfile.name,\n          birthMonth: childProfile.birthMonth,\n          birthYear: childProfile.birthYear,\n          avatars: childProfile.avatars,\n          petCompanions: childProfile.petCompanions,\n        },\n        adventureTemplate: input.adventureTemplate,\n        includePet: input.includePet,\n        artStyle: input.artStyle,\n        cost: reservation.appliedCost, // Pass applied cost for potential refund\n        creditReservationId: reservation.reservationTransactionId,\n        firstFreeCreditId: reservation.firstFreeCreditId,\n      }).catch((error) => {\n        console.error('Background story generation failed:', error);\n      });\n\n      return {\n        success: true,\n        jobId: reservation.jobId,\n        creditsRemaining: reservation.creditsRemaining,\n        firstFree: reservation.appliedCost === 0 && STORY_COST > 0,\n      };\n    }),\n\n  /**\n   * Get Generation Status - Poll for generation progress\n   */\n  getGenerationStatus: protectedProcedure\n    .input(getGenerationStatusSchema)\n    .query(async ({ input, ctx }) => {\n      const { generationId } = input;\n\n      // Fetch generation job\n      const job = await ctx.prisma.storyGenerationJob.findUnique({\n        where: { id: generationId },\n        select: {\n          id: true,\n","exit_code":0,"status":"completed"}}
