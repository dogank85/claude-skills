{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' packages/api/src/lib/generateStoryAsync.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { prisma } from '@herokid/database';\nimport type { ChildProfile, PetCompanion } from '@prisma/client';\nimport { StoryGenerationJobStatus } from '@prisma/client';\nimport { generateStory, nanoBananaClient } from '@herokid/ai';\nimport { createClient } from '@supabase/supabase-js';\nimport { apiEnv } from '../env';\n\n// Initialize Supabase client for image uploads\nconst supabase =\n  apiEnv.supabaseUrl && apiEnv.supabaseServiceRoleKey\n    ? createClient(apiEnv.supabaseUrl, apiEnv.supabaseServiceRoleKey, {\n      auth: {\n        autoRefreshToken: false,\n        persistSession: false,\n      },\n    })\n    : null;\n\n/**\n * Async story generation orchestration function\n * Coordinates 3 phases: text generation → image generation → storage\n */\nexport async function generateStoryAsync(params: {\n  generationId: string;\n  parentId: string;\n  childProfile: {\n    id: string;\n    name: string;\n    birthMonth: number | null;\n    birthYear: number | null;\n    avatars: Array<{\n      id: string;\n      artStyle: string;\n      poseType: string;\n      publicUrl: string;\n    }>;\n    petCompanions: Array<{\n      id: string;\n      petName: string | null;\n      petType: string;\n      companionUrls: Record<string, string>;\n    }>;\n  };\n  adventureTemplate: 'superhero_rescue' | 'treasure_hunt' | 'magic_training';\n  includePet: boolean;\n  artStyle: 'pixar' | '2d' | 'anime' | 'watercolor';\n  cost: number; // Added cost parameter for refund logic\n  creditReservationId?: string | null;\n  firstFreeCreditId?: string | null;\n}) {\n  const startTime = Date.now();\n\n  try {\n    // Phase 1: Text Generation (0-10 seconds)\n    await updateJobStatus(params.generationId, StoryGenerationJobStatus.GENERATING_TEXT, 30);\n\n    const storyText = await generateStoryText({\n      childName: params.childProfile.name,\n      childAge: calculateAge(params.childProfile.birthMonth, params.childProfile.birthYear),\n      petName: params.includePet ? (params.childProfile.petCompanions[0]?.petName ?? undefined) : undefined,\n      petType: params.includePet ? params.childProfile.petCompanions[0]?.petType as 'dog' | 'cat' | 'other' : undefined,\n      adventureTemplate: params.adventureTemplate,\n      artStyle: params.artStyle,\n    });\n\n    // Phase 2: Image Generation (10-30 seconds, parallel)\n    await updateJobStatus(params.generationId, StoryGenerationJobStatus.GENERATING_IMAGES, 70);\n\n    const childAvatarUrl = params.childProfile.avatars.find(\n      a => a.artStyle === params.artStyle && a.poseType === 'full_body'\n    )?.publicUrl;\n\n    const petCompanionUrl = params.includePet\n      ? params.childProfile.petCompanions[0]?.companionUrls[params.artStyle]\n      : undefined;\n\n    const sceneImages = await generateSceneImages({\n      scenes: storyText.scenes,\n      childAvatarUrl: childAvatarUrl!,\n      petCompanionUrl,\n      artStyle: params.artStyle,\n    });\n\n    // Phase 3: Storage (30-35 seconds)\n    const generationTimeMs = Date.now() - startTime;\n\n    const scenes = storyText.scenes.map((scene, index) => ({\n      sceneNumber: index + 1,\n      text: scene.text,\n      imageUrl: sceneImages[index].publicUrl,\n    }));\n\n    const story = await prisma.story.create({\n      data: {\n        parentId: params.parentId,\n        childProfileId: params.childProfile.id,\n        title: storyText.title,\n        content: scenes.map((scene) => scene.text).join('\\n\\n'),\n        storyContent: { scenes },\n        adventureType: params.adventureTemplate,\n        artStyle: params.artStyle,\n        includedPet: params.includePet,\n        ageGroup: calculateAgeGroup(calculateAge(params.childProfile.birthMonth, params.childProfile.birthYear)),\n        wordCount: storyText.wordCount,\n        generationCost: storyText.cost + sceneImages.reduce((sum, img) => sum + img.cost, 0),\n        generationTimeMs,\n        status: 'READY',\n      },\n    });\n\n    // Commit reservation or lock markers after successful story creation\n    await prisma.$transaction(async (tx) => {\n      if (params.creditReservationId) {\n        await tx.creditTransaction.update({\n          where: { id: params.creditReservationId },\n          data: {\n            relatedStoryId: story.id,\n            description: 'Story generation charge (committed)',\n          },\n        });\n      }\n\n      if (params.firstFreeCreditId) {\n        await tx.creditTransaction.update({\n          where: { id: params.firstFreeCreditId },\n          data: {\n            description: 'FIRST_FREE_STORY_GRANTED',\n            relatedStoryId: story.id,\n          },\n        });\n      }\n    });\n\n    // Update job with completion\n    await prisma.storyGenerationJob.update({\n      where: { id: params.generationId },\n      data: {\n        status: StoryGenerationJobStatus.COMPLETE,\n        progress: 100,\n        storyId: story.id,\n        completedAt: new Date(),\n      },\n    });\n\n    return story;\n  } catch (error) {\n    // Handle errors and update job status\n    await prisma.storyGenerationJob.update({\n      where: { id: params.generationId },\n      data: {\n        status: StoryGenerationJobStatus.FAILED,\n        progress: 0,\n        errorMessage: error instanceof Error ? error.message : 'Unknown error',\n        errorStack: error instanceof Error ? error.stack : undefined,\n        completedAt: new Date(),\n      },\n    });\n\n    // Release first-free lock so it can be retried on failure\n    if (params.firstFreeCreditId) {\n      try {\n        await prisma.creditTransaction.update({\n          where: { id: params.firstFreeCreditId },\n          data: {\n            description: 'FIRST_FREE_STORY_RELEASED',\n            relatedStoryId: null,\n          },\n        });\n      } catch (releaseError) {\n        console.error('Failed to release first-free lock:', releaseError);\n      }\n    }\n\n    // REFUND LOGIC: If generation fails and cost > 0, refund the user\n    if (params.cost > 0 && params.creditReservationId) {\n      try {\n        await prisma.$transaction(async (tx) => {\n          // 1. Create REFUND transaction\n          const refundTx = await tx.creditTransaction.create({\n            data: {\n              parentId: params.parentId,\n              credits: params.cost, // Positive amount for refund\n              type: 'REFUND',\n              description: `Refund for failed story generation: ${params.generationId}`,\n              relatedStoryId: null, // No story created\n            },\n          });\n\n          // 2. Update parent balance\n          await tx.parent.update({\n            where: { id: params.parentId },\n            data: {\n              creditBalance: { increment: params.cost },\n            },\n          });\n\n          // 3. Create audit log\n          await tx.auditLog.create({\n            data: {\n              actorParentId: params.parentId,\n","exit_code":0,"status":"completed"}}
