{"type":"item.completed","item":{"id":"item_100","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,160p' apps/web/app/api/cron/auth.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\nimport { NextResponse } from 'next/server';\n\nconst encoder = new TextEncoder();\n\nfunction constantTimeEquals(expected: string, provided: string): boolean {\n  const expectedBytes = encoder.encode(expected);\n  const providedBytes = encoder.encode(provided);\n\n  let diff = expectedBytes.length ^ providedBytes.length;\n  const maxLength = Math.max(expectedBytes.length, providedBytes.length);\n\n  for (let i = 0; i < maxLength; i += 1) {\n    const expectedByte = expectedBytes[i] ?? 0;\n    const providedByte = providedBytes[i] ?? 0;\n    diff |= expectedByte ^ providedByte;\n  }\n\n  return diff === 0;\n}\n\nexport function validateCronRequest(request: { headers: Headers }) {\n  const cronSecret = process.env.CRON_SECRET;\n\n  if (!cronSecret) {\n    console.error('CRON_SECRET is not configured for cron route access');\n    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });\n  }\n\n  const authHeader = request.headers.get('authorization');\n\n  if (!authHeader?.startsWith('Bearer ')) {\n    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });\n  }\n\n  const providedSecret = authHeader.slice('Bearer '.length);\n\n  if (!constantTimeEquals(cronSecret, providedSecret)) {\n    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });\n  }\n\n  return null;\n}\n","exit_code":0,"status":"completed"}}
