{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,400p' packages/api/src/routers/auth.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n          console.error('Failed to cleanup Supabase user after parent creation failure:', cleanupError);\n        }\n\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to complete account creation. Please try again.',\n          cause: error,\n        });\n      }\n    }),\n\n  /**\n   * Request password reset\n   * Sends a password reset email via Supabase Auth.\n   * Silently succeeds whether or not the email exists (security best practice).\n   * Rate limited to 3 requests per email per 30 minutes and 10 per IP per hour.\n   */\n  requestPasswordReset: publicProcedure\n    .input(resetPasswordInput)\n    .mutation(async ({ ctx, input }) => {\n      const ip = extractIpAddress(ctx.requestHeaders);\n      const emailHash = hashEmail(input.email);\n\n      try {\n        // Check rate limits\n        await checkPasswordResetRateLimit(ctx.prisma, input.email, ip);\n\n        // Log the request (with hashed email for privacy)\n        await createAuditLog(ctx.prisma, {\n          action: 'password_reset_requested',\n          entityType: 'parent',\n          metadata: {\n            email_hash: emailHash,\n            ip,\n          },\n          ipAddress: ip,\n        });\n\n        // Attempt to send reset email via Supabase\n        // This will only send if the email exists in Supabase Auth\n        if (ctx.supabase) {\n          const redirectBase = ctx.env.supabaseUrl || 'http://localhost:3000';\n          const redirectUrl = new URL('/auth/password-reset', redirectBase);\n          redirectUrl.searchParams.set('mobileRedirect', 'herokid://auth/password-reset');\n\n          const { error } = await ctx.supabase.auth.resetPasswordForEmail(input.email, {\n            redirectTo: redirectUrl.toString(),\n          });\n\n          // Log metadata about the Supabase response for delivery tracing\n          // but don't expose whether the email exists\n          if (error) {\n            await createAuditLog(ctx.prisma, {\n              action: 'password_reset_email_failed',\n              entityType: 'parent',\n              metadata: {\n                email_hash: emailHash,\n                error_code: error.code,\n                error_message: error.message,\n              },\n              ipAddress: ip,\n            });\n          }\n        }\n\n        // Always return success (don't reveal if email exists)\n        return {\n          success: true,\n          message: 'If an account with that email exists, a password reset link has been sent.',\n        };\n      } catch (error) {\n        // If it's a rate limit error, re-throw it\n        if (error instanceof TRPCError && error.code === 'TOO_MANY_REQUESTS') {\n          throw error;\n        }\n\n        // For other errors, log but still return success (security)\n        await createAuditLog(ctx.prisma, {\n          action: 'password_reset_error',\n          entityType: 'parent',\n          metadata: {\n            email_hash: emailHash,\n            error: error instanceof Error ? error.message : 'Unknown error',\n          },\n          ipAddress: ip,\n        });\n\n        return {\n          success: true,\n          message: 'If an account with that email exists, a password reset link has been sent.',\n        };\n      }\n    }),\n\n  /**\n   * Complete password reset\n   * Verifies the reset token and updates the user's password.\n   * Server-side only to prevent token exposure.\n   */\n  completePasswordReset: publicProcedure\n    .input(completeResetInput)\n    .mutation(async ({ ctx, input }) => {\n      const ip = extractIpAddress(ctx.requestHeaders);\n\n      if (!ctx.supabase) {\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Supabase is not configured',\n        });\n      }\n\n      try {\n        // Verify the reset token by attempting to get the user\n        const { data: userData, error: userError } = await ctx.supabase.auth.getUser(input.token);\n\n        if (userError || !userData?.user) {\n          await createAuditLog(ctx.prisma, {\n            action: 'password_reset_failed',\n            entityType: 'parent',\n            metadata: {\n              reason: 'invalid_token',\n              error: userError?.message,\n            },\n            ipAddress: ip,\n          });\n\n          throw new TRPCError({\n            code: 'BAD_REQUEST',\n            message: 'Invalid or expired reset token',\n          });\n        }\n\n        // Find the parent record to verify they're active\n        const parent = await ctx.prisma.parent.findUnique({\n          where: { supabaseUserId: userData.user.id },\n        });\n\n        if (!parent) {\n          await createAuditLog(ctx.prisma, {\n            action: 'password_reset_failed',\n            entityType: 'parent',\n            metadata: {\n              reason: 'parent_not_found',\n              supabase_user_id: userData.user.id,\n            },\n            ipAddress: ip,\n          });\n\n          throw new TRPCError({\n            code: 'NOT_FOUND',\n            message: 'Parent account not found',\n          });\n        }\n\n        if (parent.status !== 'ACTIVE') {\n          await createAuditLog(ctx.prisma, {\n            action: 'password_reset_failed',\n            entityType: 'parent',\n            actorParentId: parent.id,\n            metadata: {\n              reason: 'inactive_parent',\n              status: parent.status,\n            },\n            ipAddress: ip,\n          });\n\n          throw new TRPCError({\n            code: 'FORBIDDEN',\n            message: 'Account is not eligible for password reset',\n          });\n        }\n\n        // Update the password using the service role key\n        const { error: updateError } = await ctx.supabase.auth.admin.updateUserById(\n          userData.user.id,\n          { password: input.newPassword }\n        );\n\n        if (updateError) {\n          await createAuditLog(ctx.prisma, {\n            action: 'password_reset_failed',\n            entityType: 'parent',\n            metadata: {\n              reason: 'update_failed',\n              error: updateError.message,\n              parent_id: parent.id,\n            },\n            ipAddress: ip,\n          });\n\n          throw new TRPCError({\n            code: 'INTERNAL_SERVER_ERROR',\n            message: 'Failed to update password',\n            cause: updateError,\n          });\n        }\n\n        // Log successful password reset\n        await createAuditLog(ctx.prisma, {\n          action: 'password_reset_success',\n          actorParentId: parent.id,\n","exit_code":0,"status":"completed"}}
