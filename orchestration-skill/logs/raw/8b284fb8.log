{"type":"item.completed","item":{"id":"item_84","type":"command_execution","command":"/bin/zsh -lc \"sed -n '300,520p' packages/api/src/routers/avatar.ts\"","aggregated_output":"/opt/homebrew/Library/Homebrew/cmd/shellenv.sh: line 18: /bin/ps: Operation not permitted\n      .getPublicUrl(storagePath);\n\n    if (!results[req.artStyle]) results[req.artStyle] = {};\n\n    if (req.poseType === 'portrait') {\n      results[req.artStyle].portrait = { url: publicUrlData.publicUrl, path: storagePath };\n    } else {\n      results[req.artStyle].fullBody = { url: publicUrlData.publicUrl, path: storagePath };\n    }\n  }\n\n  const avatars = styles.map(style => ({\n    artStyle: style,\n    portraitUrl: results[style].portrait?.url || '',\n    fullBodyUrl: results[style].fullBody?.url || '',\n    portraitPath: results[style].portrait?.path || '',\n    fullBodyPath: results[style].fullBody?.path || '',\n    generatedAt: new Date(),\n  }));\n\n  return {\n    avatars,\n    totalCost,\n    generationTimeMs: Date.now() - startTime,\n  };\n}\n\n/**\n * Avatar router\n */\nexport const avatarRouter = createTRPCRouter({\n  /**\n   * Request a signed upload URL for photo upload\n   * AC1: Parent can request signed upload URL via tRPC\n   * AC2: Signed URL expires in 1 hour\n   * AC4: Upload tracking record created\n   * AC5: Scheduled deletion timestamp set to 48 hours\n   */\n  requestUpload: protectedProcedure\n    .input(requestUploadInput)\n    .output(requestUploadOutput)\n    .mutation(async ({ input, ctx }) => {\n      // 1. Verify COPPA consent and parent status\n      const parent = await assertCoppaConsent(ctx);\n\n      // 2. Verify child profile ownership\n      await verifyParentOwnership(ctx, input.childProfileId);\n\n      // 3. Validate file type and size (already validated by Zod schema)\n      if (input.fileSize > 10_000_000) {\n        throw new TRPCError({\n          code: 'BAD_REQUEST',\n          message: 'File size exceeds 10MB limit.',\n        });\n      }\n\n      // 4. Check Supabase is configured\n      if (!ctx.supabase) {\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Storage service is not available. Please try again later.',\n        });\n      }\n\n      // 5. Generate unique upload ID (using UUID)\n      const uploadId = crypto.randomUUID();\n      const filePath = `${input.childProfileId}/${uploadId}`;\n\n      // 6. Create signed URL via Supabase Storage (1-hour expiration)\n      const { data: signedUrlData, error: signedUrlError } = await ctx.supabase.storage\n        .from('temp-uploads')\n        .createSignedUploadUrl(filePath);\n\n      if (signedUrlError || !signedUrlData) {\n        throw new TRPCError({\n          code: 'INTERNAL_SERVER_ERROR',\n          message: 'Failed to generate upload URL',\n          cause: signedUrlError,\n        });\n      }\n\n      // 7. Calculate scheduled deletion time (48 hours from now)\n      const scheduledDeletionAt = new Date(Date.now() + 48 * 60 * 60 * 1000);\n\n      // 8. Create tracking record in photo_uploads table\n      await ctx.prisma.photoUpload.create({\n        data: {\n          id: uploadId,\n          childProfileId: input.childProfileId,\n          uploadType: input.uploadType,\n          storagePath: filePath,\n          scheduledDeletionAt,\n          status: UploadStatus.PENDING,\n        },\n      });\n\n      // 9. Return signed URL to client\n      return {\n        uploadId,\n        signedUrl: signedUrlData.signedUrl,\n        expiresAt: new Date(Date.now() + 3600000), // 1 hour\n        maxFileSize: 10_000_000,\n      };\n    }),\n\n  /**\n   * Generate 8 avatars (4 art styles × 2 poses) from uploaded photos\n   * Story 6.13: First avatar is FREE - no payment/credit checks required\n   */\n  generateAvatars: protectedProcedure\n    .input(generateAvatarsInput)\n    .mutation(async ({ input, ctx }) => {\n      const startTime = Date.now();\n\n      // 1. Verify ownership and get child profile\n      const { parentId, childProfile } = await verifyParentOwnership(ctx, input.childProfileId);\n\n      // 2. Determine if this is the FIRST CHILD (by creation order)\n      // BUG FIX: Include DELETED children to prevent \"delete and recreate\" loophole\n      const allChildren = await ctx.prisma.childProfile.findMany({\n        where: { parentId }, // Removed deletedAt: null to include deleted children\n        select: { id: true, createdAt: true },\n        orderBy: { createdAt: 'asc' },\n      });\n      const firstChild = allChildren[0];\n      const isFirstChild = firstChild?.id === input.childProfileId;\n\n      // 3. Check if this is first avatar generation (FREE for first child only) or regeneration\n      const isFreeGeneration = isFirstChild && !childProfile.avatarsGenerated;\n\n      if (childProfile.avatarsGenerated) {\n        // This is a regeneration - enforce daily rate limit\n        await verifyDailyRegenerationLimit(ctx, input.childProfileId);\n      }\n\n      // 4. Deduct credits if NOT free (4 credits for avatar generation)\n      const AVATAR_COST = 4;\n      if (!isFreeGeneration) {\n        // Get parent to access credit functionality\n        const parent = await ctx.prisma.parent.findUnique({\n          where: { id: parentId },\n          select: { id: true, creditBalance: true },\n        });\n\n        if (!parent) {\n          throw new TRPCError({\n            code: 'NOT_FOUND',\n            message: 'Parent account not found',\n          });\n        }\n\n        // Check balance\n        if (parent.creditBalance < AVATAR_COST) {\n          throw new TRPCError({\n            code: 'FORBIDDEN',\n            message: `Insufficient credits. You need ${AVATAR_COST} credits to generate avatars.`,\n          });\n        }\n\n        // DEDUCT CREDITS BEFORE GENERATION (atomic transaction)\n        await ctx.prisma.$transaction(async (tx) => {\n          // Create debit transaction\n          await tx.creditTransaction.create({\n            data: {\n              parentId,\n              credits: -AVATAR_COST,\n              type: 'AVATAR_DEBIT',\n              description: 'Avatar generation',\n            },\n          });\n\n          // Update parent balance with race condition protection\n          const updateResult = await tx.parent.updateMany({\n            where: {\n              id: parentId,\n              creditBalance: { gte: AVATAR_COST },\n            },\n            data: {\n              creditBalance: { decrement: AVATAR_COST },\n            },\n          });\n\n          if (updateResult.count === 0) {\n            throw new TRPCError({\n              code: 'FORBIDDEN',\n              message: 'Insufficient credits.',\n            });\n          }\n        });\n      }\n\n      // 5. Fetch photo uploads\n      const uploads = await ctx.prisma.photoUpload.findMany({\n        where: {\n          id: { in: [input.portraitUploadId, input.fullBodyUploadId] },\n          childProfileId: input.childProfileId,\n          status: UploadStatus.UPLOADED,\n        },\n      });\n\n      if (uploads.length !== 2) {\n        // If generation fails and credits were deducted, issue refund\n        if (!isFreeGeneration) {\n          await ctx.prisma.$transaction(async (tx) => {\n            await tx.creditTransaction.create({\n              data: {\n                parentId,\n                credits: AVATAR_COST,\n                type: 'REFUND',\n                description: 'Avatar generation failed - photo uploads not found - refund',\n              },\n            });\n            await tx.parent.update({\n              where: { id: parentId },\n              data: { creditBalance: { increment: AVATAR_COST } },\n            });\n          });\n        }\n\n        throw new TRPCError({\n          code: 'NOT_FOUND',\n","exit_code":0,"status":"completed"}}
